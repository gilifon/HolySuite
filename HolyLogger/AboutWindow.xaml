<Window x:Name="Window_About" x:Class="HolyLogger.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" WindowStartupLocation="CenterScreen" Height="310" Width="560" MinHeight="310" MaxHeight="310" MinWidth="560" MaxWidth="560" Icon="Images/about.png" KeyDown="Window_KeyDown">
    <!-- TextElement.Foreground here because plain TextBlocks default to black, not the theme text
         color: the app-wide implicit Window style doesn't apply to Window SUBCLASSES like this one
         (WPF implicit styles match exact type only), so without this the text vanished in dark mode. -->
    <Grid Background="{DynamicResource WindowBg}" TextElement.Foreground="{DynamicResource TextBrush}">

        <Image HorizontalAlignment="Left" Height="113" Margin="10,10,0,0" VerticalAlignment="Top" Width="111" Source="Images/crown100.png"/>
        <StackPanel HorizontalAlignment="Left" Margin="138,10,0,0" VerticalAlignment="Top" Width="400" TextElement.FontSize="16">
            <TextBlock HorizontalAlignment="Left" Margin="0,0,0,0" TextWrapping="Wrap" Text="HAM Radio Logging software By 4X/4Z team" VerticalAlignment="Top"/>
            <TextBlock x:Name="L_Version" HorizontalAlignment="Left" Margin="0,5,0,0" TextWrapping="Wrap" Text="Version x.x.x.x" VerticalAlignment="Top"/>
            <TextBlock x:Name="L_CallsignVersion" HorizontalAlignment="Left" Margin="0,5,0,0" TextWrapping="Wrap" Text="Callsigns Version: 0" VerticalAlignment="Top"/>
            <TextBlock x:Name="L_CallsignCount" HorizontalAlignment="Left" Margin="0,5,0,0" TextWrapping="Wrap" Text="Callsigns in this program: 0" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Left" Margin="0,5,0,0" TextWrapping="Wrap" Text="Development - Gil 4Z1KD, Dan 4Z5SL" VerticalAlignment="Top" />
            <TextBlock HorizontalAlignment="Left" Margin="0,5,0,0" TextWrapping="Wrap" Text="Good Advice:" VerticalAlignment="Top" />
            <TextBlock HorizontalAlignment="Left" Margin="0,5,0,0" TextWrapping="Wrap" Text="Chanan 4Z1DZ, Isaac 4Z1TL, Zeev 4X5ZS" VerticalAlignment="Top" />
            <TextBlock HorizontalAlignment="Left" Margin="0,5,0,0" TextWrapping="Wrap" Text="Avraham 4Z1IZ, Zvika 4Z1ZV, Avishay 4X1ZQ" VerticalAlignment="Top" />
            <TextBlock x:Name="L_LastUpdate" Margin="0,5,0,0" TextWrapping="Wrap" Text="Last update: April 2018" VerticalAlignment="Top" HorizontalAlignment="Left" Width="380" />

        </StackPanel>


    </Grid>
</Window>
