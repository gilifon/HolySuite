<Window x:Class="HolyLogger.AdifMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADIF Monitor Manager" Height="520" MinHeight="420" Width="780" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource MutedTextBrush}"><Run Text="Some programs, like WSJT-X, save their contacts to an ADIF file."/><LineBreak/><Run Text="New contacts in a ticked file are added to your active log."/></TextBlock>

        <!-- The keycap template ignores Padding, so the size is set here. -->
        <Button Grid.Row="1" x:Name="BtnAdd" Content="Add file location" HorizontalAlignment="Left"
                Style="{StaticResource BlueActionButtonStyle}" Width="190" Height="32"
                Margin="0,0,0,8" FontSize="16" Click="BtnAdd_Click"/>

        <DataGrid x:Name="FilesGrid" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="All" FontSize="16" IsReadOnly="False"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  PreviewKeyDown="FilesGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <!-- A template column so the box ticks on the first click (see UdpPortsWindow). -->
                <DataGridTemplateColumn Header="On" Width="52" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="To remove a file, click it and press the Delete key."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="BtnSave" Content="Save" Padding="24,5" Margin="0,0,10,0" FontSize="16" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Padding="20,5" FontSize="16" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
