<Window x:Class="HolyLogger.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backups &amp; Restore" Width="680" Height="620"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Daily Log Backups &amp; How to Restore"
                   FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3">
            <TextBox x:Name="TB_Instructions" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="13"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextBrush}"
                     BorderThickness="0" Padding="10"/>
        </Border>

        <!-- Optional extra backup destination -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="Extra backup copy folder (optional)"
                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                           Text="A copy of each daily backup is also saved here. A cloud folder (Dropbox / OneDrive / Google Drive) or an external drive is perfectly fine for these copies — they are static files, never opened live by the program. The folder is remembered, so you only pick it once."/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TB_ExtraFolder" Grid.Column="0" IsReadOnly="True"
                             FontSize="13" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                             Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"/>
                    <Button x:Name="Btn_Browse" Grid.Column="1" Content="Browse…" MinWidth="90" Height="30"
                            FontSize="13" Margin="8,0,0,0" Click="Btn_Browse_Click"/>
                    <Button x:Name="Btn_Clear" Grid.Column="2" Content="Clear" MinWidth="70" Height="30"
                            FontSize="13" Margin="8,0,0,0" Click="Btn_Clear_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="Btn_OpenFolder" Content="Open Backups Folder" MinWidth="160" Height="34"
                    FontSize="14" Margin="0,0,10,0" Click="Btn_OpenFolder_Click"/>
            <Button x:Name="Btn_Close" Content="Close" MinWidth="90" Height="34"
                    FontSize="14" IsDefault="True" IsCancel="True" Click="Btn_Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
