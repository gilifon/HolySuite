<Window x:Class="HolyLogger.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backups &amp; Restore" Width="700"
        MinWidth="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Daily Log Backups &amp; Restore"
                   FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,10"/>

        <!-- Restore, done by the app: pick a backup, see what's in it, one confirmation, no manual
             file renaming. The current database is renamed aside (never deleted) before the backup
             is copied into place, so a restore can always be undone. If HolyLogger cannot even launch,
             HOW TO RESTORE.txt sitting next to the backups (Backups folder) covers that case instead -
             this window has no need to duplicate those manual steps. -->
        <Border Grid.Row="1" Padding="12,10" Margin="0,0,0,12"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="Restore from a backup" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="LB_Backups" Grid.Column="0" Height="120" FontSize="13"
                             DisplayMemberPath="DisplayLabel"
                             SelectionChanged="LB_Backups_SelectionChanged"/>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="Pick a backup on the left to see what it contains."
                                   x:Name="TB_BackupDetailsHint" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock x:Name="TB_BackupDetails" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="TB_BackupWarning" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Danger}" Visibility="Collapsed"/>
                        <Button x:Name="Btn_Restore" Content="Restore This Backup…" Margin="0,12,0,0"
                                MinWidth="170" Height="32" FontSize="13" HorizontalAlignment="Left"
                                IsEnabled="False" Click="Btn_Restore_Click"
                                Background="{DynamicResource Danger}" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Optional extra backup destination -->
        <Border Grid.Row="2" Padding="12,10"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="Extra backup copy folder (optional)"
                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                           Text="A copy of each daily backup is also saved here. A cloud folder (Dropbox / OneDrive / Google Drive) or an external drive is perfectly fine for these copies — they are static files, never opened live by the program. The folder is remembered, so you only pick it once."/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TB_ExtraFolder" Grid.Column="0" IsReadOnly="True"
                             FontSize="13" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                             Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"/>
                    <Button x:Name="Btn_Browse" Grid.Column="1" Content="Browse…" MinWidth="90" Height="30"
                            FontSize="13" Margin="8,0,0,0" Click="Btn_Browse_Click"/>
                    <Button x:Name="Btn_Clear" Grid.Column="2" Content="Clear" MinWidth="70" Height="30"
                            FontSize="13" Margin="8,0,0,0" Click="Btn_Clear_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
