<Window x:Class="HolyLogger.ChannelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="My Channels" Height="430" Width="540" MinHeight="300" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">

    <shell:WindowChrome.WindowChrome>
        <!-- Custom title bar (below) replaces the OS caption so the title can be shown larger and
             bold, matching the Cluster window. CaptionHeight matches the bar's height so drag /
             double-click-maximize / Aero snap keep working. -->
        <shell:WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0"
                             ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Frame around the whole window in the Channels menu icon's color (the orange tower).
         WindowStyle=None removed the OS border, so this Border is the window's visible edge. -->
    <Border BorderBrush="#FF8C00" BorderThickness="3">
    <DockPanel LastChildFill="True">
        <!-- Same custom title bar as the Cluster window: title at FontSize 15, bold. -->
        <Border x:Name="CustomTitleBar" DockPanel.Dock="Top" Height="32" Background="{DynamicResource TitleBarBg}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TitleBar_MinimizeBtn" Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="TitleBar_MaxRestoreBtn" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_MaxRestore_Click" ToolTip="Maximize"/>
                    <Button x:Name="TitleBar_CloseBtn" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_Close_Click" ToolTip="Close"/>
                </StackPanel>
                <Image Source="Images/crown.png" Width="16" Height="16" Margin="10,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Text="My Channels"/>
            </DockPanel>
        </Border>

        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Double-click a channel to set the radio to its frequency and mode. Click a cell to edit; type in the empty last row to add a channel."/>

        <DataGrid x:Name="ChannelsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="True" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="All" FontSize="15"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  PreviewMouseDoubleClick="ChannelsGrid_PreviewMouseDoubleClick"
                  CellEditEnding="ChannelsGrid_CellEditEnding"
                  CurrentCellChanged="ChannelsGrid_CurrentCellChanged">
            <DataGrid.Resources>
                <!-- Scoped to this grid: a very light blue selection so band-colored frequency text
                     (e.g. green) stays visible. The app-wide SelectionBg is a dark blue that hid it.
                     SelectionText is dark so the Name/Mode columns stay readable on the light row. -->
                <SolidColorBrush x:Key="SelectionBg" Color="#CFE8FF"/>
                <SolidColorBrush x:Key="SelectionText" Color="#1A1A1A"/>
            </DataGrid.Resources>
            <DataGrid.CellStyle>
                <!-- Hand cursor over a filled row (single/double-click to tune); text cursor over an
                     empty or the new-item row (type to add a channel). Based on the app-wide cell
                     style so the light-blue selection colors are kept. -->
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="Cursor" Value="IBeam"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFilled}" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </DataTrigger>
                        <!-- Light-blue hover across the whole row (each cell reacts to its parent row's
                             mouse-over). Skipped when the cell is selected, so the selection color wins. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#A6D2F5"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <!-- Text column (native tab-to-type editing). Color updates live because
                     ChannelsGrid_CellEditEnding pushes the value to the item the moment the cell
                     commits, firing FreqBrush's change notification before the row commits. -->
                <DataGridTextColumn x:Name="FreqColumn" Header="Frequency (kHz)" Binding="{Binding FreqKhz}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <!-- Colored by band, matching the cluster's Freq column. -->
                            <Setter Property="Foreground" Value="{Binding FreqBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <EventSetter Event="PreviewTextInput" Handler="FreqBox_PreviewTextInput"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridComboBoxColumn x:Name="ModeColumn" Header="Mode" SelectedItemBinding="{Binding Mode}" Width="110">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <!-- Drop the list open as soon as the editor appears (see CurrentCellChanged,
                                 which enters edit mode the moment the Mode cell gets focus). -->
                            <EventSetter Event="Loaded" Handler="ModeCombo_Loaded"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="BtnDelete" Content="Delete Selected" Padding="12,4" Margin="0,0,8,0" FontSize="14" Click="BtnDelete_Click"/>
                <Button x:Name="BtnClose" Content="Close" Padding="18,4" FontSize="14" Click="BtnClose_Click"/>
            </StackPanel>
            <!-- OK on the right: same effect as Close (approve + close; Closing saves), but first
                 checks that no channel is half-filled and warns if so. Close and the X stay unvalidated. -->
            <Button x:Name="BtnOk" Content="OK" DockPanel.Dock="Right" Padding="24,4" FontSize="14" Click="BtnOk_Click"/>
        </DockPanel>
        </Grid>
    </DockPanel>
    </Border>
</Window>
