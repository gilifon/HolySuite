<Window x:Class="HolyLogger.ChannelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Channels" Height="430" Width="540" MinHeight="300" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shown only when CAT is not active: double-click tuning is unavailable. -->
        <Border x:Name="CatBanner" Grid.Row="0" Background="#FFF3CD" BorderBrush="#E0A800"
                BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="Radio control (CAT) is not active — double-click tuning is disabled. You can still add, edit and delete channels."
                       Foreground="#7A5B00" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Double-click a channel to set the radio to its frequency and mode. Click a cell to edit; type in the empty last row to add a channel."/>

        <DataGrid x:Name="ChannelsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="True" CanUserDeleteRows="True" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="All" FontSize="15"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  PreviewMouseDoubleClick="ChannelsGrid_PreviewMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Frequency (kHz)" Binding="{Binding FreqKhz}" Width="140">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <EventSetter Event="PreviewTextInput" Handler="FreqBox_PreviewTextInput"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridComboBoxColumn x:Name="ModeColumn" Header="Mode" SelectedItemBinding="{Binding Mode}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnDelete" Content="Delete Selected" Padding="12,4" Margin="0,0,8,0" FontSize="14" Click="BtnDelete_Click"/>
            <Button x:Name="BtnClose" Content="Close" Padding="18,4" FontSize="14" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
