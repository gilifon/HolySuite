<Window x:Class="HolyLogger.ClusterAlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts" Width="460" Height="480" MinWidth="400" MinHeight="330"
        WindowStartupLocation="Manual" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <!-- The watch list: callsigns the operator wants to be told about. A spot for one of these rings
         the new-country sound, is put at the top of the cluster table, and is framed in purple - even
         when it is on a band the table is not showing. The list is typed straight into the grid. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Type a callsign on the empty line at the bottom. When one of these is spotted you hear the alert sound and the spot is framed in purple. If it is on a band you are not showing, it is pinned at the top of the spots table."/>
        </TextBlock>

        <DataGrid Grid.Row="1" x:Name="GRD_Calls"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="True" CanUserResizeRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="All" FontSize="16" RowHeight="26"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="#1565C0" BorderThickness="2"
                  CellEditEnding="Calls_CellEditEnding"
                  PreviewMouseLeftButtonDown="Calls_PreviewMouseLeftButtonDown">
            <!-- The header row wears LogHeaderBg, the same token the main log and the cluster table
                 use (and overridable in View > Color Scheme > Customize Colors), so this table's title
                 bar matches every other one in the program. -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource LogHeaderBg}"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,3"/>
                    <Setter Property="Padding" Value="5,3,5,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- NO TINT ON A LINE, EVER (user, 2026-09-03). Clicking a line here means "I am about to
                 write in it", and the picked-line colour made writing a callsign look like choosing
                 one. The line the operator last clicked is still the line Remove acts on - it simply
                 does not colour itself to say so. -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Call, UpdateSourceTrigger=PropertyChanged}" Width="120">
                    <!-- The word sits in the middle of the bar whatever the window's width. Said here,
                         on the header itself, so no inherited alignment can pull it to one side. -->
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Callsign" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="4,0,0,0"/>
                            <Setter Property="CharacterCasing" Value="Upper"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <!-- The box the callsign is typed into carries the table's own colours,
                                 not the picked-line colours. -->
                            <Setter Property="Background" Value="{DynamicResource GridRowBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- The flag and the country the callsign belongs to, worked out as it is typed - the
                     same answer the cluster gives a spot from the same station. They are shown, never
                     typed, so nothing here can be edited. -->
                <DataGridTemplateColumn Width="44" IsReadOnly="True" CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Flag" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding FlagPath}" Width="24" Height="16" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Country}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Country" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="BTN_Remove" Content="Remove" Padding="22,6" FontSize="16" Click="BtnRemove_Click"
                    ToolTip="Take the selected callsign off the list (the Delete key does the same)"/>
            <Button x:Name="BTN_Close" Content="OK" Padding="28,6" FontSize="16" Margin="14,0,0,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
