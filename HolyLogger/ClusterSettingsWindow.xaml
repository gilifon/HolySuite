<Window x:Class="HolyLogger.ClusterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cluster Settings" SizeToContent="Height" Width="620" MinWidth="540"
        WindowStartupLocation="Manual" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <!-- SizeToContent="Height" (above): the window is always exactly as tall as its content. That kills
         the dead space that a "*" filler row used to leave above the Close button, and means adding or
         removing a row here can never clip or leave a gap, with no hand-tuned Height to keep in sync. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Display" FontSize="17" Padding="10,8">
            <StackPanel>
                <!-- The coloured runs use the SAME theme tokens as the cluster rows they describe, so the
                     option previews exactly what it does and follows a colour-scheme change:
                     RowLotwBg = the yellow LoTW mark, RowOnFreqBg = the green on-frequency row. -->
                <CheckBox x:Name="CBX_ShowLotw" FontSize="16" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed">
                    <TextBlock VerticalAlignment="Center" FontSize="16"><Run Text="Mark LOTW User "/><Run Text="(yellow)" Background="{DynamicResource RowLotwBg}"/></TextBlock>
                </CheckBox>
                <CheckBox x:Name="CBX_LotwOnly" Content="LOTW Users Only" FontSize="16" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="CBX_AutoFillDxCall" FontSize="16" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed">
                    <TextBlock VerticalAlignment="Center" FontSize="16"><Run Text="Auto fill DX callsign while - "/><Run Text="On My Radio Freq" Background="{DynamicResource RowOnFreqBg}"/></TextBlock>
                </CheckBox>
                <CheckBox x:Name="CBX_PlotMap" Content="Plot spots on map" FontSize="16" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="CBX_HoverPopup" Content="Turn On PopUps while mouse hover" FontSize="16" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Sound alerts" FontSize="17" Padding="10,8" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <CheckBox x:Name="CBX_NewCountrySound" VerticalAlignment="Center" FontSize="16"
                              Checked="Setting_Changed" Unchecked="Setting_Changed">
                        <TextBlock Text="New-country spot" VerticalAlignment="Center" Width="170" FontSize="16"/>
                    </CheckBox>
                    <ComboBox x:Name="CB_NewCountrySound" Width="150" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15"
                              IsEnabled="{Binding ElementName=CBX_NewCountrySound, Path=IsChecked}"
                              SelectionChanged="CB_NewCountrySound_SelectionChanged"/>
                    <Button x:Name="BTN_TestNewCountry" Content="Test" Margin="8,0,0,0" Padding="14,3" FontSize="15" Cursor="Hand"
                            IsEnabled="{Binding ElementName=CBX_NewCountrySound, Path=IsChecked}"
                            ToolTip="Plays the selected alert sound on the device chosen in Options &#x2192; General"
                            Click="BTN_TestNewCountry_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                    <CheckBox x:Name="CBX_UnconfirmedSound" VerticalAlignment="Center" FontSize="16"
                              Checked="Setting_Changed" Unchecked="Setting_Changed">
                        <TextBlock Text="Unconfirmed spot" VerticalAlignment="Center" Width="170" FontSize="16"/>
                    </CheckBox>
                    <ComboBox x:Name="CB_UnconfirmedSound" Width="150" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15"
                              IsEnabled="{Binding ElementName=CBX_UnconfirmedSound, Path=IsChecked}"
                              SelectionChanged="CB_UnconfirmedSound_SelectionChanged"/>
                    <Button x:Name="BTN_TestUnconfirmed" Content="Test" Margin="8,0,0,0" Padding="14,3" FontSize="15" Cursor="Hand"
                            IsEnabled="{Binding ElementName=CBX_UnconfirmedSound, Path=IsChecked}"
                            ToolTip="Plays the selected alert sound on the device chosen in Options &#x2192; General"
                            Click="BTN_TestUnconfirmed_Click"/>
                </StackPanel>
                <!-- The output DEVICE is app-wide (not cluster-specific), so it stays in Options. The
                     "Sounds" link jumps straight there instead of making the operator hunt for it. -->
                <TextBlock FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"><Run Text="The audio output device for these alerts is set in:"/><LineBreak/><Run Text="Options &#x2192; General &#x2192; "/><Hyperlink x:Name="LNK_Sounds" Click="SoundsLink_Click" FontWeight="Bold"
                                      ToolTip="Open Options &#x2192; General"><Run Text="Sounds"/></Hyperlink><Run Text="."/></TextBlock>
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="2" x:Name="BtnClose" Content="Close" HorizontalAlignment="Center"
                Padding="28,6" FontSize="16" Margin="0,14,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
