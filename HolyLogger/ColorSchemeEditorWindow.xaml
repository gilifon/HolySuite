<Window x:Class="HolyLogger.ColorSchemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Current Color Scheme" Width="600" Height="680" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: what this window does, in plain words. The banner is the loud, unmissable
             answer to "which scheme am I editing?": large scheme name on an accent tile. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Customize Current Color Scheme" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="14,8"
                    Margin="0,8,0,0" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TB_BannerPrefix" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource SelectionText}"
                               Text="You are editing color scheme:"/>
                    <TextBlock x:Name="TB_BannerScheme" FontSize="20" FontWeight="ExtraBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SelectionText}"
                               Text="DARK"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="TB_SubHeader" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Click a color square to change it. Changes apply immediately to the whole application and are saved as your own scheme, named Custom in the Color Scheme menu."/>
        </StackPanel>

        <!-- Color rows, grouped; built in code from ThemePalette.TokenCatalog -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                Background="{DynamicResource PanelBg}" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,6,12,10">
                <StackPanel x:Name="GroupsPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="Btn_ResetAll" Content="Reset All…" DockPanel.Dock="Left"
                    Width="110" Height="32" FontSize="16" Click="Btn_ResetAll_Click"
                    ToolTip="Return every color in this scheme to its original value"/>
            <Button x:Name="Btn_Close" Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Width="110" Height="32" FontSize="16" FontWeight="Bold" IsDefault="True" IsCancel="True"
                    Click="Btn_Close_Click"/>
            <TextBlock x:Name="TB_BaseInfo" VerticalAlignment="Center" Margin="12,0,12,0" FontSize="16"
                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
