<Window x:Class="HolyLogger.ContestInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contest Information" Width="560" Height="660"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TB_Title" Grid.Row="0" FontSize="17" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="TB_Sub" Grid.Row="1" Margin="0,4,0,8" TextWrapping="Wrap"
                   FontSize="16" Foreground="{DynamicResource MutedTextBrush}"/>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,4,12,8">
                <StackPanel x:Name="SP_Fields"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TB_Validation" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="16" Foreground="#B35C00" TextWrapping="Wrap" MaxWidth="230"/>
            <Button x:Name="Btn_Secondary" MinWidth="90" Height="34" FontSize="16" Margin="0,0,10,0"
                    Click="Btn_Secondary_Click"/>
            <Button x:Name="Btn_Primary" MinWidth="140" Height="34" FontSize="16" FontWeight="Bold"
                    Click="Btn_Primary_Click"/>
        </StackPanel>
    </Grid>
</Window>
