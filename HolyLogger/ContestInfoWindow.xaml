<Window x:Class="HolyLogger.ContestInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contest Information" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TB_Title" Grid.Row="0" FontSize="17" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="TB_Sub" Grid.Row="1" Margin="0,4,0,8" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                   FontSize="16" Foreground="{DynamicResource MutedTextBrush}"/>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
            <!-- TWO COLUMNS, SEEN WHOLE (his request): "Station & operator" on the left, "This contest"
                 on the right, each label beside its box rather than above it, so the whole form fits
                 on the screen without scrolling. The ScrollViewer stays only as a net for a small
                 screen (MaxHeight is set in code from the monitor the window is on). -->
            <ScrollViewer x:Name="SV_Fields" VerticalScrollBarVisibility="Auto" Padding="12,4,12,8">
                <!-- SP_More holds the contest fields moved under the left column (BalanceColumns).
                     Three sibling panels, so TabIndex can put Tab in reading order: the left column's
                     own fields, the right column, then the moved ones - not "all of the left first". -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="SP_Personal" Grid.Column="0" Grid.Row="0" KeyboardNavigation.TabIndex="0"/>
                    <StackPanel x:Name="SP_Contest" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" KeyboardNavigation.TabIndex="1"/>
                    <StackPanel x:Name="SP_More" Grid.Column="0" Grid.Row="1" KeyboardNavigation.TabIndex="2"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TB_Validation" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="16" Foreground="#B35C00" TextWrapping="Wrap" MaxWidth="230"/>
            <Button x:Name="Btn_Secondary" MinWidth="90" Height="34" FontSize="16" Margin="0,0,10,0"
                    Click="Btn_Secondary_Click"/>
            <Button x:Name="Btn_Primary" MinWidth="140" Height="34" FontSize="16" FontWeight="Bold"
                    Click="Btn_Primary_Click"/>
        </StackPanel>
    </Grid>
</Window>
