<Window x:Class="HolyLogger.ContestRadioSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HolyLogger"
        Title="Contest Radio Setup" Height="445" MinHeight="420" Width="900" MinWidth="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <local:NotInOmniRigBrushConverter x:Key="NotInOmniRig"/>
        <!-- The subject column is shaded every other row, like the log table. -->
        <Style x:Key="CommandLabel" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,12,6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="{DynamicResource GridRowBg}"/>
        </Style>
        <Style x:Key="CommandLabelAlt" TargetType="Border" BasedOn="{StaticResource CommandLabel}">
            <Setter Property="Background" Value="{DynamicResource GridAltRowBg}"/>
        </Style>
        <Style x:Key="CommandLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="CommandBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CharacterCasing" Value="Upper"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Only contests with 2m or 70cm are offered (ContestRadioCommands.VhfUhfContests): every
             radio offered below is a VHF/UHF one. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Contest:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ContestBox" Width="300" FontSize="16" VerticalContentAlignment="Center"
                      DisplayMemberPath="Name"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="TB_Hint" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource MutedTextBrush}"><Run Text="When a log of this contest is opened, these commands go to the radio on CAT, in this order."/><LineBreak/><Run Text="Each radio has its own commands. Pick the radio, and leave a command empty if the radio has none."/></TextBlock>

        <!-- ADD RADIO says what to do HERE, at the top: the open list covers everything under the
             Radio box, so a line written there cannot be seen while it is open. -->
        <Border x:Name="Border_AddHint" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10"
                Background="#D6E9FA" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Padding="8,6">
            <TextBlock x:Name="TB_AddHint" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}"/>
        </Border>

        <!-- ONE RADIO AT A TIME. Six commands side by side needed a window 1740 wide. The radio is
             picked on the left, its commands stand under each other, and Send now sits beside them. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top">
                <TextBlock Text="Radio (OmniRig name)" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextBrush}"/>
                <!-- PICKED, NOT TYPED. Only a radio OmniRig has an .ini file for can be driven at
                     all, and only 2m/70cm radios belong in a VHF/UHF contest - so the list holds
                     exactly those, and a name that cannot work cannot be entered. Red when the file
                     has gone from OmniRig since the commands were saved. -->
                <!-- Tall enough that the starred (has-commands) radios, sorted to the top, keep
                     growing room without the list needing to scroll to show them all. -->
                <ComboBox x:Name="RadioBox" Width="230" FontSize="16" MaxDropDownHeight="420"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding RigNames, RelativeSource={RelativeSource AncestorType=Window}}"
                          Foreground="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotInOmniRig}}"/>
                <TextBlock x:Name="TB_RadioNote" FontSize="16" TextWrapping="Wrap" Width="230" Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource PanelBg}" Padding="10" VerticalAlignment="Top">
                <Grid x:Name="CommandsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- 240: the longest command is 8 bytes, "FE FE 8C E0 06 05 01 FD", which
                             measures about 205 at Consolas 16 - it was cut off at 190. -->
                        <ColumnDefinition Width="*" MinWidth="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CommandLabel}">
                        <TextBlock Text="VFO" Style="{StaticResource CommandLabelText}"
                                   ToolTip="Puts the radio on its VFO, so it is not sitting on a memory channel."/>
                    </Border>
                    <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource CommandBox}"
                               Text="{Binding Vfo, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CommandLabelAlt}">
                        <TextBlock Text="FM wide" Style="{StaticResource CommandLabelText}"
                                   ToolTip="Sets plain FM, not FM-N. A narrow radio hears a wide station badly."/>
                    </Border>
                    <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource CommandBox}"
                               Text="{Binding FmWide, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CommandLabel}">
                        <TextBlock Text="No Auto Repeater" Style="{StaticResource CommandLabelText}"
                                   ToolTip="Switches off Auto Repeater, which puts a repeater shift back by itself. Only the U.S.A. and Korean ID-5100 have this setting."/>
                    </Border>
                    <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource CommandBox}"
                               Text="{Binding NoAutoRepeater, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CommandLabelAlt}">
                        <TextBlock Text="Simplex" Style="{StaticResource CommandLabelText}"
                                   ToolTip="Clears any repeater shift, so you transmit and receive on the same frequency."/>
                    </Border>
                    <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource CommandBox}"
                               Text="{Binding Simplex, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CommandLabel}">
                        <TextBlock Text="No Tone" Style="{StaticResource CommandLabelText}"
                                   ToolTip="Stops sending the sub-audible tone with your signal."/>
                    </Border>
                    <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource CommandBox}"
                               Text="{Binding NoTone, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource CommandLabelAlt}">
                        <TextBlock Text="No TSQL" Style="{StaticResource CommandLabelText}"
                                   ToolTip="Switches off tone squelch, so you hear every station on the channel."/>
                    </Border>
                    <TextBox   Grid.Row="5" Grid.Column="1" Style="{StaticResource CommandBox}"
                               Text="{Binding NoTsql, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <Button x:Name="BtnSendNow" Grid.Column="2" Content="Send now" FontSize="16" Padding="14,6"
                    Margin="16,0,0,0" VerticalAlignment="Center" Click="BtnSendNow_Click"
                    FontWeight="Bold" Background="#1565C0" Foreground="White" BorderBrush="#0D47A1"
                    BorderThickness="1.5"
                    ToolTip="Send this radio's commands to the radio on CAT now"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnAdd" Content="Add Radio" Padding="12,4" Margin="0,0,8,0" FontSize="16"
                    ToolTip="Set up a radio that is not in the list - every radio OmniRig has a file for"
                    Click="BtnAdd_Click"/>
            <Button x:Name="BtnDelete" Content="Delete this radio" Padding="12,4" Margin="0,0,8,0" FontSize="16"
                    ToolTip="Forget the commands kept for the radio shown above" Click="BtnDelete_Click"/>
            <Button x:Name="BtnClose" Content="Close" Padding="14,4" FontSize="16" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
