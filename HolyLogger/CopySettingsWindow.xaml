<Window x:Class="HolyLogger.CopySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy settings" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" Grid.Row="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap" Text="Copy new QSOs from this log into another log"/>

        <TextBlock Grid.Row="1" Text="Copy new QSOs into:" FontSize="16" Margin="0,14,0,4"/>
        <ComboBox x:Name="CB_CopyTarget" Grid.Row="2" FontSize="16" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="Btn_Save" Content="Save" Width="100" Height="32" FontSize="16" FontWeight="Bold"
                    IsDefault="True" Margin="0,0,8,0" Click="Btn_Save_Click"/>
            <Button x:Name="Btn_Cancel" Content="Cancel" Width="100" Height="32" FontSize="16"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
