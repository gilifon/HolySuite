<Window x:Class="HolyLogger.CopySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy settings" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" Grid.Row="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap" Text="Copy new QSOs from this log into another log"/>

        <TextBlock Grid.Row="1" Text="Copy new QSOs into:" FontSize="13" Margin="0,14,0,4"/>
        <ComboBox x:Name="CB_CopyTarget" Grid.Row="2" FontSize="14" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="3" Text="This log's identity" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,0"/>
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Station callsign" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="TB_Callsign" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" FontSize="14" Padding="4,3"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Operator" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="TB_Operator" Grid.Row="1" Grid.Column="1" FontSize="14" Padding="4,3"/>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11" Foreground="#777777" Margin="0,8,0,0"
                       Text="Only QSOs made with this station callsign AND operator are copied. Deleting a QSO in either log removes it from both; editing one updates the other."/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Btn_Cancel" Content="Cancel" Width="100" Height="32" FontSize="14" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="Btn_Save" Content="Save" Width="100" Height="32" FontSize="14" FontWeight="Bold"
                    IsDefault="True" Click="Btn_Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
