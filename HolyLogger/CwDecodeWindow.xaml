<Window x:Class="HolyLogger.CwDecodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CW Decode" Height="560" MinHeight="470" Width="700" MinWidth="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource MutedTextBrush}"><Run Text="Pick where the radio's audio comes into this computer, then press Listen."/><LineBreak/><Run Text="Tune a station in and the decoding follows the note you hear. Nothing has to be set for speed or pitch."/></TextBlock>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Listen to:" FontSize="16" VerticalAlignment="Center"
                       Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}"/>
            <ComboBox Grid.Column="1" x:Name="CB_Device" FontSize="16" Height="32"
                      VerticalContentAlignment="Center"
                      ToolTip="The recording device the radio's audio arrives on"
                      SelectionChanged="CB_Device_SelectionChanged"/>
            <Button Grid.Column="2" x:Name="BtnRefresh" Content="Refresh" FontSize="16"
                    Height="32" Width="96" Margin="10,0,0,0" Cursor="Hand"
                    ToolTip="Look for devices again - use it after switching the radio on"
                    Click="BtnRefresh_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="BtnListen" Content="Listen" FontSize="16" Height="34" Width="120"
                    Cursor="Hand" Click="BtnListen_Click"/>
            <Button x:Name="BtnStop" Content="Stop" FontSize="16" Height="34" Width="120"
                    Margin="10,0,0,0" Cursor="Hand" IsEnabled="False" Click="BtnStop_Click"/>
            <Button x:Name="BtnClear" Content="Clear" FontSize="16" Height="34" Width="120"
                    Margin="10,0,0,0" Cursor="Hand"
                    ToolTip="Empty the text and start the speed and pitch over"
                    Click="BtnClear_Click"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Level:" FontSize="16" VerticalAlignment="Center"
                       Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}"/>
            <ProgressBar Grid.Column="1" x:Name="LevelBar" Height="28" Minimum="0" Maximum="100"
                         Value="0"/>
            <TextBlock Grid.Column="2" x:Name="LevelWords" Text="" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="110"/>
        </Grid>

        <!-- What the decoder has worked out for itself. Shown because it is the quickest way to see
             that it has locked onto the right signal: a pitch that matches what he hears and a speed
             that matches what he sees on the key mean the letters can be trusted. -->
        <TextBlock Grid.Row="4" x:Name="ToneAndSpeed" FontSize="16" Margin="0,0,0,10"
                   Foreground="{DynamicResource MutedTextBrush}" Text=""/>

        <Border Grid.Row="5" Margin="0,0,0,10" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource MutedTextBrush}">
            <TextBox x:Name="DecodedText" FontSize="18" FontFamily="Consolas" Margin="6"
                     IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent" Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <TextBlock Grid.Row="6" x:Name="StatusText" FontSize="16" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" Text="Not listening."/>
    </Grid>
</Window>
