<Window x:Class="HolyLogger.HamFreqWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frequency Check" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Red attention icon, then all the text lines stacked to its right so they share one left edge. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="&#x26A0;" FontSize="28" Foreground="#C0392B"
                       VerticalAlignment="Top" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="TB_Message" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Save anyhow?" FontSize="16" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <!-- Aligned with the two lines above (same StackPanel), font 16. -->
                <TextBlock FontSize="16" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"><Run Text="(you can disable frequency validation "/><Hyperlink x:Name="Link_Settings" Click="Link_Settings_Click"><Run Text="here"/></Hyperlink><Run Text=")"/></TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Yes / No, centred. No is the default (Enter) and cancel (Escape): the safe answer. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Btn_Yes" Content="Yes" Width="96" Height="34" FontSize="15" FontWeight="Bold"
                    Margin="0,0,16,0" Click="Btn_Yes_Click"/>
            <Button x:Name="Btn_No" Content="No" Width="96" Height="34" FontSize="15" FontWeight="Bold"
                    IsDefault="True" IsCancel="True" Click="Btn_No_Click"/>
        </StackPanel>
    </Grid>
</Window>
