<Window x:Class="HolyLogger.HolyMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolyLogger" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icon circle -->
        <Ellipse Grid.Row="0" Grid.Column="0"
                 x:Name="IconCircle"
                 Width="44" Height="44"
                 VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Viewbox Grid.Row="0" Grid.Column="0"
                 x:Name="IconViewbox"
                 Width="26" Height="26"
                 VerticalAlignment="Top" HorizontalAlignment="Left"
                 Margin="9,9,0,0">
            <Path x:Name="IconPath" Stretch="Uniform"/>
        </Viewbox>

        <!-- MESSAGE TEXT, IN A SCROLLER THAT ALMOST NEVER SHOWS ITSELF.
             The window grows to fit its text (SizeToContent="Height"), which is right until the text
             is taller than the screen: then the window grows past the bottom of the monitor and takes
             its own OK button with it. The height is capped in code to what the screen can hold, and
             this is what saves the message when that cap bites - a scrollbar appears, the buttons stay
             where they are, and every word is still reachable. Horizontal scrolling is off on purpose:
             TextWrapping="Wrap" breaks even a single word too long for the line, so nothing can run
             off the right-hand edge. -->
        <ScrollViewer Grid.Row="0" Grid.Column="1"
                      x:Name="MessageScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageText"
                       FontSize="18" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- OK button (info/success/warning/error mode). Right by default, as every dialog in the
             program has always had it; ShowWithLinks centres it for the one kind of message that ends
             in a list of files rather than in a sentence. -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="OkBtn" Content="OK"
                Width="110" Height="38" FontSize="17"
                HorizontalAlignment="Right" IsDefault="True"
                Click="OkBtn_Click"/>

        <!-- Yes / No buttons (confirm mode) -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    x:Name="ConfirmPanel"
                    Orientation="Horizontal" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <!-- MinWidth, NOT Width. "Yes" and "No" need 110 and get it, but ShowConfirm lets a caller
                 name its own buttons ("Add 4Z1KD to this log", "Choose a log…") and a fixed width cut
                 those in half - the reader was offered a choice he could not read. They grow to their
                 words now, and the window widens to hold them (see FitWidthToButtons). -->
            <Button x:Name="YesBtn" Content="Yes"
                    MinWidth="110" Height="38" FontSize="17" Padding="14,0"
                    IsDefault="True" Margin="0,0,10,0"
                    Click="YesBtn_Click"/>
            <!-- A THIRD ANSWER, shown only when a caller names it. Some questions have two useful
                 answers and neither of them is "no": "make me a new contest log" and "open the one I
                 already have" are both yes, and offering only the first sends everybody who already
                 has a log looking for a menu. Collapsed by default, so every existing Yes/No dialog in
                 the program is untouched. -->
            <Button x:Name="ExtraBtn"
                    MinWidth="110" Height="38" FontSize="17" Padding="14,0"
                    Margin="0,0,10,0" Visibility="Collapsed"
                    Click="ExtraBtn_Click"/>
            <Button x:Name="NoBtn" Content="No"
                    MinWidth="110" Height="38" FontSize="17" Padding="14,0"
                    IsCancel="True"
                    Click="NoBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
