<Window x:Class="HolyLogger.HolyMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolyLogger" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icon circle -->
        <Ellipse Grid.Row="0" Grid.Column="0"
                 x:Name="IconCircle"
                 Width="44" Height="44"
                 VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Viewbox Grid.Row="0" Grid.Column="0"
                 x:Name="IconViewbox"
                 Width="26" Height="26"
                 VerticalAlignment="Top" HorizontalAlignment="Left"
                 Margin="9,9,0,0">
            <Path x:Name="IconPath" Stretch="Uniform"/>
        </Viewbox>

        <!-- MESSAGE TEXT, IN A SCROLLER THAT ALMOST NEVER SHOWS ITSELF.
             The window grows to fit its text (SizeToContent="Height"), which is right until the text
             is taller than the screen: then the window grows past the bottom of the monitor and takes
             its own OK button with it. The height is capped in code to what the screen can hold, and
             this is what saves the message when that cap bites - a scrollbar appears, the buttons stay
             where they are, and every word is still reachable. Horizontal scrolling is off on purpose:
             TextWrapping="Wrap" breaks even a single word too long for the line, so nothing can run
             off the right-hand edge. -->
        <ScrollViewer Grid.Row="0" Grid.Column="1"
                      x:Name="MessageScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageText"
                       FontSize="18" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- OK button (info/success/warning/error mode). Right by default, as every dialog in the
             program has always had it; ShowWithLinks centres it for the one kind of message that ends
             in a list of files rather than in a sentence. -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="OkBtn" Content="OK"
                Width="110" Height="38" FontSize="17"
                HorizontalAlignment="Right" IsDefault="True"
                Click="OkBtn_Click"/>

        <!-- Yes / No buttons (confirm mode) -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    x:Name="ConfirmPanel"
                    Orientation="Horizontal" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <Button x:Name="YesBtn" Content="Yes"
                    Width="110" Height="38" FontSize="17"
                    IsDefault="True" Margin="0,0,10,0"
                    Click="YesBtn_Click"/>
            <Button x:Name="NoBtn" Content="No"
                    Width="110" Height="38" FontSize="17"
                    IsCancel="True"
                    Click="NoBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
