<Window x:Class="HolyLogger.LogVerifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HolyLogger"
        Title="Log Fixer" Width="1240" Height="1034" MinWidth="900" MinHeight="624"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- THE LOG FIXER. The class is still called LogVerifierWindow because the Verifier is what FINDS
         the problems and this window has always held that scan; what changed is that the window is now
         also where they are put right, and the operator's word for that is Fixer. Renaming the file
         would touch the project, the XAML class and every caller for no behaviour at all. -->
    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TB_Header" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <!-- Named because it is REPLACED when the window is opened on differences somebody else
                 found: the words below are about the scan, and a window that did not scan anything must
                 not claim to have. -->
            <TextBlock x:Name="TB_Intro" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedTextBrush}">
                <Run Text="Every QSO was checked against the country databases on ITS OWN DATE, and against itself for impossible values. Check the kinds of problem you want put right, then "/><Run
                    Text="Fix selected" FontWeight="Bold" Foreground="{DynamicResource Danger}"/><Run
                    Text=". Your whole database — every log in it — is copied first, so nothing here is final. You can view the database in "/><Run
                    Text="File → Backups &amp; Restore" FontWeight="Bold"/><Run
                    Text="."/><LineBreak/><Run
                    Text="Where the program has no answer, "/><Run
                    Text="type the right value into the green row" FontWeight="Bold" Foreground="{DynamicResource Danger}"/><Run
                    Text=" and its check box comes alive. Double-clicking a row still opens the whole QSO for editing."/><LineBreak/><!--
                    THE RULE THE GREEN BUTTON OBEYS, IN THE ONE PLACE THAT IS ALWAYS ON SCREEN. The
                    button says the outcome - "User approved 6" - and nobody reads an outcome and works
                    backwards to what it is about to do to six contacts. Both halves are said here
                    instead: a tick is a correction, and no tick is an approval, which is why a row he
                    has passed over is never raised at him again. --><Run
                    Text="Two answers, one to a row: tick "/><Run
                    Text="Fix" FontWeight="Bold" Foreground="{DynamicResource Danger}"/><Run
                    Text=" to take the correction, or tick "/><Run
                    Text="Do not change" FontWeight="Bold" Foreground="{DynamicResource Danger}"/><Run
                    Text=" to keep the QSO as it is — that one is approved, and the Log Fixer stops raising it. A row with neither ticked is left for another day."/>
            </TextBlock>
        </StackPanel>

        <!-- WHAT WAS FOUND, BY KIND. One row per kind of problem, because that is how an operator
             decides: "yes, put the wrong countries right - no, leave my spellings alone". Ticking a
             kind ticks every QSO of that kind in the table below, which can then be overruled one by
             one. The kinds that cannot be put right automatically are listed too, greyed, so the
             count on screen always adds up to what the scan actually found. -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,8,10,10"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button x:Name="Btn_Fix" DockPanel.Dock="Right" Height="38" MinWidth="240"
                            FontSize="16" FontWeight="Bold" IsEnabled="False" Click="Btn_Fix_Click"
                            Background="#2E7D32" Foreground="White" BorderBrush="#1B5E20"
                            BorderThickness="1.5" Content="Fix selected"/>
                    <!-- BETWEEN THE TWO, and docked right like them, so the order on screen reads
                         Show all kinds, Check with AI, Fix selected: look at everything, ask about
                         the one pile that needs judgement, then write. Declared after Fix because a
                         DockPanel lays right-docked children out from the right inwards. -->
                    <Button x:Name="Btn_Ai" DockPanel.Dock="Right" Height="38" MinWidth="170"
                            Margin="0,0,10,0" FontSize="16" Click="Btn_Ai_Click"
                            Content="Check with AI"/>
                    <Button x:Name="Btn_ShowAll" DockPanel.Dock="Right" Height="38" MinWidth="150"
                            Margin="0,0,10,0" FontSize="16" Visibility="Collapsed" Click="Btn_ShowAll_Click"
                            Content="Show all kinds"/>
                    <!-- THE SPINNER FROM THE SPLASH SCREEN, seconds and all.
                         A sliding bar says only "something is happening"; this says how long it has
                         been happening, which is the thing an operator actually wants while an AI
                         thinks. It is drawn by the program on the program's own thread, so when it
                         stops turning the program really has stopped - an animated picture would go
                         on spinning cheerfully over a window that had died.
                         Two columns: the words take what they need, the spinner stands immediately
                         after them rather than away at the far end of the row. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 34, THE WIDTH OF THE TICK-BOX COLUMN in the list of kinds above. The
                             line started at the frame's edge and the buttons start after their tick
                             boxes, so the two were a box-width out of step down the left-hand side.
                             Same number, so they cannot drift apart. -->
                        <TextBlock x:Name="TB_KindsSummary" Grid.Column="0" VerticalAlignment="Center"
                                   Margin="34,0,0,0"
                                   FontSize="16" Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 38, THE HEIGHT OF THE BUTTONS BESIDE IT. At 40 the row grew by two
                             pixels the moment the spinner appeared and shrank again when it went,
                             so the whole frame twitched at the start and end of every run. -->
                        <StackPanel x:Name="PB_Ai" Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="12,0,0,0" Visibility="Collapsed">
                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <Ellipse Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0.25"/>
                            <Canvas Width="38" Height="38" RenderTransformOrigin="0.5,0.5">
                                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 19,2 A 17,17 0 0 1 36,19"/>
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="AiSpinnerRotate" Angle="0"/>
                                </Canvas.RenderTransform>
                            </Canvas>
                            <TextBlock x:Name="AiSeconds" Text="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                        <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="16" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
                <!-- Capped and scrollable: there are a dozen kinds today and nothing says there will
                     not be twenty, and this frame must never grow until it squeezes out the table. -->
                <!-- 190 cut the fifth button in half: each one is about 39px with its padding, border
                     and margin, so five come to 195 and the cap sliced the last. 320 holds eight
                     comfortably and still stops the frame growing into the table. -->
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IC_Kinds">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- LastChildFill off: the button is docked left and sizes to its own
                                     text, so it looks like a button rather than like a stripe across
                                     the frame. The count and the note sit outside it, on the right. -->
                                <DockPanel Margin="0,3,0,3" LastChildFill="False">
                                    <!-- The tick box stays outside the button: ticking a kind and
                                         viewing a kind are two different acts, and one click must
                                         never do both.
                                         A kind the program cannot answer shows NO box at all, rather
                                         than a grey one: a box that can never be ticked is an invitation
                                         the window then refuses. Its 34px are still held by the Grid, so
                                         every button below it stays in the same column. -->
                                    <Grid DockPanel.Dock="Left" Width="34">
                                        <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Fixable}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </Grid>

                                    <!-- SHAPED LIKE A BUTTON, because it behaves like one: it filters
                                         the table to this kind. Plain text that happens to be clickable
                                         is a thing nobody clicks. The colours live in the style rather
                                         than on the element so that hover and "this is the one you are
                                         looking at" can both be triggers - a Background set here would
                                         outrank them and nothing would ever light up. -->
                                    <Border DockPanel.Dock="Left" MouseLeftButtonUp="Kind_Click" Cursor="Hand"
                                            CornerRadius="4" BorderThickness="1" Padding="12,5,12,5"
                                            MinWidth="300" HorizontalAlignment="Left"
                                            ToolTip="Click to show only these QSOs in the table below">
                                        <!-- THE BUTTON WEARS THE SAME COLOUR AS ITS SENTENCE: blue for a
                                             kind the program can put right, red for one only the operator
                                             can settle. Written as two families rather than one, because
                                             hovering and "this is the kind on show" must still light up
                                             inside each - a red button that turned blue under the mouse
                                             would say the wrong thing about itself. The red conditions
                                             come last so they win over the blue ones they repeat. -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D6E6FA"/>
                                                <Setter Property="BorderBrush" Value="#7FA9DC"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#C0DAF8"/>
                                                        <Setter Property="BorderBrush" Value="#1565C0"/>
                                                    </Trigger>
                                                    <!-- After the hover trigger, so the kind currently
                                                         on show stays lit even as the mouse moves off. -->
                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                        <Setter Property="Background" Value="#A6C9F2"/>
                                                        <Setter Property="BorderBrush" Value="#1565C0"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Fixable}" Value="False">
                                                        <Setter Property="Background" Value="#F7D4D4"/>
                                                        <Setter Property="BorderBrush" Value="#D48787"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Fixable}" Value="False"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#F0BDBD"/>
                                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Fixable}" Value="False"/>
                                                            <Condition Binding="{Binding Selected}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#E9A9A9"/>
                                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#1A1A1A"/>
                                    </Border>

                                    <!-- The count sits immediately beside its button, where it reads as
                                         "this kind, this many". Docked left AFTER the button, so the
                                         numbers still line up in a column of their own. Neither this
                                         nor the note is part of the button: they are facts about the
                                         kind, not things to press. -->
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}"
                                               FontSize="16" FontWeight="Bold" MinWidth="70"
                                               Margin="14,0,0,0" TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <!-- What the kind means, in the window's own blue. Measured: at the
                                         width this window opens with, the longest of them is 593px in
                                         the 703px this leaves, so none of them wraps. Wrapping is on all
                                         the same, because the window can be dragged narrower and a
                                         sentence that quietly loses its end is worse than one on two
                                         lines. -->
                                    <!-- Blue for a kind the program can put right, red for one only the
                                         operator can settle. The colour says at a glance which half of
                                         the list is his work, and it is the same red the heading uses
                                         for the words about typing into the green row. -->
                                    <!-- Markup, not Text: the country lines name cty.dat and Club Log in
                                         bold, and a bound Text is one flat string that cannot. -->
                                    <TextBlock DockPanel.Dock="Left" local:RichNote.Markup="{Binding HandNote}"
                                               FontSize="16" FontStyle="Italic" Margin="18,0,16,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Fixable}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ONE ROW PER PROBLEM, drawn as two halves: what the log says now, and what it would say
             after the fix. A QSO with two problems appears twice, once for each, so a tick means
             exactly one thing and "fix the band but not the country" is possible.
             The halves are inside ONE grid row rather than being two grid rows - that is what lets the
             tick box and the callsign stand beside the pair instead of beside one half of it, and it
             keeps the row the unit the DataGrid virtualizes. -->
        <DataGrid x:Name="FindingsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column"
                  GridLinesVisibility="Vertical" FontSize="16" RowHeaderWidth="0"
                  BorderBrush="#1565C0" BorderThickness="1"
                  Background="{DynamicResource GridRowBg}"
                  Foreground="{DynamicResource TextBrush}"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VerticalGridLinesBrush="{DynamicResource GridLine}"
                  ClipboardCopyMode="IncludeHeader"
                  PreviewMouseRightButtonDown="FindingsGrid_PreviewMouseRightButtonDown"
                  MouseDoubleClick="FindingsGrid_MouseDoubleClick"
                  SelectionChanged="FindingsGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <!-- The solid black line that separates one pair from the next. -->
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderBrush" Value="#000000"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    <Style.Triggers>
                        <!-- A TICKED ROW IS A HIGHLIGHTED ROW, painted from the tick itself rather than
                             from the DataGrid's selection. Driving it through SelectedItems was measured
                             on the operator's own log: SelectAll 2,379 ms and UnselectAll 2,333 ms on
                             4,558 rows - the same calls cost 3 and 6 ms on a plain two-column grid, so
                             it is this table's twelve template columns that make touching every row so
                             expensive. A trigger costs nothing at all: WPF only styles the rows actually
                             on screen, so ticking four thousand is as quick as ticking one. -->
                        <DataTrigger Binding="{Binding Apply}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,3"/>
                    <Setter Property="Padding" Value="5,3,5,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#DEB887"/>
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <!-- The QSO tick, one per pair. Set from the frame above, then the operator's to
                     overrule. A template column rather than a check-box column so one click ticks it -
                     a check-box column spends the first click entering edit mode. -->
                <DataGridTemplateColumn Header="Fix" Width="54" CanUserSort="False">
                   <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsEnabled="{Binding Fixable}"
                                      IsChecked="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Callsign" Binding="{Binding Call}" Width="Auto" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="What is wrong" Binding="{Binding Problem}" Width="220" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Field" Binding="{Binding FieldLabel}" Width="Auto" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- THE PAIR. Top half: the log as it stands, on red. Bottom half: what it would say,
                     on green. A finding with nothing to propose shows the lower half empty and its
                     tick box disabled - the program will not guess. -->
                <DataGridTemplateColumn Header="Now  /  Would become" Width="*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFCDD2" Padding="7,3,7,3"
                                        BorderBrush="#B0B0B0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Current}" TextWrapping="Wrap"
                                               Foreground="#7F0000"/>
                                </Border>
                                <Border Grid.Row="1" Background="#C8E6C9" Padding="7,3,7,3">
                                    <TextBlock Text="{Binding Suggested}" TextWrapping="Wrap"
                                               FontWeight="Bold" Foreground="#1B5E20"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="170" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- A GRID, NOT A DOCKPANEL, so Close sits on the row's true centre. Docked, it could only be
             pushed to one end or centred in whatever gap the summary happened to leave. Here both are
             laid out against the FULL width of the row: the line of text keeps the left, the button
             stands in the middle of the window whatever the text beside it says. -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="TB_Summary" HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontSize="16" Margin="0,0,12,0"
                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
            <!-- NOT IsCancel. Escape belongs to the table here - it clears the highlight - and a
                 window that shuts on the same key would throw away a page of ticks the moment an
                 operator tried to deselect a row. Closing is this button, or the title bar. -->
            <Button x:Name="Btn_Close" Content="Close" HorizontalAlignment="Center" Width="120" Height="38"
                    FontSize="16" Click="Btn_Close_Click"/>
        </Grid>

        <!-- WHILE IT IS WRITING. A line of small text at the foot of the window was not enough: an
             operator who ticked 4,376 spellings watched "fixing…" in the corner and reasonably decided
             the program had died. This sits over everything, says what is happening, counts, and turns
             - and it also stops the table being clicked while its rows are being rewritten. -->
        <Grid x:Name="FixOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100"
              Visibility="Collapsed" Background="#A6000000">
            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2" CornerRadius="6" Padding="30,22,30,22" MinWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- A gapped ring, turned by the storyboard in the code behind. -->
                        <Ellipse Width="32" Height="32" Margin="0,0,14,0"
                                 Stroke="#2E7D32" StrokeThickness="4"
                                 StrokeDashArray="4 2.4" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="FixSpin" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="TB_FixTitle" Text="Fixing your log…" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <TextBlock x:Name="TB_FixProgress" FontSize="18" FontWeight="Bold" Margin="0,14,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>

                    <ProgressBar x:Name="PB_Fix" Height="16" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                 Foreground="#2E7D32"/>

                    <TextBlock FontSize="16" Margin="0,12,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Please wait. A copy of your log was saved before this started, so nothing here is final."/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
