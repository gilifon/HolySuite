<Window x:Class="HolyLogger.LotwRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts a confirmation service has and this log does not" Width="1120" Height="700"
        MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <!-- LoTW HOLDS THE CONTACT, THE LOG DOES NOT. Every one of these is a confirmation whose callsign
         appears NOWHERE in this log, so there is nothing here to duplicate: adding them puts back
         contacts the log has lost, which is the whole point of having uploaded to LoTW before the
         machine that held the log died.
         The near misses - the station IS logged but the band, the mode or the date disagrees - are not
         here. Those are a question about a QSO that exists, and they are asked in the Log Fixer. -->
    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TB_Header" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <!-- Written in code, because the service is named in it and what that service keeps of a
                 contact differs: LoTW has never held a signal report, eQSL sends both. -->
            <TextBlock x:Name="TB_Explain" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>

        <DataGrid x:Name="Grid_Missing" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader" FontSize="16"
                  GridLinesVisibility="All" RowHeight="30"
                  Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Add" Width="56" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Add, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Every column narrowed when the two RST ones were added. They had pushed the total
                     past the width of the window, and the only column that can give way is Country -
                     which shrank until its header read "C". -->
                <DataGridTextColumn Header="Date"     Binding="{Binding DateText}" Width="105" IsReadOnly="True"/>
                <DataGridTextColumn Header="Time"     Binding="{Binding TimeText}" Width="72"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Callsign" Binding="{Binding Call}"     Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Band"     Binding="{Binding Band}"     Width="76"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Mode"     Binding="{Binding Mode}"     Width="76"  IsReadOnly="True"/>
                <!-- Collapsed for LoTW, which has never held a signal report. Shown for eQSL, which
                     sends both - and a restored contact keeping its real reports is the difference
                     between a record of a QSO and a note that one happened. -->
                <DataGridTextColumn x:Name="Col_RstSent" Header="RST Sent" Binding="{Binding RstSent}" Width="86" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="Col_RstRcvd" Header="RST Rcvd" Binding="{Binding RstRcvd}" Width="86" IsReadOnly="True"/>
                <DataGridTextColumn Header="Country"  Binding="{Binding Country}"  Width="*" MinWidth="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="DX Locator" Binding="{Binding Grid}"   Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="My Callsign" Binding="{Binding MyCall}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="Btn_Add" DockPanel.Dock="Right" Height="38" MinWidth="260" FontSize="16"
                    FontWeight="Bold" Click="Btn_Add_Click"
                    Background="#2E7D32" Foreground="White" BorderBrush="#1B5E20" BorderThickness="1.5"
                    Content="Add ticked to this log"/>
            <Button x:Name="Btn_None" DockPanel.Dock="Right" Height="38" MinWidth="130" FontSize="16"
                    Margin="0,0,10,0" Click="Btn_None_Click" Content="Tick none"/>
            <Button x:Name="Btn_All" DockPanel.Dock="Right" Height="38" MinWidth="130" FontSize="16"
                    Margin="0,0,10,0" Click="Btn_All_Click" Content="Tick all"/>
            <TextBlock x:Name="TB_Status" VerticalAlignment="Center" FontSize="16"
                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- WHILE THE CONTACTS ARE BEING WRITTEN. Adding them is not instant: the whole database is
             copied first, then the rows are inserted, then each is matched and marked confirmed. Done
             on the UI thread with nothing shown, the window simply stopped responding and there was no
             way to tell a working program from a dead one. Same spinner as the confirmation download,
             and it counts, because a number that changes says "running" in a way a turning ring cannot. -->
        <Border x:Name="WorkOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                Background="{DynamicResource WindowBg}" Opacity="0.94"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock x:Name="TB_WorkText" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="TB_WorkSub" FontSize="16" TextAlignment="Center" Margin="0,6,0,0"
                           MaxWidth="460" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <Grid Width="46" Height="46" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Ellipse Width="46" Height="46" StrokeThickness="5" Opacity="0.2"
                             Stroke="{DynamicResource AccentBrush}"/>
                    <Ellipse x:Name="SpinnerArc" Width="46" Height="46" StrokeThickness="5"
                             Stroke="{DynamicResource AccentBrush}" StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round" StrokeDashArray="7 30"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="TB_WorkElapsed" FontSize="16" TextAlignment="Center" Margin="0,10,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
