<Window x:Class="HolyLogger.LotwRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts LoTW has and this log does not" Width="1000" Height="700"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <!-- LoTW HOLDS THE CONTACT, THE LOG DOES NOT. Every one of these is a confirmation whose callsign
         appears NOWHERE in this log, so there is nothing here to duplicate: adding them puts back
         contacts the log has lost, which is the whole point of having uploaded to LoTW before the
         machine that held the log died.
         The near misses - the station IS logged but the band, the mode or the date disagrees - are not
         here. Those are a question about a QSO that exists, and they are asked in the Log Fixer. -->
    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TB_Header" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedTextBrush}">
                <Run Text="LoTW has these confirmed contacts and this log has no QSO with that callsign at all. Tick the ones to put back and press "/><Run
                    Text="Add ticked to this log" FontWeight="Bold" Foreground="{DynamicResource Danger}"/><Run
                    Text=". They are added as confirmed by LoTW, and marked in the comment as having come from there."/><LineBreak/><Run
                    Text="LoTW keeps only what you see here — no report, no name, no QTH — so a restored contact has those fields empty."/>
            </TextBlock>
        </StackPanel>

        <DataGrid x:Name="Grid_Missing" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader" FontSize="16"
                  GridLinesVisibility="All" RowHeight="30"
                  Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Add" Width="56" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Add, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date"     Binding="{Binding DateText}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Time"     Binding="{Binding TimeText}" Width="80"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Callsign" Binding="{Binding Call}"     Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Band"     Binding="{Binding Band}"     Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Mode"     Binding="{Binding Mode}"     Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Country"  Binding="{Binding Country}"  Width="*"   IsReadOnly="True"/>
                <DataGridTextColumn Header="DX Locator" Binding="{Binding Grid}"   Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="My Callsign" Binding="{Binding MyCall}" Width="140" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="Btn_Add" DockPanel.Dock="Right" Height="38" MinWidth="260" FontSize="16"
                    FontWeight="Bold" Click="Btn_Add_Click"
                    Background="#2E7D32" Foreground="White" BorderBrush="#1B5E20" BorderThickness="1.5"
                    Content="Add ticked to this log"/>
            <Button x:Name="Btn_None" DockPanel.Dock="Right" Height="38" MinWidth="130" FontSize="16"
                    Margin="0,0,10,0" Click="Btn_None_Click" Content="Tick none"/>
            <Button x:Name="Btn_All" DockPanel.Dock="Right" Height="38" MinWidth="130" FontSize="16"
                    Margin="0,0,10,0" Click="Btn_All_Click" Content="Tick all"/>
            <TextBlock x:Name="TB_Status" VerticalAlignment="Center" FontSize="16"
                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
