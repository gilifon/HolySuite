            <Grid Width="95">
                <Path Stroke="#E53935" StrokeThickness="1.6" Data="M7,3 C1,8 1,24 7,29" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Path Stroke="#E53935" StrokeThickness="1.6" Data="M11,3 C5,8 5,24 11,29" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                    <TextBlock Text="Spot (F3)" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
                <Path Stroke="#E53935" StrokeThickness="1.6" Data="M86,3 C92,8 92,24 86,29"/>
                <Path Stroke="#E53935" StrokeThickness="1.6" Data="M81,3 C88,8 88,24 81,29" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Button>
        <Border x:Name="PlayCommandsBorder" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="462,6,0,0" Width="205" Height="38" BorderThickness="1" CornerRadius="5" Background="Transparent" ToolTip="Play radio voice messages (F5-F8)">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#9966CC"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="BorderBrush" Value="#B5B5B5"/>
                            <Setter Property="Background" Value="#F2F2F2"/>
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- FONT 11 HERE ON PURPOSE - do not raise it to 16 with the rest of the program. These
                     four buttons are 44x32 and carry two lines each, the name and the function key; at 16
                     the words are cut off, which is what happened when the no-font-below-16 rule was
                     applied everywhere and is why it was undone here. Same for Spot (F3) at 15. -->
                <Button x:Name="Btn_Msg1" Grid.Column="1" Style="{StaticResource MsgButtonStyle}" Width="44" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Tag="1" Click="MessageButton_Click" MouseRightButtonUp="MessageButton_RightClick" PreviewMouseLeftButtonDown="MessageButton_PreviewLeftDown">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Msg1" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="F5" FontSize="11" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="Btn_Msg2" Grid.Column="3" Style="{StaticResource MsgButtonStyle}" Width="44" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Tag="2" Click="MessageButton_Click" MouseRightButtonUp="MessageButton_RightClick" PreviewMouseLeftButtonDown="MessageButton_PreviewLeftDown">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Msg2" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="F6" FontSize="11" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="Btn_Msg3" Grid.Column="5" Style="{StaticResource MsgButtonStyle}" Width="44" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Tag="3" Click="MessageButton_Click" MouseRightButtonUp="MessageButton_RightClick" PreviewMouseLeftButtonDown="MessageButton_PreviewLeftDown">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Msg3" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="F7" FontSize="11" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="Btn_Msg4" Grid.Column="7" Style="{StaticResource MsgButtonStyle}" Width="44" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Tag="4" Click="MessageButton_Click" MouseRightButtonUp="MessageButton_RightClick" PreviewMouseLeftButtonDown="MessageButton_PreviewLeftDown">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Msg4" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Text="F8" FontSize="11" Foreground="#444444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <TextBlock HorizontalAlignment="Left" Margin="192,12,0,0" VerticalAlignment="Top" Grid.Row="1" Width="56" Height="38" FontSize="16" ToolTip="Your grid locator" TextAlignment="Left" LineHeight="14" LineStackingStrategy="BlockLineHeight">
            <Run Text="My" FontWeight="Bold" />
            <LineBreak />
            <Run Text="Locator" />
        </TextBlock>
        <TextBox x:Name="TB_MyLocator" HorizontalAlignment="Left" Margin="252,11,0,0" Grid.Row="1" TextWrapping="NoWrap" VerticalAlignment="Top" CharacterCasing="Upper" Text="{Binding Default.my_locator, Source={StaticResource Settings}}" Width="72" Height="28" TextChanged="TB_MyHolyland_TextChanged" PreviewLostKeyboardFocus="TB_MyLocator_PreviewLostKeyboardFocus" FontSize="16" TextAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" MaxLength="6" TabIndex="3"/>
        <TextBlock HorizontalAlignment="Left" Margin="332,12,0,0" VerticalAlignment="Top" Grid.Row="1" Width="65" Height="38" FontSize="15" ToolTip="Your Holyland square" TextAlignment="Left" LineHeight="14" LineStackingStrategy="BlockLineHeight">
            <Run Text="Holyland" FontWeight="Bold" />
            <LineBreak />
            <Run Text="Square" />
        </TextBlock>
        <TextBox x:Name="TB_MyHolyland" HorizontalAlignment="Left" Margin="400,11,0,0" Grid.Row="1" TextWrapping="NoWrap" VerticalAlignment="Top" CharacterCasing="Upper" Text="{Binding Default.my_square, Source={StaticResource Settings}}" Width="58" Height="28" TextChanged="TB_MyHolyland_TextChanged" PreviewLostKeyboardFocus="TB_MyHolyland_PreviewLostKeyboardFocus" FontSize="16" TextAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" MaxLength="5" TabIndex="4"/>
        <Label Content="Mode" HorizontalAlignment="Left" Margin="479,48,0,0" VerticalAlignment="Top" Grid.Row="1" FontSize="16"  ToolTip="Select the working mode"/>
