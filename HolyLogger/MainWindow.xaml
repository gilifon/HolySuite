                 Foreground="{DynamicResource MutedTextBrush}"
                 ToolTip="The ARRL DXCC entity number for this country — what an award is counted on" />
        <Label Content="State" HorizontalAlignment="Left" Margin="580,159,0,0" VerticalAlignment="Top" Grid.Row="1" FontSize="16" />
        <TextBox x:Name="TB_State" HorizontalAlignment="Left" Height="28" Margin="627,163,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" Width="40" CharacterCasing="Upper" MaxLength="3" Grid.Row="1" FontSize="16" TabIndex="17" TextChanged="TB_State_TextChanged" />
        <!-- Orphaned QRZ-photo frame: never populated by any code (Img_QRZPhoto is unreferenced),
             but its opaque #F5F7FA background at ZIndex 20 painted a white box over the map
             placeholder whenever the WebBrowser was hidden. Collapsed so it cannot bleed through. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1" Margin="752,94,0,0" Width="160" Height="160" BorderBrush="#7A95A8" BorderThickness="1" Background="#F5F7FA" CornerRadius="4" Panel.ZIndex="20" Visibility="Collapsed">
            <Image x:Name="Img_QRZPhoto" Stretch="UniformToFill" Visibility="Collapsed" ToolTip="QRZ callsign image" />
        </Border>

        <TextBlock HorizontalAlignment="Left" Margin="11,201,0,0" VerticalAlignment="Top" Grid.Row="1" Width="56" FontSize="16" ToolTip="The DX station grid locator" TextAlignment="Left" LineHeight="14" LineStackingStrategy="BlockLineHeight">
            <Run Text="DX" FontWeight="Bold" />
            <LineBreak />
            <Run Text="Locator" />
        </TextBlock>
        <TextBox x:Name="TB_DXLocator" HorizontalAlignment="Left" Margin="69,201,0,0" Grid.Row="1" TextWrapping="NoWrap" VerticalAlignment="Top" CharacterCasing="Upper" Width="74" Height="28" FontSize="16" MaxLength="8" TabIndex="18"/>
        <Label Content="ITU" HorizontalAlignment="Left" Margin="142,199,0,0" VerticalAlignment="Top" Height="28" VerticalContentAlignment="Center" Grid.Row="1" FontSize="16" ToolTip="ITU Zone (from QRZ.com)"/>
        <TextBox x:Name="TB_ITUZone" HorizontalAlignment="Left" Height="28" Margin="177,201,0,0" VerticalAlignment="Top" Width="31" Grid.Row="1" FontSize="16" MaxLength="2" PreviewTextInput="ZoneTextBox_PreviewTextInput" VerticalContentAlignment="Center" IsTabStop="False"/>
        <Label Content="CQ" HorizontalAlignment="Left" Margin="212,199,0,0" VerticalAlignment="Top" Height="28" VerticalContentAlignment="Center" Grid.Row="1" FontSize="16" ToolTip="CQ Zone (from QRZ.com)"/>
        <TextBox x:Name="TB_CQZone" HorizontalAlignment="Left" Height="28" Margin="245,201,0,0" VerticalAlignment="Top" Width="31" Grid.Row="1" FontSize="16" MaxLength="2" PreviewTextInput="ZoneTextBox_PreviewTextInput" VerticalContentAlignment="Center" IsTabStop="False"/>
        <Label Content="Comment" HorizontalAlignment="Left" Margin="281,197,0,0" VerticalAlignment="Top" Grid.Row="1" FontSize="16" ToolTip="Free text comments"/>
        <TextBox x:Name="TB_Comment" HorizontalAlignment="Left" Height="28" Margin="364,201,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" Width="274" Grid.Row="1" Text="{Binding Default.Comment, Source={StaticResource Settings}}" FontSize="16" MaxLength="65" TabIndex="19"/>
        <Rectangle x:Name="LockComment_Btn" ToolTip="Lock/Unlock Comment" HorizontalAlignment="Left" Height="22" Margin="647,205,0,0" VerticalAlignment="Top" Width="20" Fill="{DynamicResource TextBrush}" MouseUp="LockComment_Btn_MouseUp" Grid.Row="1" Cursor="Hand">
            <Rectangle.OpacityMask>
                <ImageBrush x:Name="LockCommentMask" ImageSource="Images/lock.png" Stretch="Uniform"/>
            </Rectangle.OpacityMask>
        </Rectangle>
        <!-- ACTIVITY PROGRAM REFERENCES. The four programs ADIF names get a box each; every other
             program on earth - castles, mills, lighthouses, and whatever is founded next year - goes
             through the Other button into ADIF's SIG / SIG_INFO pair, so this row never has to grow.
             There is no room for a fifth labelled box: five pairs measure 750px against the form's 661.

             One Canvas rather than nine loose controls so contest mode can hide the whole row with a
             single Visibility, and so RowShift has one element to place instead of nine. Labels carry
             Padding="0" because a Label's default 5px padding would push each box out of the measured
             positions this row was laid out to. -->
        <Canvas x:Name="ActivityRow" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="0,233,0,0" Width="677" Height="58">
            <Label Content="IOTA" Canvas.Left="29" Canvas.Top="0" Height="28" Padding="0" FontSize="16"
                   VerticalContentAlignment="Center" ToolTip="Islands on the Air, e.g. EU-005"/>
            <!-- MaxLength is deliberately looser than the format: an island reference is exactly 6
                 characters and a nature one 8 to 11, but a box that simply stops accepting keystrokes
                 makes a typo impossible to correct by typing past it, and impossible to paste into.
                 The red tint does the complaining instead, and Add asks once before logging. -->
            <TextBox x:Name="TB_Iota" Canvas.Left="69" Canvas.Top="0" Width="62" Height="28" FontSize="16"
                     CharacterCasing="Upper" MaxLength="20" TabIndex="20" TextWrapping="NoWrap"
                     VerticalContentAlignment="Center" TextChanged="ActivityBox_TextChanged"
                     ToolTip="Islands on the Air: two letters for the continent, then three digits - EU-005"/>
            <Label Content="SOTA" Canvas.Left="133" Canvas.Top="0" Height="28" Padding="0" FontSize="16"
                   VerticalContentAlignment="Center" ToolTip="Summits on the Air, e.g. W2/WE-003"/>
            <TextBox x:Name="TB_SotaRef" Canvas.Left="177" Canvas.Top="0" Width="90" Height="28" FontSize="16"
                     CharacterCasing="Upper" MaxLength="20" TabIndex="21" TextWrapping="NoWrap"
                     VerticalContentAlignment="Center" TextChanged="ActivityBox_TextChanged"
                     ToolTip="Summits on the Air: the summit reference - W2/WE-003, G/LD-003"/>
            <Label Content="POTA" Canvas.Left="320" Canvas.Top="0" Height="28" Padding="0" FontSize="16"
                   VerticalContentAlignment="Center" ToolTip="Parks on the Air, e.g. K-0001"/>
            <TextBox x:Name="TB_PotaRef" Canvas.Left="364" Canvas.Top="0" Width="125" Height="28" FontSize="16"
                     CharacterCasing="Upper" MaxLength="90" TabIndex="22" TextWrapping="NoWrap"
                     VerticalContentAlignment="Center" TextChanged="ActivityBox_TextChanged"
                     ToolTip="Parks on the Air: the park reference - K-0001. Two parks at once are written K-0001,US-4578"/>
            <Label Content="WWFF" Canvas.Left="501" Canvas.Top="0" Height="28" Padding="0" FontSize="16"
                   VerticalContentAlignment="Center" ToolTip="World Wide Flora and Fauna, e.g. 4XFF-0016"/>
            <TextBox x:Name="TB_WwffRef" Canvas.Left="553" Canvas.Top="0" Width="85" Height="28" FontSize="16"
                     CharacterCasing="Upper" MaxLength="20" TabIndex="23" TextWrapping="NoWrap"
                     VerticalContentAlignment="Center" TextChanged="ActivityBox_TextChanged"
                     ToolTip="World Wide Flora and Fauna: the nature-reserve reference - 4XFF-0016"/>
            <!-- EVERY OTHER PROGRAM, ON THE FORM ITSELF. The four boxes above exist because ADIF gives
                 those four a field each; castles, mills, lighthouses and whatever is founded next year
                 share the standard's SIG / SIG_INFO pair, and that pair is these two controls.
                 It used to be a button that opened a window. A drop-down says what it is without being
                 pressed: the chevron shows it opens, the list spells out what each short name collects,
                 and the box keeps the short name alone - which is what is logged. Editable, because the
                 list of programs has no end and a new one must be typeable.
                 The window behind the old button still exists; the QSO editor opens it. -->
            <ComboBox x:Name="CB_ActivitySig" Canvas.Left="69" Canvas.Top="34" Width="104" Height="28" FontSize="16"
                      IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                      TextSearch.TextPath="Key" TabIndex="24"
                      Template="{StaticResource FlatEditableComboTemplate}"
                      Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                      PreviewMouseLeftButtonUp="ActivitySig_PreviewMouseLeftButtonUp"
                      PreviewKeyDown="ActivitySig_PreviewKeyDown"
                      TextBoxBase.TextChanged="ActivitySig_TextChanged"
                      ToolTip="Any other program - castles, mills, lighthouses. Pick one or type its short name.">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Key}" FontSize="16" FontWeight="Bold" MinWidth="72"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Value}" FontSize="16" Margin="8,0,0,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="TB_ActivitySigInfo" Canvas.Left="177" Canvas.Top="34" Width="150" Height="28" FontSize="16"
                     CharacterCasing="Upper" MaxLength="60" TabIndex="25" TextWrapping="NoWrap"
                     VerticalContentAlignment="Center"
                     ToolTip="The reference within that activity, e.g. OK-00234"/>
            <!-- UNDO, and only when there is something to undo.
                 The main window could put back a deleted QSO but not an edited one, so a mistyped
                 callsign or a date changed by accident had to be found and retyped from memory. Edits
                 and deletions now share one stack and this is the way into it: press it and the last
                 thing done is taken back, press it again for the one before.
                 It is not in the tab order - it is a repair, not part of logging a contact - and it is
                 Collapsed until the stack has something in it, so the row is empty in normal use.
                 Right edge lined up with TB_WwffRef above it: 553 + 85 = 638, so 638 - 96 = 542.
                 96 wide with no padding: enough for the arrow and the word at FontSize 16 and no more.
                 120 trimmed the label, 148 was a slab across the row. -->
            <!-- ActionButtonStyle - the keycap the F1 and F9 buttons wear. The plain button template
                 paints its own pale grey over whatever Background it is given the moment the mouse
                 arrives, and on a red button that read as "disabled". This style has no such colour:
                 it lights UP to #A8D8FF instead, which is what every other button on this form does. -->
            <!-- 30 high from Top 32, NOT 28 from 34: the bottom edge is unchanged at 62 and the text
                 gains the 2px it was missing. The keycap template gives its content the face height
                 less 3px of key travel and 2px top and bottom, so a 28px key leaves 21px - and a bold
                 16px line needs a shade over 21. The letters that pay for that shade are the ones with
                 a tail: "Try Again" had its y and its g cut off. Both keys are changed together
                 because they sit side by side and are meant to read as one pair. -->
            <Button x:Name="Btn_UndoMain" Style="{StaticResource DangerActionButtonStyle}"
                    Canvas.Left="542" Canvas.Top="32" Width="96" Height="30"
                    FontSize="16" FontWeight="Bold" Content="↶ Undo" Padding="0" Visibility="Collapsed"
                    IsTabStop="False" Click="Btn_DeleteUndo_Click"/>
            <!-- TRY AGAIN, and only when there is somebody to try.
                 The stations the operator right-clicked in the cluster and meant to come back to. The
                 button is Collapsed while the list is empty, exactly as Undo is: a button that opens an
                 empty window is a button that teaches the operator not to press it. The count is on the
                 face because that is the whole question being asked - how many are still waiting.
                 96 wide, the same as Undo beside it: two keys of one size read as a pair, and a wider
                 one ate the activity hint that shares this row. The count is NOT on the face for the
                 same reason - it is in the tooltip and in the window's own title instead.
                 Right edge 10px clear of Undo: 436 + 96 = 532, Undo starts at 542.
                 It is not in the tab order - like Undo, it is not part of logging a contact. -->
            <Button x:Name="Btn_TryAgain" Style="{StaticResource OrangeActionButtonStyle}"
                    Canvas.Left="436" Canvas.Top="32" Width="96" Height="30"
                    FontSize="16" FontWeight="Bold" Content="Try Again" Padding="0" Visibility="Collapsed"
                    IsTabStop="False" Click="Btn_TryAgain_Click"
                    ToolTip="The stations you sent over from the cluster to try again"/>
            <!-- "Activity" written INSIDE the empty box, the way a placeholder is. The row's other boxes
                 have a label to their left saying what they are; this one has no room for one, and an
                 empty box with a chevron says only "something goes here". Grey, so it cannot be mistaken
                 for a value, and not hit-testable, so a click goes through it to the box underneath.
                 Hidden the moment anything is chosen or typed (ShowActivitySigMeaning). -->
            <!-- Centred by the LAYOUT, not by a top coordinate: the border is exactly the box it sits on
                 and the text centres itself inside it, so it stays centred whatever the font metrics
                 turn out to be. Two attempts at guessing the right Canvas.Top were two attempts too
                 many. -->
            <Border x:Name="TB_ActivitySigPlaceholder" Canvas.Left="69" Canvas.Top="34" Width="104" Height="28"
                    Background="Transparent" IsHitTestVisible="False">
                <!-- The 4px under it are what MAKES it look centred. Centring the line box is not the
                     same as centring the letters: "Activity" has a descender, so its ink hung 3px below
                     the middle while a typed value like ARLHS sits 1px below. Measured off the rendered
                     pixels, 4px of bottom margin lands the placeholder exactly where a real value sits,
                     which is the alignment the eye is actually comparing it against. -->
                <TextBlock Text="Activity" FontSize="16" VerticalAlignment="Center" Margin="5,0,0,4"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </Border>
            <!-- MaxWidth, because this line has to STOP before whatever button is showing. A Canvas
                 draws in declaration order and this text is declared last, so without a limit it ran
                 straight over the button's face - the button and the words appeared on top of one
                 another. The limit is NOT fixed: Try Again and Undo are both Collapsed in normal use,
                 and reserving their space always meant "World Castles Award" was cut short on a row
                 that was two thirds empty. UpdateActivityHintWidth sets it from what is actually on the
                 row; 297 here (638 - 335, less a 6px gap) is the empty-row case it starts in. Anything
                 still too long keeps the ellipsis; the drop-down spells every name out in full. -->
            <TextBlock x:Name="TB_ActivitySigHint" Canvas.Left="335" Canvas.Top="37" FontSize="16"
                       MaxWidth="297"
                       Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False"/>
        </Canvas>
        <!--<ListBox ItemsSource="{Binding}" ItemTemplate="{StaticResource MyDataTemplate}"
             HorizontalContentAlignment="Stretch" Grid.Row="3"/>-->
        <Rectangle Grid.Row="1" Fill="{DynamicResource FormBg}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="677" Height="49" Margin="0,295,0,0" />
        <local:MatrixControl x:Name="MatrixC" HorizontalAlignment="Left" Margin="4,297,0,0" Grid.Row="1" VerticalAlignment="Top" Visibility="Visible"/>
        <!-- The grid and its "Received Confirmation" overlay share this single-cell wrapper on purpose:
             the overlay is positioned by a Margin measured from its parent's origin, so its parent must be
             the same element the header bounds are measured against (see ConfirmationStripHelper.cs).
             ClipToBounds keeps the overlay from spilling outside the grid when columns scroll sideways. -->
        <Grid Grid.Row="2" ClipToBounds="True">
        <!-- RECYCLING, not the default. WPF virtualizes the rows either way, but by default it THROWS
             AWAY each row container as it scrolls out of view and builds a new one for the row coming in
             - on a log of tens of thousands that is a fresh visual tree per row, all the way down. In
             recycling mode the same containers are re-used with new data, which is what makes a long log
             scroll smoothly rather than in steps on a slow machine. Rows only: column virtualization is
             deliberately left off, because the confirmation strip measures real column headers and a
             virtualized header may not exist when it looks. -->
        <DataGrid x:Name="QSODataGrid" ItemsSource="{Binding}" AutoGenerateColumns="False" AlternationCount="2"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}" CanUserAddRows="False" PreviewKeyDown="QSODataGrid_PreviewKeyDown" PreviewMouseRightButtonDown="QSODataGrid_PreviewMouseRightButtonDown" PreviewMouseLeftButtonDown="QSODataGrid_PreviewMouseLeftButtonDown" FontSize="16" Sorting="QSODataGrid_Sorting" ColumnDisplayIndexChanged="QSODataGrid_ColumnDisplayIndexChanged" Drop="QSODataGrid_Drop" AllowDrop="True" LoadingRow="QSODataGrid_LoadingRow" BeginningEdit="QSODataGrid_BeginningEdit" CheckBox.Checked="PaperQsl_Changed" CheckBox.Unchecked="PaperQsl_Changed" ClipboardCopyMode="IncludeHeader" Margin="0,0,6,0" BorderBrush="#1565C0" BorderThickness="3" VerticalGridLinesBrush="{DynamicResource GridLine}" HorizontalGridLinesBrush="{DynamicResource GridLine}" Padding="0,0,0,0">
            <DataGrid.Resources>
                <!-- Keep the selected row blue even when the grid loses focus (e.g. while the right-click
                     context menu is open), so the user clearly sees which row the menu refers to. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{x:Static SystemColors.HighlightColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{x:Static SystemColors.HighlightTextColor}"/>
                <!-- ConfirmHeaderStyle (and the confirmation columns' templates) come from the app-wide
                     Themes/ConfirmationColumns.xaml merged in App.xaml, shared with the Log Workshop. -->
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,3"/>
                    <Setter Property="Padding" Value="5,3,5,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#DEB887"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Style>
            </DataGrid.RowHeaderStyle>
            <!--<DataGrid.ContextMenu>
                <ContextMenu >
                    <MenuItem Header="Delete" Click="MenuItem_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>-->
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Id" IsReadOnly="True" Visibility="Hidden">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding id}"  HorizontalAlignment="Center" Padding="5,0,5,0"  />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Frequency" IsReadOnly="True" CanUserSort="False" Width="Auto">
                    <!-- Header content stays the string "Frequency" (column order/width persistence keys on
                         it); the template just appends a small bold "MHz". -->
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" VerticalAlignment="Bottom"/>
                                <TextBlock Text="MHz" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Freq}" Foreground="{Binding Band, Converter={StaticResource BandColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Date" IsReadOnly="True" SortMemberPath="Date" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Date, Converter={StaticResource QsoDateDisplayConverter}}"  HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Time" IsReadOnly="True" SortMemberPath="Time" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Time, Converter={StaticResource QsoTimeDisplayConverter}}"  HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Callsign" IsReadOnly="False" SortMemberPath="DXCall">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- A LoTW uploader's callsign is tinted with RowLotwBg, the same colour the
                                 cluster uses for a LoTW spot. Only the callsign itself is tinted, not the
                                 whole row: log rows already carry meaning from their background (filter
                                 matches, worked-before), and a second row colour would fight those. -->
                            <TextBlock Text="{Binding DXCall}" HorizontalAlignment="Center" Padding="5,0,5,0" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- LoTW-user tint only. No tooltip: in this table the callsign
                                                 cell is editable (left-click edits it), and QRZ is opened
                                                 from the right-click menu, so a "click for QRZ" hint here
                                                 would be misleading. -->
                                            <DataTrigger Binding="{Binding DXCall, Converter={StaticResource LotwUserConverter}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowLotwBg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Name" IsReadOnly="True" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Country" IsReadOnly="True" SortMemberPath="Country">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Country}" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Band" IsReadOnly="True" CanUserSort="False" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Band}" Foreground="{Binding Band, Converter={StaticResource BandColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="RST-R" IsReadOnly="True" CanUserSort="False" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RST_RCVD}" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="RST-S" IsReadOnly="True" CanUserSort="False" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RST_SENT}" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Mode" IsReadOnly="True" CanUserSort="False" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode}" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Exchange" IsReadOnly="True" CanUserSort="False" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SRX}" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Comment" IsReadOnly="True" Width="Auto" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Comment}" HorizontalAlignment="Center" Padding="5,0,5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- LAST COLUMN, and new columns go after it, never among the existing ones: inserting
                     into the middle moves every column the operator has learned the position of.

                     LoTW CONFIRMATION: has the station confirmed this QSO in Logbook of The World.
                     Nothing to do with whether we uploaded it - a QSO can be uploaded for years and
                     never confirmed. Blank rather than a cross when unconfirmed: most QSOs are
                     unconfirmed, and a column full of crosses reads as a column full of errors. -->
                <!-- The five confirmation columns. Their look (green header strip, tick colours,
                     tooltips) is defined ONCE in Themes/ConfirmationColumns.xaml and shared with the Log
                     Workshop's table, so a change is made in one place. They are draggable, but only as
                     one block and with nothing allowed between them - ConfirmationColumnGroup enforces
                     that, since a column dropped in the middle would split the green strip.

                     CanUserResize=False on all five: each is only ever a tick or a tick-sized box, so
                     there is nothing to widen for, and a resized member would break the set up into
                     mismatched columns instead of the one solid block it is meant to read as. -->
                <DataGridTemplateColumn Header="LoTW" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="LotwStatusRank" Width="Auto" MinWidth="42"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource LotwTickTemplate}"/>
                <DataGridTemplateColumn Header="QRZ" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="QrzStatusRank" Width="Auto" MinWidth="36"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource QrzTickTemplate}"/>
                <DataGridTemplateColumn Header="eQSL" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="EqslStatusRank" Width="Auto" MinWidth="42"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource EqslTickTemplate}"/>
                <DataGridTemplateColumn Header="Club Log" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="ClublogStatusRank" Width="Auto" MinWidth="68"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource ClublogTickTemplate}"/>
                <DataGridTemplateColumn Header="Paper QSL" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="PaperQslStatusRank" Width="Auto" MinWidth="76"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource PaperQslTemplate}"/>
                <!-- ADIF QTH: the worked station's town, filled from the QRZ lookup on the form above.
                     After the confirmation block, at the far right, so nothing an operator has learned
                     the position of moves. -->
                <DataGridTemplateColumn Header="QTH" IsReadOnly="True" SortMemberPath="Qth" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Qth}" HorizontalAlignment="Center" Padding="5,0,5,0" ToolTip="{Binding Qth}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- THE COUNTRY'S IDENTITY, as opposed to its name: the ADIF DXCC entity number, stored
                     with every QSO and what every count of countries is made of. Blank rather than "0"
                     for a contact that belongs to no entity - a station at sea counts for nobody, and a
                     zero in a column of country numbers reads as a country numbered zero. -->
                <DataGridTemplateColumn Header="Country Code" IsReadOnly="True" SortMemberPath="DxccCode" Width="Auto">
                    <!-- "Country" over "Code" WITHOUT making the header bar taller. The bar is 30.28px:
                         one line of 16pt (21.28) plus this style's 3px of padding top and bottom, plus
                         its 3px bottom border. The NEGATIVE MARGIN gives that padding back, so these two
                         lines have the whole 27.28 to live in rather than 21.28 - which is what lets
                         them be 12pt instead of the 10pt that was all a padded header could hold.
                         12pt on a 12.5px line measures 25.00, and the header still asks for only 19,
                         so the bar cannot grow. Measured both ways in a real DataGrid: 30.28 either
                         way. 13pt is the first size where the 'y' of Country touches the 'C' of Code.

                         The Header stays the plain string "Country Code" because that is the key the
                         saved column layout is filed under (GridColumnLayout.KeyOf); only its
                         presentation is templated. -->
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="Country&#10;Code" FontSize="12" FontWeight="Bold"
                                       LineHeight="12.5" LineStackingStrategy="BlockLineHeight"
                                       Margin="0,-3,0,-3" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DxccCodeText}" HorizontalAlignment="Center" Padding="5,0,5,0"
                                       ToolTip="The ARRL DXCC entity number for this country"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Spans the combined width of the LoTW..Paper QSL header group with one line of text - see
             ConfirmationStripHelper.cs for why an overlay is needed rather than per-column text. Kept
             non-hit-testable so clicks still reach the header underneath (e.g. to sort). -->
        <Border x:Name="ConfirmationStripLabel" IsHitTestVisible="False" Panel.ZIndex="50"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                TextElement.FontSize="16" TextElement.FontWeight="Bold" TextElement.Foreground="#1A1A1A">
            <!-- The letters are created by ConfirmationStripHelper (they are spread apart at runtime to
                 fill the strip's width), and inherit the font settings above. -->
        </Border>

        <!-- AFTER A GROUP DELETE, THE WAY BACK - PUT WHERE THE ROWS WERE. A dozen rows leaving the table
             at once is the most alarming thing this program does, and a delete with no visible way back
             is one the operator will simply not risk. So the undo is not hidden in a menu: it sits over
             the top of the table, in the red of the delete itself, until it is used or waved away.
             Collapsed at every other moment.
             Placed 44px down: BELOW the column headers, never across them. The headers are how the
             operator reads the rows that are left, and a bar over them hides what is being explained. -->
        <!-- The floating red "Deleted N QSOs - Undo" bar that used to sit here is gone. It said the same
             thing as the Undo button on the activity row, at the same moment, in two places at once. -->
        </Grid>

        <ToolsUserControls:MapUserControl x:Name="MapControl" HorizontalAlignment="Stretch" Height="344" Margin="677,0,6,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Border x:Name="MapDisabledPanel" HorizontalAlignment="Stretch" Height="{Binding Height, ElementName=MapControl}" Margin="677,0,6,0" Grid.Row="1" VerticalAlignment="Top" Background="{Binding Fill, ElementName=MainFormBackgroundRect}" Panel.ZIndex="21" Visibility="Collapsed"/>
        <Border HorizontalAlignment="Stretch" Height="344" Margin="677,0,6,0" Grid.Row="1" VerticalAlignment="Top" Background="{Binding Fill, ElementName=MainFormBackgroundRect}" Panel.ZIndex="20" Visibility="Collapsed" x:Name="CustomGraphicsBorder">
            <Image x:Name="Img_CustomGraphics" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
        </Border>
        <Border HorizontalAlignment="Stretch" Height="344" Margin="677,0,6,0" Grid.Row="1" VerticalAlignment="Top" Background="{Binding Fill, ElementName=MainFormBackgroundRect}" Panel.ZIndex="20" Visibility="Collapsed" x:Name="QRZGraphicsBorder">
            <Image x:Name="Img_QRZGraphics" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
        </Border>
        <Border HorizontalAlignment="Stretch" Height="344" Margin="677,0,6,0" Grid.Row="1" VerticalAlignment="Top" Background="#4A90E2" Panel.ZIndex="20" Visibility="Collapsed" x:Name="CompassBorder">
            <Grid>
                <Viewbox Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="100" Height="100">
                        <!-- Compass ring background -->
                        <Ellipse Width="100" Height="100" Canvas.Left="0" Canvas.Top="0" StrokeThickness="2">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#25464a"/>
                            </Ellipse.Stroke>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFFCFC" Offset="0"/>
                                    <GradientStop Color="#DCE4EC" Offset="0.7"/>
                                    <GradientStop Color="#C8D4E0" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Inner compass face -->
                        <Ellipse Width="78" Height="78" Canvas.Left="11" Canvas.Top="11" StrokeThickness="2">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#b9b37e"/>
                            </Ellipse.Stroke>
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#efe6a0"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Cardinal direction markers (N, E, S, W) -->
                        <TextBlock Text="N" FontSize="11" FontWeight="Bold" Foreground="#134346" Canvas.Left="46" Canvas.Top="6" FontFamily="Segoe UI"/>
                        <TextBlock Text="E" FontSize="11" FontWeight="Bold" Foreground="#134346" Canvas.Left="82" Canvas.Top="46" FontFamily="Segoe UI"/>
                        <TextBlock Text="S" FontSize="11" FontWeight="Bold" Foreground="#134346" Canvas.Left="46" Canvas.Top="82" FontFamily="Segoe UI"/>
                        <TextBlock Text="W" FontSize="11" FontWeight="Bold" Foreground="#134346" Canvas.Left="8" Canvas.Top="46" FontFamily="Segoe UI"/>

                        <!-- Compass needle (rotates based on azimuth) -->
                        <Canvas x:Name="CompassNeedle" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="CompassNeedleRotation" Angle="0"/>
                            </Canvas.RenderTransform>
                            <!-- North pointer (red) -->
                            <Polygon Points="50,12 58,50 42,50" StrokeThickness="1.2">
                                <Polygon.Fill>
                                    <SolidColorBrush Color="#d10f20"/>
                                </Polygon.Fill>
                                <Polygon.Stroke>
                                    <SolidColorBrush Color="#7b0d18"/>
                                </Polygon.Stroke>
                            </Polygon>
                            <!-- South pointer (blue/green) -->
                            <Polygon Points="50,88 58,50 42,50" StrokeThickness="1.2">
                                <Polygon.Fill>
                                    <SolidColorBrush Color="#197a74"/>
                                </Polygon.Fill>
                                <Polygon.Stroke>
                                    <SolidColorBrush Color="#0f4e4a"/>
                                </Polygon.Stroke>
                            </Polygon>
                        </Canvas>

                        <!-- Center pivot -->
                        <Ellipse Width="9" Height="9" Canvas.Left="45.5" Canvas.Top="45.5" StrokeThickness="1.2">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#e9e4b9"/>
                            </Ellipse.Fill>
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#6f6a4d"/>
                            </Ellipse.Stroke>
                        </Ellipse>
                    </Canvas>
                </Viewbox>

                <!-- Azimuth text display in top-left corner -->
                <Border Background="White" BorderBrush="#aaa" BorderThickness="1" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0">
                    <TextBlock x:Name="CompassAzimuthText" Text="AZ 0ֲ°" FontSize="16" FontWeight="Bold" Foreground="#18393c" FontFamily="Segoe UI"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock HorizontalAlignment="Left" Margin="11,48,0,0" VerticalAlignment="Top" Grid.Row="1" Width="70" Height="38" FontSize="16" ToolTip="Your Personal Callsign" TextAlignment="Left" LineHeight="14" LineStackingStrategy="BlockLineHeight">
            <Run Text="Operator" FontWeight="Bold" />
            <LineBreak />
            <Run Text="Callsign" />
        </TextBlock>
        <TextBox Text="{Binding Default.Operator, Source={StaticResource Settings}}" x:Name="TB_Operator" HorizontalAlignment="Left" Height="28" Margin="85,47,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" Width="99" CharacterCasing="Upper" Grid.Row="1"  TextChanged="TB_MyCallsign_TextChanged" PreviewKeyDown="PreventSpaceInCallsign" FontSize="16" VerticalContentAlignment="Center" MaxLength="14" TabIndex="2"/>
        <!-- Busy overlay shown while a (potentially large) log is loaded/switched, so the user
             sees that work is happening rather than a frozen window. -->
        <Border x:Name="LogLoadingOverlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"
                Background="#66000000" Panel.ZIndex="1000">
            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="28,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x231B;" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="LogLoadingText" Text="Loading log&#8230;" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Border>

</Window>

