                           HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,8" IsHitTestVisible="False"/>
                <!-- THE SPINNER, DRAWN BY THE PROGRAM RATHER THAN PLAYED FROM A FILE.
                     It was an animated GIF, and an animated GIF is played by Windows: the program can
                     ask it to stop and be ignored, which is exactly what happened - it went on turning
                     over an import that had been stopped, three fixes running. This is a ring and an
                     arc, turned by one animation this program starts and ends itself
                     (MainWindow.SetSpinnerRunning). Stopping it is one line and it can be proved.
                     The faint ring stays put so the arc has something to run around. -->
                <Grid x:Name="UploadProgressSpinner" Width="44" Height="44" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                    <Ellipse Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="{DynamicResource GridLine}" StrokeThickness="4" Opacity="0.5"/>
                    <Canvas Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 22,2 A 20,20 0 0 1 42,22"/>
                        <Canvas.RenderTransform>
