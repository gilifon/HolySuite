        <TextBox x:Name="TB_Band" HorizontalAlignment="Left" Height="28" Margin="419,49,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" Width="58" CharacterCasing="Upper" Grid.Row="1" IsReadOnly="True" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" TextAlignment="Center" HorizontalContentAlignment="Center" TextChanged="TB_Band_TextChanged" TabIndex="6" IsTabStop="False" />
        <!-- The band is normally READ OUT of the frequency, and TB_Band above shows it. With no frequency
             to read it out of (Manual mode, nothing typed) there is nothing to show, so the operator
             picks it instead and this drop-down takes the box's place - same spot, same size, the same
             compact control the Mode box next to it uses.
             Two controls rather than one because TB_Band.Text is the program's answer to "what band are
             we on" - the cluster filters, the dup check, the matrix and the logged QSO all read it. The
             drop-down writes that box; nothing else has to know the band was chosen by hand.
             15px rather than the read-out's 16: of the 58px, the chevron takes 10 and the border and
             margins 5, leaving 43 for text - and the widest bands (70CM, 23CM) measure 43.7 at 16 bold
             against 41.0 at 15. The read-out beside it has no chevron to pay for and stays at 16. -->
        <ComboBox x:Name="CB_Band" HorizontalAlignment="Left" Margin="419,49,0,0" Grid.Row="1"
                  VerticalAlignment="Top" Width="58" Height="28" FontSize="16" FontWeight="Bold"
