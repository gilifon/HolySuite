                        <ImageBrush x:Name="LockMask" ImageSource="Images/lock.png" Stretch="Uniform"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Border>
            </StackPanel>

                <!-- UTC clock, centred over the map (the map spans x=677..right-6 in the row below). -->
                <TextBlock x:Name="L_TitleClock" HorizontalAlignment="Stretch" TextAlignment="Center"
                           Margin="677,0,6,0" VerticalAlignment="Center"
                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="20" IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- Heartbeat button, at the top right corner of the window, past the clock. The clock
                     stretches across this same cell but is centred text and not hit-testable, so the two
                     do not fight over the space or over the click. -->
                <Button x:Name="ShareStatusButton" Width="24" Height="24" Padding="0" Margin="0,0,8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#4CAF50" BorderBrush="#2E7D32" BorderThickness="1"
                        ToolTipService.Placement="Left" Visibility="Visible" Cursor="Hand" Click="ShareStatusButton_Click">
                    <Button.ToolTip>
                        <TextBlock TextAlignment="Center">
                            <Run Text="Send heartbeat to"/>
                            <LineBreak/>
                            <Run Text="HolyLogger On The Air"/>
                        </TextBlock>
                    </Button.ToolTip>
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#303030" StrokeThickness="2" Fill="Transparent" Data="M7,12 L16,7 M7,12 L16,17"/>
                            <Ellipse Canvas.Left="3.5" Canvas.Top="8.5" Width="7" Height="7" Stroke="#303030" StrokeThickness="2" Fill="Transparent"/>
                            <Ellipse Canvas.Left="14.5" Canvas.Top="3.5" Width="7" Height="7" Stroke="#303030" StrokeThickness="2" Fill="Transparent"/>
                            <Ellipse Canvas.Left="14.5" Canvas.Top="13.5" Width="7" Height="7" Stroke="#303030" StrokeThickness="2" Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </DockPanel>
        <DockPanel Grid.Row="4">
            <StatusBar DockPanel.Dock="Bottom" MouseDoubleClick="StatusBar_MouseDoubleClick" Background="{DynamicResource WindowBg}">
                <StatusBar.Resources>
                    <!-- Status-bar label text follows the theme; colored value texts set their own Foreground and keep it. -->
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    </Style>
                </StatusBar.Resources>
                <StatusBarItem x:Name="NetworkFlagItem">
                    <Ellipse x:Name="NetworkFlag" Margin="5,0,0,0" Fill="#00FF00" Height="16" Stroke="Black" Width="16" Visibility="Visible" ToolTip="Network conectivity" />
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock x:Name="L_QSO_Label" Text="QSOs: " Margin="10,0,0,0" FontSize="16"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock x:Name="L_numOfQSO" Text="{Binding NumOfQSOs, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}"  Margin="0,0,0,0" FontSize="16"/>
                </StatusBarItem>
                <StatusBarItem>
                    <!-- Two-line "Holyland Squares" label. Width 56 + left margin 4 = the same 60px
                         footprint as the old "Grids: " (40.1px + 20px), so the number does not move.
                         Left-aligned (both lines share the same left edge) + vertically centered so it
                         is symmetric with the number, leaving room for up to a 3-digit count. -->
                    <!-- Font 14, not 16: "Holyland" needs 64px at 16 and this block is 56 wide, so 16
                         cut the word off. The three two-line status-bar labels below share the reason. -->
                    <TextBlock Margin="4,0,0,0" FontSize="14" Width="56" TextAlignment="Left"
                               VerticalAlignment="Center" LineHeight="15" LineStackingStrategy="BlockLineHeight"><Run Text="Holyland"/><LineBreak/><Run Text="Squares"/></TextBlock>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock x:Name="L_numOfGrids" Text="{Binding NumOfGrids, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}"  Margin="0,0,0,0" FontSize="16"/>
                </StatusBarItem>
                <StatusBarItem>
                    <!-- Two-line "DXCCs (active)" label, laid out like the Holyland Squares one above:
                         left-aligned lines, vertically centered, so the count beside it stays on the
                         status bar's mid-line instead of riding up against the first line.
                         "(active)" rather than "(worked)": the count has always excluded deleted
                         entities - it is filtered to the official current list, the same 340 the
                         Statistics window measures against - and the old word did not say so. -->
                    <TextBlock Margin="10,0,0,0" FontSize="14" TextAlignment="Left"
                               VerticalAlignment="Center" LineHeight="15" LineStackingStrategy="BlockLineHeight"><Run Text="DXCCs"/><LineBreak/><Run Text="(active)"/></TextBlock>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock x:Name="L_numOfDXCC" Text="{Binding NumOfDXCCs, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}"  Margin="4,0,0,0" FontSize="16" VerticalAlignment="Center"/>
                </StatusBarItem>
                <StatusBarItem>
                    <StatusBarItem.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reset" Click="ResetRecentQSOCounterMenuItem_Click">
                                <MenuItem.Icon>
                                    <Image Source="Images/timer.png" Stretch="UniformToFill" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </StatusBarItem.ContextMenu>
                    <TextBlock Margin="10,0,2,0" FontSize="14" LineHeight="15" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" TextAlignment="Left"><Run Text="Recent"/><LineBreak/><Run Text="QSOs:"/></TextBlock>
                </StatusBarItem>
                <StatusBarItem>
                    <StatusBarItem.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reset" Click="ResetRecentQSOCounterMenuItem_Click">
                                <MenuItem.Icon>
                                    <Image Source="Images/timer.png" Stretch="UniformToFill" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </StatusBarItem.ContextMenu>
                    <TextBlock x:Name="L_QSOCounter" Text="{Binding Default.RecentQSOCounter, Source={StaticResource Settings}}" Margin="0,0,0,0" FontSize="16" VerticalAlignment="Center"/>
                </StatusBarItem>
                <!-- Frequency source: at the end of the counters, because the counts belong together and
                     this is a setting rather than another number to read.

                     Label and toggle live in ONE framed box: they are a single question ("where does the
                     frequency come from?") and its answer, and side by side on a busy status bar without
                     a frame they read as two unrelated items. "from:" is gone - the frame says the toggle
                     belongs to the label, so the word had nothing left to do.

                     Two named choices rather than one switch: an on/off switch labelled "Manual Mode"
                     only ever names ONE of the two states, so "off" left the operator guessing what
                     the program was actually doing. Both states are now spelled out.
                     RB_CatMode is greyed out by UpdateFreqModeRadios when CAT is unavailable, since
                     the frequency cannot come from the radio then.
                     Click, not Checked: with CAT unavailable the display already shows Manual, so a
                     click on it is no transition and raises no Checked - which left the operator
                     unable to actually CHOOSE Manual (and with it the band picker). Click fires on every
                     press, checked or not.

                     This toggle governs the FREQUENCY AND MODE only. It used to freeze the date and time
                     as well; holding those still is getting a switch of its own. -->
                <StatusBarItem>
                    <StatusBarItem.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Change mode" Click="ManualModeMenuItem_Click">
                                <MenuItem.Icon>
                                    <Image Source="Images/manual.png" Stretch="UniformToFill" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </StatusBarItem.ContextMenu>
                    <!-- Blue frame: the accent colour, so the group is picked out from the plain text and
                         counts around it and follows the theme (it lightens on the dark schemes). -->
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                            Margin="12,0,0,0" Padding="7,3" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Freq &amp; Mode" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- The toggle keeps its own hairline frame: it is the control, the outer box
                                 is only the grouping. -->
                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RB_CatMode" GroupName="FreqMode" Content="CAT"
                                                 Style="{StaticResource FreqSegLeft}" Click="FreqMode_Click"
                                                 ToolTip="The frequency and mode are read from the radio over CAT."/>
                                    <!-- Hairline between the halves, so the pill still reads as two choices
                                         when neither is being hovered. -->
                                    <Rectangle Width="1" Fill="{DynamicResource ThemeBorderBrush}"/>
                                    <RadioButton x:Name="RB_ManualMode" GroupName="FreqMode" Content="Manual"
                                                 Style="{StaticResource FreqSegRight}" Click="FreqMode_Click"
                                                 ToolTip="You type the frequency and pick the mode yourself."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StatusBarItem>
                <!-- The QSO's date and time: do they follow the UTC clock, or stand where you set them?
                     Built like the frequency group beside it - same framed label + two-segment toggle - so
                     the two read as the same kind of choice. The frame is RED because Manual here means
                     the date and time on screen are NOT the time now, which is worth noticing at a glance
                     when you look up mid-contact.

                     This is the switch that used to be part of Manual Mode. It is its own now: where the
                     frequency comes from and whether the clock runs are two unrelated questions, and
                     answering one by answering the other surprised people. -->
                <StatusBarItem>
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Danger}"
                            Margin="10,0,0,0" Padding="7,3" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Time" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RB_TimeManual" GroupName="TimeMode" Content="Manual"
                                                 Style="{StaticResource FreqSegLeft}" Click="TimeMode_Click"
                                                 ToolTip="The QSO's date and time stay exactly as you set them, so you can log a contact that happened earlier."/>
                                    <Rectangle Width="1" Fill="{DynamicResource ThemeBorderBrush}"/>
                                    <RadioButton x:Name="RB_TimeAuto" GroupName="TimeMode" Content="Auto"
                                                 Style="{StaticResource FreqSegRight}" Click="TimeMode_Click"
                                                 ToolTip="The QSO's date and time follow the UTC clock."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StatusBarItem>
                <StatusBarItem>
                    <!-- Contest indicator: PASSIVE, display-only. Visible only while a contest log is
                         active (gold trophy + contest name); completely hidden otherwise. Entering or
                         leaving a contest happens in exactly one place: File > Log Manager. -->
                    <StackPanel x:Name="ContestIndicatorPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Border x:Name="ContestIndicator" Width="26" Height="24" Margin="5,0,0,0" CornerRadius="4" Background="Transparent">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="ContestIndicatorPath" Stretch="Uniform" Width="24" Height="24"
                                  Data="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z"
                                  Fill="#9E9E9E"/>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="L_ContestName" VerticalAlignment="Center" Margin="7,0,0,0"
                               MaxWidth="150" TextWrapping="Wrap" FontSize="16" LineHeight="14"
                               LineStackingStrategy="BlockLineHeight"
                               FontWeight="Bold" Foreground="{DynamicResource ContestNameBrush}"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <!--<TextBlock Text="Omni-Rig: " FontSize="16"/>-->
                        <TextBlock x:Name="RigLabel" Text="RIG1" FontWeight="Normal" FontSize="16" Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Cursor="Hand" MouseLeftButtonUp="RigLabel_MouseLeftButtonUp"
                                   ToolTip="Open Tools → Options"/>
                        <Label x:Name="L_OmniRig" Content="{Binding Status, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}" Margin="0,0,20,0" FontSize="16" />
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </DockPanel>


        <!-- Runs all the way down to the X-array's own fill, which starts at 295 and overlaps it by 2px.
             At 284 it stopped short and a band of window background showed straight across the form,
             which read as a grey line under the activity row. -->
        <Rectangle x:Name="MainFormBackgroundRect" Grid.Row="1" Fill="{DynamicResource FormBg}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="677" Height="297" />
        <!-- Blue frame around the entry form INCLUDING the X-array, matching the log-table frame
             (#1565C0, thickness 3). Fixed blue so it shows in light and dark mode. It spans the full form
             row and has NO bottom border: the left/right sides run down to the log table, whose own top
             frame closes the bottom (so there is no separate horizontal low rim). Width 680 places the
             right side exactly on the map's left frame so the two read as a single vertical line. High
             ZIndex so the sides draw over the X-array strip. Excluded from the contest shift (RowShift). -->
        <Border x:Name="FormFrame" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="680" Height="344" BorderBrush="#1565C0" BorderThickness="3,3,3,0"
                Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="30"/>
        <TextBlock HorizontalAlignment="Left" Margin="11,12,0,0" VerticalAlignment="Top" Grid.Row="1" Width="56" Height="38" FontSize="16" ToolTip="Callsign used on the air" TextAlignment="Left" LineHeight="14" LineStackingStrategy="BlockLineHeight">
            <Run Text="Station" FontWeight="Bold" />
            <LineBreak />
            <Run Text="Callsign" />
        </TextBlock>
        <TextBox x:Name="TB_MyCallsign" HorizontalAlignment="Left" Height="28" Margin="71,11,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" Width="113" CharacterCasing="Upper" Grid.Row="1" Text="{Binding Default.my_callsign, Source={StaticResource Settings}}" TextChanged="TB_MyCallsign_TextChanged" GotFocus="TB_MyCallsign_GotFocus" LostFocus="TB_MyCallsign_LostFocus" PreviewKeyDown="PreventSpaceInCallsign" FontSize="16" MaxLength="14" BorderBrush="#FFABADB3" TabIndex="1"/>
        <!-- Shown OVER THE DX CALLSIGN box when the current station callsign has no log set for it (the
             active log's identity is a different callsign). It masks the DX box and blocks typing a DX
             callsign, so a QSO can't be started until a log is set for the current station callsign;
             click it to open the Log Manager and open/create a log for that callsign. The station
             callsign box itself stays editable. Kept exactly over TB_DXCallsign (same Grid.Row / margin
             / size). -->
        <Border x:Name="CallsignLockOverlay" Grid.Row="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Height="28" Width="130" Margin="101,87,0,0"
                Background="#FFF3CD" BorderBrush="Red" BorderThickness="1"
                Visibility="Collapsed" Panel.ZIndex="60" Cursor="Hand"
                MouseLeftButtonDown="CallsignLockOverlay_MouseDown"
                ToolTip="No log is set for your current station callsign. Click to open the Log Manager and open or create a log for it before logging QSOs.">
            <!-- Named: the caption changes with the reason - "Select Log" when this callsign has no
                 log of its own, "No log" when nothing is open at all. -->
            <TextBlock x:Name="CallsignLockText" Text="Select Log" Foreground="Red" FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="192,45,0,0" Grid.Row="1">
            <!-- Both LED and no-CAT borders share one Grid so the kHz label never shifts.
                 Width is the single fixed constraint — content never drives the layout width. -->
            <Grid VerticalAlignment="Center" Width="160">
                <Border x:Name="FreqLedBezel" Margin="0,1,2,1"
                        Background="#080808" CornerRadius="4" BorderBrush="#3A3A3A" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonUp="FreqLed_MouseLeftButtonUp"
                        ToolTip="Working frequency in kHz — click to edit">
                    <Grid Margin="4,1,4,2">
                        <TextBlock x:Name="FreqLedGhost" FontFamily="./Fonts/#DSEG7 Classic" FontWeight="Bold"
                                   FontSize="18" VerticalAlignment="Center" Foreground="#1E1500"
                                   TextAlignment="Right"/>
                        <TextBlock x:Name="FreqLedLive" FontFamily="./Fonts/#DSEG7 Classic" FontWeight="Bold"
                                   FontSize="18" VerticalAlignment="Center" TextAlignment="Right"/>
                        <TextBox x:Name="TB_FreqLedEdit" Visibility="Collapsed" MinWidth="175"
                                 FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                 Background="#080808" Foreground="#FFB000" BorderThickness="0" Padding="0"
                                 CaretBrush="#FFB000" SelectionBrush="#664400"
                                 VerticalContentAlignment="Center"
                                 KeyDown="TB_FreqLedEdit_KeyDown" LostFocus="TB_FreqLedEdit_LostFocus"/>
                    </Grid>
                </Border>
                <Border x:Name="FreqNoCatBezel" Margin="0,1,2,1"
                        Background="White" CornerRadius="4" BorderBrush="#D32F2F" BorderThickness="2"
                        Visibility="Hidden" HorizontalAlignment="Stretch">
                    <TextBox x:Name="TB_FreqNoCat" Padding="4,0"
                             FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                             Background="White" Foreground="Black" CaretBrush="Black" BorderThickness="0"
                             TextAlignment="Right" MaxLength="11"
                             VerticalContentAlignment="Center"
                             KeyDown="TB_FreqNoCat_KeyDown" LostFocus="TB_FreqNoCat_LostFocus"
                             GotFocus="TB_FreqNoCat_GotFocus" TextChanged="TB_FreqNoCat_TextChanged"/>
                </Border>
            </Grid>
            <TextBlock Text="kHz" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource KHzText}"
                       VerticalAlignment="Bottom" Margin="0,0,0,-2"/>
