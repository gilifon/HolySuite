<Window

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
        xmlns:xcdg="http://schemas.xceed.com/wpf/xaml/datagrid"
        xmlns:local="clr-namespace:HolyLogger"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:ToolsUserControls="clr-namespace:HolyLogger.ToolsUserControls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="HolyLogger.MainWindow"
        Title="HolyLogger"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="MainWindow_StateChanged"
        MinHeight="560" MinWidth="800"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown" Closing="Window_Closing" Closed="Window_Closed" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <!-- Custom-drawn title bar (below) replaces the OS caption so the white frame can wrap the
             whole window, including the title bar. CaptionHeight matches CustomTitleBar's height so
             drag-to-move / double-click-to-maximize / Aero snap keep working exactly as before;
             GlassFrameThickness=0 + ResizeBorderThickness keep normal edge-resizing and correct
             maximize sizing (the window no longer overlaps the taskbar when maximized). -->
        <shell:WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0"
                             ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:QsoDateDisplayConverter x:Key="QsoDateDisplayConverter"/>
        <local:QsoTimeDisplayConverter x:Key="QsoTimeDisplayConverter"/>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <local:BandColorConverter x:Key="BandColorConverter"/>
        <local:LotwUserConverter x:Key="LotwUserConverter"/>

        <!-- Theme control styles (Label/TextBox/Menu/DataGrid/Window, etc.) now live app-wide in
             Themes/Controls.xaml, merged in App.xaml, so every window is themed consistently. -->

        <!-- The compact drop-down used by Mode and by Band. The whole box is the button, with a slim
             chevron rather than the standard 17px arrow column: this row of the form has about 24px of
             free space left in it altogether, and two standard arrows need 34. A 10px chevron on each
             box fits, and without one there was nothing at rest to say these boxes open at all.
             Shared by both boxes so the two can never drift into looking like different controls. -->
        <ControlTemplate x:Key="FlatComboTemplate" TargetType="ComboBox">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.ColumnSpan="2"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                              Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                <!-- Drawn, not a glyph: a Path is the same crisp triangle in every font and at every DPI,
                     and it takes the theme's text colour like the value beside it. Never takes the
                     click - the ToggleButton underneath spans the whole box. -->
                <Path Grid.Column="1" Data="M 0,0 L 8,0 L 4,4.5 Z" Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,2,0"
                      IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom">
                    <Border BorderBrush="#0078D7" BorderThickness="1" Background="{DynamicResource MenuBg}" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                        <ScrollViewer>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <!-- The same compact box, but you can TYPE in it: used by RST S and RST R, which offer the
             usual reports on the chevron and still take anything typed over them. The only change from
             FlatComboTemplate is that the ContentPresenter is replaced by the TextBox WPF requires,
             which MUST be called PART_EditableTextBox for the ComboBox to find it.
             Transparent, with no border of its own: the box's own Background and BorderBrush then show
             through exactly as they do on a plain TextBox, which is what lets the edit-mode tint and the
             red "this field is empty" frame keep working. Both are set here as local values because the
             app-wide TextBox style would otherwise paint it opaque and draw a second frame inside. -->
        <ControlTemplate x:Key="FlatEditableComboTemplate" TargetType="ComboBox">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.ColumnSpan="2"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                              Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                         Background="Transparent" BorderThickness="0" Padding="3,0,0,0"
                         Foreground="{TemplateBinding Foreground}"
                         CaretBrush="{TemplateBinding Foreground}"
                         HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                         VerticalAlignment="Center"/>
                <Path Grid.Column="1" Data="M 0,0 L 8,0 L 4,4.5 Z" Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,2,0"
                      IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom">
                    <Border BorderBrush="#0078D7" BorderThickness="1" Background="{DynamicResource MenuBg}" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                        <ScrollViewer>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <!-- The same box with nothing to open: what RST S and RST R wear on CW and the data modes, where
             the report is always 599 and a list of nine would only be in the way. Kept as a template of
             its own rather than by hiding the chevron, so the text gets the full width of the box back. -->
        <ControlTemplate x:Key="FlatTypeOnlyComboTemplate" TargetType="ComboBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <TextBox x:Name="PART_EditableTextBox"
                         Background="Transparent" BorderThickness="0" Padding="3,0,0,0"
                         Foreground="{TemplateBinding Foreground}"
                         CaretBrush="{TemplateBinding Foreground}"
                         HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="RaisedActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1E2A34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#7A95A8"/>
            <Setter Property="Background" Value="#E8F2FA"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F7FBFF" Offset="0"/>
                                    <GradientStop Color="#DCEAF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35" Color="#6A8296"/>
                            </Border.Effect>
                            <ContentPresenter x:Name="ContentHost"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1F5C8E"/>
                                <Setter TargetName="ButtonBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4D9AD8" Offset="0"/>
                                            <GradientStop Color="#2E76B4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#486A86"/>
                                <Setter TargetName="ButtonBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C9DCEF" Offset="0"/>
                                            <GradientStop Color="#B5CEE5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ButtonBorder" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="ContentHost" Property="Margin" Value="0,1,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                                <Setter Property="Foreground" Value="#8797A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E6CCFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RoundedButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#9966CC"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RoundedButtonBorder" Property="Background" Value="#CFA6FF"/>
                                <Setter TargetName="RoundedButtonBorder" Property="BorderBrush" Value="#7A33CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RoundedButtonBorder" Property="Background" Value="#B980F5"/>
                                <Setter TargetName="RoundedButtonBorder" Property="BorderBrush" Value="#5E1FA8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RoundedButtonBorder" Property="Background" Value="#E4E4E4"/>
                                <Setter TargetName="RoundedButtonBorder" Property="BorderBrush" Value="#B5B5B5"/>
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Msg button style: same keyboard-key shape as cluster band filter buttons, purple when CAT OK / gray when disabled -->
        <Style x:Key="MsgButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E6CCFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Outer border: darker bottom edge like a physical key -->
                        <Border x:Name="KeyOuter" CornerRadius="5" Background="#7A33CC" SnapsToDevicePixels="True" Padding="0,0,0,3">
                            <!-- Inner face with gradient -->
                            <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#9966CC" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyOuter" Property="Background" Value="#5E1FA8"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#CFA6FF"/>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#7A33CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                                <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#B980F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Msg button style for CW mode: cyan keyboard-key shape with 3D effect, matching SSB style -->
        <Style x:Key="MsgButtonCwStyle" TargetType="Button">
            <Setter Property="Background" Value="#7FFEFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Outer border: darker bottom edge like a physical key -->
                        <Border x:Name="KeyOuter" CornerRadius="5" Background="#0099CC" SnapsToDevicePixels="True" Padding="0,0,0,3">
                            <!-- Inner face -->
                            <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#00CCFF" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyOuter" Property="Background" Value="#005C80"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#33C2D6"/>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#0077AA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                                <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#1FA6BC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Action button style: same keyboard-key shape, light blue for Add/Clear -->
        <!-- DangerActionButtonStyle - the red keycap the Undo buttons wear - lives in
             Themes/Controls.xaml, because the Log Workshop needs it too and a window's own resources
             are not visible to any other window. -->

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CCE8FF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyOuter" CornerRadius="5" Background="#3A80C8" SnapsToDevicePixels="True" Padding="0,0,0,3">
                            <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#5599DD" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyOuter" Property="Background" Value="#1F5C8E"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#A8D8FF"/>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#3A80C8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                                <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#7DC0F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                                <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpotButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1E2A34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyOuter" CornerRadius="5" Background="#C9A800" SnapsToDevicePixels="True">
                            <Border x:Name="KeyFace" CornerRadius="4,4,3,3" BorderThickness="1" BorderBrush="#E0C94A" Margin="0,0,0,3" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFF9C4" Offset="0"/>
                                        <GradientStop Color="#FFEB3B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#1F5C8E"/>
                                <Setter TargetName="KeyOuter" Property="Background" Value="#1860B0"/>
                                <Setter TargetName="KeyFace" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4D9AD8" Offset="0"/>
                                            <GradientStop Color="#2E76B4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,1"/>
                                <Setter TargetName="KeyOuter" Property="Background" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KeyOuter" Property="Opacity" Value="0.55"/>
                                <Setter Property="Foreground" Value="#8797A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The status bar's "Freq & Mode from:" choice, drawn as one two-segment pill instead of two
             radio dots: the chosen half is filled, so which one is live reads at a glance from across
             the room. They are still RadioButtons in the same GroupName, so FreqMode_Click and
             UpdateFreqModeRadios drive them exactly as before.

             FontWeight is deliberately NOT touched here: UpdateFreqModeRadios uses bold on Manual to
             say it was CHOSEN rather than merely displayed for want of a radio, and a trigger setting
             it would erase that distinction. Nor is there an IsEnabled trigger - the same method
             already dims unavailable CAT with Opacity. -->
        <Style x:Key="FreqSegLeft" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Seg" CornerRadius="3,0,0,3" Background="Transparent"
                                Padding="9,3" SnapsToDevicePixels="True">
                            <!-- The hidden bold twin is what gives this segment its width. Sized to the
                                 visible text alone, the segment grew when UpdateFreqModeRadios bolded the
                                 chosen Manual, and the whole status bar to its right jumped sideways on
                                 every toggle. Reserving the bold width up front keeps each segment as
                                 narrow as its own word - a fixed MinWidth for all four left CAT and Auto
                                 swimming in empty space. -->
                            <Grid>
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="Bold" Visibility="Hidden"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Identical to FreqSegLeft but rounded on the other end - the corner radius lives inside the
             template, so the two halves cannot share one. -->
        <Style x:Key="FreqSegRight" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Seg" CornerRadius="0,3,3,0" Background="Transparent"
                                Padding="9,3" SnapsToDevicePixels="True">
                            <!-- See FreqSegLeft: the hidden bold twin reserves the width so bolding the
                                 label cannot resize the segment. -->
                            <Grid>
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="Bold" Visibility="Hidden"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- White frame around the whole window (title bar included). Wrapping Content in a Border is
         safe now: the one place that used to cast this.Content directly to Grid was fixed to use
         AddLogGrid instead (see the constructor). AddLogGrid's old Margin="2,0,-2,0" (a legacy shim
         for the native window border that WindowStyle="None" removed) let it overflow 2px past the
         Border's right edge; rows with a full-bleed Background (the title bar, the status bar) then
         painted over the frame there, breaking it top and bottom, while the middle rows, with no
         edge-to-edge fill, still showed it. Margin is now 0 so nothing overflows. -->
    <Border BorderBrush="White" BorderThickness="2" CornerRadius="8">
    <Grid x:Name="AddLogGrid" ShowGridLines="false" Margin="0" TextElement.Foreground="{DynamicResource TextBrush}"
          SizeChanged="AddLogGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition x:Name="MainForm" Height="344" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <DockPanel x:Name="MainScreen" Grid.Row="0">
            <!-- Custom title bar: replaces the OS caption (WindowStyle="None" above) so the white
                 frame border (bottom of this file) can wrap the whole window including the title bar.
                 Height must match shell:WindowChrome.CaptionHeight for drag/snap/double-click-maximize
                 to line up. Only the 3 buttons opt out of the draggable "caption" area. -->
            <Border x:Name="CustomTitleBar" DockPanel.Dock="Top" Height="32" Background="{DynamicResource TitleBarBg}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TitleBar_MinimizeBtn" Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="TitleBar_MaxRestoreBtn" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_MaxRestore_Click" ToolTip="Maximize"/>
                        <Button x:Name="TitleBar_CloseBtn" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_Close_Click" ToolTip="Close"/>
                    </StackPanel>
                    <Image Source="Images/crown.png" Width="16" Height="16" Margin="10,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextBrush}"
                               DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Run Text="{Binding TitlePrefix, Mode=OneWay}"/><Run Text="{Binding TitleLogLabel, Mode=OneWay}" FontWeight="Bold"/><Run Text="{Binding TitleLogName, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- "Copying is live" indicator: shown right after the log name when the active log copies
                         its new QSOs into another log. Click to stop. -->
                    <StackPanel x:Name="CopyLivePanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding CopyDotVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                PreviewMouseLeftButtonUp="CopyLiveDot_Click">
                        <Ellipse Width="12" Height="12" Fill="#E00000" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CopyTargetTooltip, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#E00000"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid DockPanel.Dock="Top">
            <!-- Menu bar and the callsign lock share one left-aligned row, so the lock sits immediately
                 past "Help" whatever the menu measures - it belongs with the station identity it guards,
                 not among the status bar's counters where it used to live. -->
