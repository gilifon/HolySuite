        <Border x:Name="UploadProgressBox" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Panel.ZIndex="50" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8" Padding="20,14,20,14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
