<Window x:Class="HolyLogger.NewLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log name" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Prompt" Grid.Row="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap" Text="Enter a name for the log:"/>
        <TextBox x:Name="TB_Name" Grid.Row="1" Margin="0,10,0,0" FontSize="16" Padding="5,4"/>

        <!-- Optional copy-to-log section (shown only when creating a log, not for Rename). -->
        <StackPanel x:Name="CopyOptionsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,0">
            <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

            <TextBlock Text="This log's identity (permanent)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Station callsign" VerticalAlignment="Center" FontSize="16"/>
                <TextBox x:Name="TB_Callsign" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" FontSize="16" Padding="4,3"
                         IsReadOnly="True" IsTabStop="False" Background="#EEEEEE" Foreground="#555555"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Operator" VerticalAlignment="Center" FontSize="16"/>
                <TextBox x:Name="TB_Operator" Grid.Row="1" Grid.Column="1" FontSize="16" Padding="4,3"
                         IsReadOnly="True" IsTabStop="False" Background="#EEEEEE" Foreground="#555555"/>
            </Grid>

            <TextBlock Text="Copy new QSOs into:" FontSize="16" Margin="0,14,0,4"/>
            <ComboBox x:Name="CB_CopyTarget" FontSize="16" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="#777777" Margin="0,6,0,0"
                       Text="The identity comes from the main window (Station callsign / Operator) and is permanent for this log. Each QSO you log here with that identity is copied into the chosen log; deleting a QSO here also removes its copy there."/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Btn_Cancel" Content="Cancel" Width="100" Height="32" FontSize="16" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="Btn_Ok" Content="OK" Width="100" Height="32" FontSize="16" FontWeight="Bold"
                    IsDefault="True" Click="Btn_Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
