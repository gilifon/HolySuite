<UserControl x:Class="HolyLogger.OptionsUserControls.GeneralSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HolyLogger.OptionsUserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="380">
    <Grid ShowGridLines="false" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <CheckBox x:Name="CBX_IsFilterGrid" Content="Filter QSOs table by DX callsign" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.IsFilterQSOs, Source={StaticResource Settings}, Mode=TwoWay}" FontSize="16"/>
        <CheckBox x:Name="CBX_IsAllowLiveLog" Content="Allow automatic upload during special events" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.isAllowLiveLog, Source={StaticResource Settings}, Mode=TwoWay}" Margin="0,26,0,0" FontSize="16"/>
        <CheckBox x:Name="CBX_ShowOnTheAir" Content="Send heartbeat to HolyLogger On The Air" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.ShowOnTheAir, Source={StaticResource Settings}, Mode=TwoWay}" Margin="0,51,0,0" FontSize="16"/>
        <CheckBox x:Name="CBX_CallsignSyncVerboseLog" Content="Verbose callsign sync log" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.CallsignSyncVerboseLog, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,76,0,0"/>

        <CheckBox x:Name="CBX_EnableOmniRigCAT" Content="Enable Omni-Rig CAT" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableOmniRigCAT, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,101,0,0" Click="CBX_EnableOmniRigCAT_Changed"/>

        <!-- Left edge lines up with the word "Enable" (checkbox text starts after the ~20px glyph).
             Narrow: a rig name is short (~15 chars), so ~half the old width is plenty. -->
        <GroupBox x:Name="groupBox" Header="Select Rig" Height="90" Margin="20,126,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="180" FontSize="16">
            <StackPanel>
                <RadioButton x:Name="Rig1_RB" HorizontalAlignment="Left" Margin="0,8,0,0" VerticalAlignment="Top" Content="1: Rig Number 1"  Click="HasChanged_Click" IsChecked="{Binding Default.SelectedOmniRig1, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
                <RadioButton x:Name="Rig2_RB" HorizontalAlignment="Left" Margin="0,8,0,0" VerticalAlignment="Top" Content="2: Rig Number 2" Click="HasChanged_Click" IsChecked="{Binding Default.SelectedOmniRig2, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="CBX_EnableUDPClient" Content="Enable UDP Client" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableUDPClient, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,230,0,0" Click="HasChanged_Click"/>
        <Label x:Name="label" Content="Port" HorizontalAlignment="Left" Margin="199,224,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="textBox" HorizontalAlignment="Left" Height="23" Margin="243,228,0,0" TextWrapping="Wrap" Text="{Binding Default.UDPPort, Mode=TwoWay, Source={StaticResource Settings}}" VerticalAlignment="Top" Width="112" FontSize="16" PreviewTextInput="PreviewTextInputHandler" DataObject.Pasting="PastingHandler" MaxLength="5" />

        <CheckBox x:Name="CBX_EnableN1MMUDPClient" Content="N1MM+ UDP Client" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableN1MMUDPClient, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,255,0,0" Click="HasChanged_Click"/>
        <Label x:Name="label2" Content="Port" HorizontalAlignment="Left" Margin="199,249,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="textBox2" HorizontalAlignment="Left" Height="23" Margin="243,254,0,0" TextWrapping="Wrap" Text="{Binding Default.N1MMUDPPort, Mode=TwoWay, Source={StaticResource Settings}}" VerticalAlignment="Top" Width="112" FontSize="16" PreviewTextInput="PreviewTextInputHandler" DataObject.Pasting="PastingHandler" MaxLength="5" />

        <!-- HolyCluster spot listener: catches the WSJT-X-format UDP datagram HolyCluster sends when
             you select a spot (the same one it sends to Log4OM) and fills the DX callsign. -->
        <GroupBox Header="HolyCluster" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,285,0,0" Width="580" FontSize="16">
            <StackPanel Margin="4,4,4,4">
                <CheckBox x:Name="CBX_EnableHolyClusterUDP" Content="Fill DX callsign from HolyCluster spots" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableHolyClusterUDP, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Click="HasChanged_Click"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Port" VerticalAlignment="Center" FontSize="16" Padding="0"/>
                    <TextBox x:Name="TB_HolyClusterUDPPort" Width="80" Height="23" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Default.HolyClusterUDPPort, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" PreviewTextInput="PreviewTextInputHandler" DataObject.Pasting="PastingHandler" MaxLength="5"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="Gray"
                           Text="Set this to the UDP port HolyCluster sends on (its default is 2237). When you select a station in HolyCluster it sends the callsign here and it is placed in the DX Callsign field. If CAT is not connected, the spot's frequency is filled in too."/>
            </StackPanel>
        </GroupBox>

        <!-- Audio Alerts: both sound options plus a single shared output-device picker, so alerts can
             go to the speakers instead of a USB radio codec. Left-justified with the checkboxes. -->
        <GroupBox Header="Audio Alerts" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,435,0,0" Width="580" FontSize="16">
            <StackPanel Margin="4,4,4,4">
                <!-- Beep when typing -->
                <CheckBox x:Name="CBX_NonEnglishKeyBeep" HorizontalAlignment="Left" IsChecked="{Binding Default.NonEnglishKeyBeep, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,2,0,0" Click="HasChanged_Click">
                    <StackPanel Orientation="Horizontal">
                        <!-- Fixed label width shared with the sound-alert row below, so the two Test buttons align. -->
                        <TextBlock Text="Beep when typing in a non-English keyboard" VerticalAlignment="Center" Width="315"/>
                        <Button x:Name="BTN_TestBeep" Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,2"
                                FontSize="12" Cursor="Hand" Click="BTN_TestBeep_Click"
                                ToolTip="Click to test — plays the beep on the selected audio device">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#3B6EA5" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Test" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </CheckBox>

                <!-- Sound alert on a new-country cluster spot -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="CBX_NewCountrySound" VerticalAlignment="Center" IsChecked="{Binding Default.ClusterNewCountrySoundOn, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Click="HasChanged_Click">
                        <TextBlock Text="Sound alert on a new-country cluster spot" VerticalAlignment="Center" Width="315"/>
                    </CheckBox>
                    <Button x:Name="BTN_TestNewCountrySound" Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,2"
                            FontSize="12" Cursor="Hand" Click="BTN_TestNewCountrySound_Click"
                            IsEnabled="{Binding ElementName=CBX_NewCountrySound, Path=IsChecked}"
                            ToolTip="Click to test — plays the selected alert sound on the selected audio device">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#3B6EA5" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Test" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="CB_NewCountrySound" Margin="8,0,0,0" Width="130" VerticalAlignment="Center" FontSize="14"
                              IsEnabled="{Binding ElementName=CBX_NewCountrySound, Path=IsChecked}" SelectionChanged="CB_NewCountrySound_SelectionChanged"/>
                </StackPanel>

                <!-- Sound alert on a new Unconfirmed cluster spot (worked but not confirmed on LoTW) -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="CBX_UnconfirmedSound" VerticalAlignment="Center" IsChecked="{Binding Default.ClusterUnconfirmedSoundOn, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Click="HasChanged_Click">
                        <TextBlock Text="Sound alert on a new Unconfirmed cluster spot" VerticalAlignment="Center" Width="315"/>
                    </CheckBox>
                    <Button x:Name="BTN_TestUnconfirmedSound" Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,2"
                            FontSize="12" Cursor="Hand" Click="BTN_TestUnconfirmedSound_Click"
                            IsEnabled="{Binding ElementName=CBX_UnconfirmedSound, Path=IsChecked}"
                            ToolTip="Click to test — plays the selected alert sound on the selected audio device">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#3B6EA5" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Test" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="CB_UnconfirmedSound" Margin="8,0,0,0" Width="130" VerticalAlignment="Center" FontSize="14"
                              IsEnabled="{Binding ElementName=CBX_UnconfirmedSound, Path=IsChecked}" SelectionChanged="CB_UnconfirmedSound_SelectionChanged"/>
                </StackPanel>

                <!-- Shared output device for BOTH sounds above. Fixed label width + combo width so the
                     combo's right edge lines up under the word "spot" on the sound-alert row above. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
                    <TextBlock Text="Select audio device:" Width="150" VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CB_SoundDevice" Width="175" VerticalAlignment="Center" FontSize="14"
                              SelectionChanged="CB_SoundDevice_SelectionChanged"
                              ToolTip="Output device for the alert sounds above. Pick your speakers so alerts are NOT sent into a USB radio codec. 'System default' uses the Windows default device (only WAV sounds can target a specific device)."/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

    </Grid>
</UserControl>
