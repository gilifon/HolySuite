<UserControl x:Class="HolyLogger.OptionsUserControls.GeneralSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HolyLogger.OptionsUserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="380">
    <Grid ShowGridLines="false" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <!-- TWO COLUMNS. One ran taller than the window once "CW via" joined it. The things that are
             not about the radio - the two managers and the alert sounds - moved to a narrow column on
             the right, at its top, and the page is short enough to see whole again. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="590"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="CBX_IsFilterGrid" Content="Filter QSOs table by DX callsign" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.IsFilterQSOs, Source={StaticResource Settings}, Mode=TwoWay}" FontSize="16"/>
        <CheckBox x:Name="CBX_IsAllowLiveLog" Content="Allow automatic upload during special events" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.isAllowLiveLog, Source={StaticResource Settings}, Mode=TwoWay}" Margin="0,26,0,0" FontSize="16"/>
        <CheckBox x:Name="CBX_ShowOnTheAir" Content="Send heartbeat to HolyLogger On The Air" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.ShowOnTheAir, Source={StaticResource Settings}, Mode=TwoWay}" Margin="0,51,0,0" FontSize="16"/>
        <CheckBox x:Name="CBX_CallsignSyncVerboseLog" Content="Verbose callsign sync log" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.CallsignSyncVerboseLog, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,76,0,0"/>

        <CheckBox x:Name="CBX_ValidateHamFrequency" Content="Validate for HAM frequency" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.ValidateHamFrequency, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,101,0,0"
                  ToolTip="Warn on Add (F1) when the frequency is not an amateur-radio band. You can still save; turn this off to stop the warning."/>

        <CheckBox x:Name="CBX_EnableOmniRigCAT" Content="Enable Omni-Rig CAT" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableOmniRigCAT, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,126,0,0" Click="CBX_EnableOmniRigCAT_Changed"/>

        <!-- FROM HERE DOWN THE ROWS ARE STACKED, not placed at fixed heights: the OmniRig sentence can
             be longer (the red one) and its frame taller, and everything below then moves down instead
             of being covered. -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,151,0,0" Width="580">
        <Grid>
        <!-- Left edge lines up with the word "Enable" (checkbox text starts after the ~20px glyph).
             Narrow: a rig name is short (~15 chars), so ~half the old width is plenty. -->
        <GroupBox x:Name="groupBox" Header="Select Rig" Height="90" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="180" FontSize="16">
            <StackPanel>
                <RadioButton x:Name="Rig1_RB" HorizontalAlignment="Left" Margin="0,8,0,0" VerticalAlignment="Top" Content="1: Rig Number 1"  Click="HasChanged_Click" IsChecked="{Binding Default.SelectedOmniRig1, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
                <RadioButton x:Name="Rig2_RB" HorizontalAlignment="Left" Margin="0,8,0,0" VerticalAlignment="Top" Content="2: Rig Number 2" Click="HasChanged_Click" IsChecked="{Binding Default.SelectedOmniRig2, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
            </StackPanel>
        </GroupBox>

        <!-- WHAT OMNIRIG IS SET TO, read out of its own file when this page opens. Everything the
             program knows about the radio arrives on that poll, so a slow one is felt everywhere -
             the frequency box lagging the dial most of all. Red and italic because it is a fault to
             put right, and green and upright when the setting is already 500 or better. -->
        <!-- The sentence and its button sit in one frame, the height of the Select Rig box beside it,
             with the button in the frame's bottom-right corner. The frame grows when the red sentence
             is longer; the code then gives the button a line of its own (ShowOmniRigPollInterval). -->
        <Border x:Name="OmniRigPollFrame" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="208,0,0,0" Width="372" MinHeight="90" Padding="8,4,8,6"
                BorderBrush="#D5DFE5" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="OmniRigPollNote" FontSize="16" FontStyle="Italic" Foreground="#C62828"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>

                <!-- One press to the place the number is changed, beside the sentence that names it. -->
                <Button x:Name="OmniRigOpenBtn" Content="Set OmniRig" Style="{StaticResource GoActionButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="16"
                        Height="32" Width="128" Click="OmniRigOpenBtn_Click"/>
            </Grid>
        </Border>
        </Grid>

        <!-- CONTEST RADIO SETUP. The commands that put a radio in VFO, simplex, no tone and no TSQL,
             sent when a log of the contest picked there is opened (ContestRadioSetupWindow). Here,
             under the rig it is sent to. -->
        <Grid Margin="0,12,0,0">
            <Button x:Name="BTN_ContestRadioSetup" Content="Contest Radio Setup" Style="{StaticResource OrangeActionButtonStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Width="190" Height="32"
                    FontSize="16" Click="BTN_ContestRadioSetup_Click"/>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,5,0,0" FontSize="16"
                       Foreground="Gray" TextWrapping="Wrap" Width="380"
                       Text="Radio commands sent when a contest log opens."/>
        </Grid>

        <!-- OmniRig has two CW modes, CW_U and CW_L, and which of them is CW normal depends on the
             radio - see CwRigModeForConnectedRig in MainWindow.Rig.cs, which reads the answer out of
             the radio's own OmniRig .ini file. This box is the one case that file cannot know about:
             an Icom whose own menu has CW Normal Side changed from LSB to USB. -->
        <GroupBox Header="CW Mode" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0" Width="580" FontSize="16">
            <StackPanel Margin="4,4,4,4">
                <CheckBox x:Name="CBX_SwapCwSideband" Content="Swap CW and CW-R" HorizontalAlignment="Left" IsChecked="{Binding Default.SwapCwSideband, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="16" Foreground="Gray"
                           Text="HolyLogger chooses CW or CW-R to suit your radio. If your radio still goes to the wrong one, tick this box."/>
            </StackPanel>
        </GroupBox>

        <!-- CW VIA. How the CW goes out: the radio keys the text itself (CAT - what HolyLogger has always
             done), or HolyLogger keys the radio through one line of a COM port, the way a straight key
             does (PortCwKeyer). The port is saved and applied the moment it is chosen, like the decoder's
             input device, so a keyer window already open follows it at once. -->
        <GroupBox Header="CW via" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0" Width="580" FontSize="16">
            <StackPanel Margin="4,4,4,4">
                <RadioButton x:Name="RB_CwViaCat" Content="CAT commands" GroupName="CwVia" FontSize="16"
                             Checked="CwVia_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton x:Name="RB_CwViaPort" Content="Key from" GroupName="CwVia" FontSize="16"
                                 VerticalAlignment="Center" Checked="CwVia_Changed"/>
                    <ComboBox x:Name="CB_CwKeyPort" Width="255" Margin="10,0,0,0" FontSize="16" VerticalAlignment="Center"
                              SelectionChanged="CwVia_Changed"/>
                    <ComboBox x:Name="CB_CwKeyLine" Width="80" Margin="8,0,0,0" FontSize="16" VerticalAlignment="Center"
                              SelectionChanged="CwVia_Changed"
                              ToolTip="The line of the port that keys the radio. Most keying cables use DTR.">
                        <ComboBoxItem Content="DTR"/>
                        <ComboBoxItem Content="RTS"/>
                    </ComboBox>
                    <Button x:Name="BTN_RefreshCwKeyPorts" Content="Refresh list" Margin="8,0,0,0" Padding="8,2" FontSize="16"
                            VerticalAlignment="Center" Cursor="Hand" ToolTip="Look for ports again - use it after plugging the cable in"
                            Click="BTN_RefreshCwKeyPorts_Click"/>
                </StackPanel>
                <TextBlock x:Name="CwViaNote" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="16" Foreground="Gray"/>
            </StackPanel>
        </GroupBox>


        </StackPanel>

        <!-- THE RIGHT COLUMN: the UDP and ADIF managers and the alert sounds. Narrow on purpose, so each
             sentence sits under its button and the Audio Alerts frame is laid out top to bottom. -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,0,0,0" Width="300">
            <!-- UDP PORTS. The ports are lines in a table the operator writes himself (UdpPortsWindow). -->
            <Button x:Name="BTN_UdpPorts" Content="UDP Ports Manager" Style="{StaticResource OrangeActionButtonStyle}"
                    HorizontalAlignment="Left" Width="190" Height="32" FontSize="16" Click="BTN_UdpPorts_Click"/>
            <TextBlock Margin="0,4,0,0" FontSize="16" Foreground="Gray" TextWrapping="Wrap"
                       Text="Receive information from other software, and send yours out to it."/>

            <!-- ADIF MONITOR. Files other programs (WSJT-X and the like) write each contact to. -->
            <Button x:Name="BTN_AdifMonitor" Content="ADIF Monitor Manager" Style="{StaticResource OrangeActionButtonStyle}"
                    HorizontalAlignment="Left" Width="190" Height="32" FontSize="16" Margin="0,16,0,0" Click="BTN_AdifMonitor_Click"/>
            <TextBlock Margin="0,4,0,0" FontSize="16" Foreground="Gray" TextWrapping="Wrap"
                       Text="Add new contacts from ADIF files other software writes."/>

            <!-- Audio Alerts: the typing beep and the one output device every alert sound uses (the
                 cluster alerts too), so alerts can go to the speakers instead of a USB radio codec. -->
            <GroupBox Header="Audio Alerts" HorizontalAlignment="Left" Margin="0,16,0,0" Width="300" FontSize="16">
                <StackPanel Margin="4,4,4,4">
                    <CheckBox x:Name="CBX_NonEnglishKeyBeep" HorizontalAlignment="Left" FontSize="16" Margin="0,2,0,0"
                              IsChecked="{Binding Default.NonEnglishKeyBeep, Mode=TwoWay, Source={StaticResource Settings}}"
                              Click="HasChanged_Click">
                        <TextBlock Text="Beep when typing in a non-English keyboard" TextWrapping="Wrap" Width="250"/>
                    </CheckBox>
                    <Button x:Name="BTN_TestBeep" Margin="22,6,0,0" HorizontalAlignment="Left" Padding="8,2"
                            FontSize="16" Cursor="Hand" Click="BTN_TestBeep_Click"
                            ToolTip="Click to test - plays the beep on the selected audio device">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#3B6EA5" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Test" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Select audio device:" FontSize="16" Margin="0,12,0,4"/>
                    <ComboBox x:Name="CB_SoundDevice" HorizontalAlignment="Stretch" FontSize="16"
                              SelectionChanged="CB_SoundDevice_SelectionChanged">
                        <ComboBox.ToolTip>
                            <ToolTip>
                                <TextBlock MaxWidth="330" TextWrapping="Wrap" FontSize="16"
                                           Text="Output device for the alert sounds above. Pick your speakers so alerts are NOT sent into a USB radio codec.&#x0a;&#x0a;'System default' uses the Windows default device (only WAV sounds can target a specific device)."/>
                            </ToolTip>
                        </ComboBox.ToolTip>
                        <!-- Device names are long ("Speakers (Realtek(R) Audio) - High Definition Audio..."),
                             which made every dropdown row one very long line. In the DROPDOWN they now wrap
                             to a readable width; in the CLOSED box (where there is no ComboBoxItem ancestor,
                             so the trigger fires) they stay one line with an ellipsis, and the full name is
                             on hover. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" MaxWidth="300" ToolTip="{Binding}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </GroupBox>
        </StackPanel>

    </Grid>
</UserControl>
