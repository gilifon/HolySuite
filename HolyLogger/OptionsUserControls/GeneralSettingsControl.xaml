<UserControl x:Class="HolyLogger.OptionsUserControls.GeneralSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HolyLogger.OptionsUserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="380">
    <Grid ShowGridLines="false" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <CheckBox x:Name="CBX_IsFilterGrid" Content="Filter QSOs table by DX callsign" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.IsFilterQSOs, Source={StaticResource Settings}, Mode=TwoWay}" FontSize="16"/>
        <CheckBox x:Name="CBX_IsAllowLiveLog" Content="Allow automatic upload during special events" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.isAllowLiveLog, Source={StaticResource Settings}, Mode=TwoWay}" Margin="0,26,0,0" FontSize="16"/>
        <CheckBox x:Name="CBX_ShowOnTheAir" Content="Send heartbeat to HolyLogger On The Air" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.ShowOnTheAir, Source={StaticResource Settings}, Mode=TwoWay}" Margin="0,51,0,0" FontSize="16"/>
        <CheckBox x:Name="CBX_CallsignSyncVerboseLog" Content="Verbose callsign sync log" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.CallsignSyncVerboseLog, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,76,0,0"/>

        <CheckBox x:Name="CBX_ValidateHamFrequency" Content="Validate for HAM frequency" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.ValidateHamFrequency, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,101,0,0"
                  ToolTip="Warn on Add (F1) when the frequency is not an amateur-radio band. You can still save; turn this off to stop the warning."/>

        <CheckBox x:Name="CBX_EnableOmniRigCAT" Content="Enable Omni-Rig CAT" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableOmniRigCAT, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,126,0,0" Click="CBX_EnableOmniRigCAT_Changed"/>

        <!-- Left edge lines up with the word "Enable" (checkbox text starts after the ~20px glyph).
             Narrow: a rig name is short (~15 chars), so ~half the old width is plenty. -->
        <GroupBox x:Name="groupBox" Header="Select Rig" Height="90" Margin="20,151,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="180" FontSize="16">
            <StackPanel>
                <RadioButton x:Name="Rig1_RB" HorizontalAlignment="Left" Margin="0,8,0,0" VerticalAlignment="Top" Content="1: Rig Number 1"  Click="HasChanged_Click" IsChecked="{Binding Default.SelectedOmniRig1, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
                <RadioButton x:Name="Rig2_RB" HorizontalAlignment="Left" Margin="0,8,0,0" VerticalAlignment="Top" Content="2: Rig Number 2" Click="HasChanged_Click" IsChecked="{Binding Default.SelectedOmniRig2, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
            </StackPanel>
        </GroupBox>

        <!-- OmniRig has two CW modes, CW_U and CW_L, and which of them is CW normal depends on the
             radio - see CwRigModeForConnectedRig in MainWindow.Rig.cs, which reads the answer out of
             the radio's own OmniRig .ini file. This box is the one case that file cannot know about:
             an Icom whose own menu has CW Normal Side changed from LSB to USB. -->
        <GroupBox Header="CW Mode" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,246,0,0" Width="580" FontSize="16">
            <StackPanel Margin="4,4,4,4">
                <CheckBox x:Name="CBX_SwapCwSideband" Content="Swap CW and CW-R" HorizontalAlignment="Left" IsChecked="{Binding Default.SwapCwSideband, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16"/>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="16" Foreground="Gray"
                           Text="HolyLogger chooses CW or CW-R to suit your radio. If your radio still goes to the wrong one, tick this box."/>
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="CBX_EnableUDPClient" Content="Enable UDP Client" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableUDPClient, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,370,0,0" Click="HasChanged_Click"/>
        <Label x:Name="label" Content="Port" HorizontalAlignment="Left" Margin="199,364,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="textBox" HorizontalAlignment="Left" Height="23" Margin="243,368,0,0" TextWrapping="Wrap" Text="{Binding Default.UDPPort, Mode=TwoWay, Source={StaticResource Settings}}" VerticalAlignment="Top" Width="112" FontSize="16" PreviewTextInput="PreviewTextInputHandler" DataObject.Pasting="PastingHandler" MaxLength="5" />

        <CheckBox x:Name="CBX_EnableN1MMUDPClient" Content="N1MM+ UDP Client" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableN1MMUDPClient, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,395,0,0" Click="HasChanged_Click"/>
        <Label x:Name="label2" Content="Port" HorizontalAlignment="Left" Margin="199,389,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="textBox2" HorizontalAlignment="Left" Height="23" Margin="243,394,0,0" TextWrapping="Wrap" Text="{Binding Default.N1MMUDPPort, Mode=TwoWay, Source={StaticResource Settings}}" VerticalAlignment="Top" Width="112" FontSize="16" PreviewTextInput="PreviewTextInputHandler" DataObject.Pasting="PastingHandler" MaxLength="5" />

        <!-- HolyCluster spot listener: catches the WSJT-X-format UDP datagram HolyCluster sends when
             you select a spot (the same one it sends to Log4OM) and fills the DX callsign. -->
        <GroupBox Header="HolyCluster" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,425,0,0" Width="580" FontSize="16">
            <StackPanel Margin="4,4,4,4">
                <CheckBox x:Name="CBX_EnableHolyClusterUDP" Content="Fill DX callsign from HolyCluster spots" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding Default.EnableHolyClusterUDP, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Click="HasChanged_Click"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Port" VerticalAlignment="Center" FontSize="16" Padding="0"/>
                    <TextBox x:Name="TB_HolyClusterUDPPort" Width="80" Height="23" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Default.HolyClusterUDPPort, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" PreviewTextInput="PreviewTextInputHandler" DataObject.Pasting="PastingHandler" MaxLength="5"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="16" Foreground="Gray"
                           Text="Set this to the UDP port HolyCluster sends on (its default is 2237). When you select a station in HolyCluster it sends the callsign here and it is placed in the DX Callsign field. If CAT is not connected, the spot's frequency is filled in too."/>
            </StackPanel>
        </GroupBox>

        <!-- Audio Alerts: both sound options plus a single shared output-device picker, so alerts can
             go to the speakers instead of a USB radio codec. Left-justified with the checkboxes. -->
        <GroupBox Header="Audio Alerts" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,601,0,0" Width="580" FontSize="16">
            <StackPanel Margin="4,4,4,4">
                <!-- Beep when typing -->
                <CheckBox x:Name="CBX_NonEnglishKeyBeep" HorizontalAlignment="Left" IsChecked="{Binding Default.NonEnglishKeyBeep, Mode=TwoWay, Source={StaticResource Settings}}" FontSize="16" Margin="0,2,0,0" Click="HasChanged_Click">
                    <StackPanel Orientation="Horizontal">
                        <!-- Fixed label width shared with the sound-alert row below, so the two Test buttons align. -->
                        <TextBlock Text="Beep when typing in a non-English keyboard" VerticalAlignment="Center" Width="315"/>
                        <Button x:Name="BTN_TestBeep" Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,2"
                                FontSize="16" Cursor="Hand" Click="BTN_TestBeep_Click"
                                ToolTip="Click to test — plays the beep on the selected audio device">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#3B6EA5" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Test" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </CheckBox>

                <!-- The two cluster sound alerts (new-country / Unconfirmed spot) moved to the Cluster
                     window's gear (Cluster Settings). The output DEVICE picker below stays here: it is
                     app-wide, not cluster-specific, and those alerts use it. -->

                <!-- App-wide output device, used by every alert sound (including the cluster alerts,
                     which are configured in the Cluster window's gear). -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
                    <TextBlock Text="Select audio device:" Width="150" VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CB_SoundDevice" Width="175" VerticalAlignment="Center" FontSize="16"
                              SelectionChanged="CB_SoundDevice_SelectionChanged">
                        <!-- Spelled out as a wrapping TextBlock rather than a plain ToolTip="..." string:
                             as a string it rendered as one very long single line across the screen. -->
                        <ComboBox.ToolTip>
                            <ToolTip>
                                <TextBlock MaxWidth="330" TextWrapping="Wrap" FontSize="16"
                                           Text="Output device for the alert sounds above. Pick your speakers so alerts are NOT sent into a USB radio codec.&#x0a;&#x0a;'System default' uses the Windows default device (only WAV sounds can target a specific device)."/>
                            </ToolTip>
                        </ComboBox.ToolTip>
                        <!-- Device names are long ("Speakers (Realtek(R) Audio) - High Definition Audio..."),
                             which made every dropdown row one very long line. In the DROPDOWN they now wrap
                             to a readable width; in the CLOSED box (where there is no ComboBoxItem ancestor,
                             so the trigger fires) they stay one line with an ellipsis, and the full name is
                             on hover. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" MaxWidth="300" ToolTip="{Binding}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>

    </Grid>
</UserControl>
