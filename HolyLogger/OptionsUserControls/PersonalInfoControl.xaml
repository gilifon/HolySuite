<UserControl x:Class="HolyLogger.OptionsUserControls.PersonalInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Height="720" Width="660">
    <StackPanel>
        <TextBlock Text="Personal / Station Info" FontSize="17" FontWeight="Bold" Margin="0,2,0,2"/>
        <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="#555555" Margin="0,0,10,8"
                   Text="This information fills the Cabrillo log header for every contest — enter it once and it's reused automatically. Nothing here is mandatory; a contest may still require some of it before you can export that contest's log."/>
        <!-- Fields are added in code-behind from the Cabrillo header catalog (personal fields). -->
        <StackPanel x:Name="SP_Fields" Margin="0,0,12,0"/>
    </StackPanel>
</UserControl>
