<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HolyLogger"
        xmlns:OptionsUserControls="clr-namespace:HolyLogger.OptionsUserControls" x:Class="HolyLogger.OptionsWindow"
        mc:Ignorable="d"
        Title="Properties" Height="920" MinHeight="400" Width="970" MinWidth="960" ResizeMode="CanResize" Icon="Images/properties.png" SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown"
        Background="White">
    <Window.Resources>
        <!-- THE PAGE LIST, STRIPED LIKE THE LOG TABLE. One row white, the next grey, so the eye can
             follow a line across to the page it wants.

             THE COLOURS ARE WRITTEN OUT, not taken from the theme's GridRowBg / GridAltRowBg tokens
             they copy (#FFFFFF and #F5F5F5, the light theme's values). This window is deliberately
             always light - see App.xaml.cs, none of its settings panels were ever made theme-aware -
             so a token that turns near-black in dark mode would stripe this list against black text.

             A TEMPLATE OF ITS OWN, rather than just a Background: the stock TreeViewItem keeps a 19px
             column on the left for the expander arrow and paints no background behind it, which would
             have left every grey row with a white notch down its left-hand side. These eleven items
             have no children and no arrow, so the row is simply a border with the header in it.
             An item given children would need the ItemsPresenter this template leaves out. -->
        <Style x:Key="OptionsNavItem" TargetType="TreeViewItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="6,4,6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E8F1FB"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 210, not 180: the list was set to the program's smallest allowed size of 16 and
                 "Import Settings" no longer fitted the old width. -->
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel x:Name="TreeViewPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0">
            <TreeView x:Name="treeView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="16"
                      AlternationCount="2" ItemContainerStyle="{StaticResource OptionsNavItem}">
                <TreeViewItem x:Name="GeneralItem" Header="General" Selected="GeneralItem_Selected" />
                <TreeViewItem x:Name="UlItem" Header="User Interface" Selected="UserInterfaceItem_Selected" />
                <TreeViewItem x:Name="PersonalInfoItem" Header="Personal Info" Selected="PersonalInfoItem_Selected" />
                <TreeViewItem x:Name="QRZItem" Selected="QRZServicesItem_Selected">
                    <TreeViewItem.Header><TextBlock><Run FontWeight="Bold" Text="QRZ"/><Run Text=" Services"/></TextBlock></TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem x:Name="EqslItem" Selected="EqslServiceItem_Selected">
                    <TreeViewItem.Header><TextBlock><Run FontWeight="Bold" Text="eQSL"/><Run Text=" Service"/></TextBlock></TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem x:Name="ClublogItem" Selected="ClublogServiceItem_Selected">
                    <TreeViewItem.Header><TextBlock><Run FontWeight="Bold" Text="Club Log"/><Run Text=" Service"/></TextBlock></TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem x:Name="LotwItem" Selected="LotwItem_Selected">
                    <TreeViewItem.Header><TextBlock><Run FontWeight="Bold" Text="LoTW"/><Run Text=" Services"/></TextBlock></TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem x:Name="ImportItem" Header="Import Settings" Selected="ImportItem_Selected"/>
                <TreeViewItem x:Name="SatelliteItem" Header="Satellite Mode" Selected="SatelliteItem_Selected"/>
                <TreeViewItem x:Name="RadioPanelItem" Header="Radio Control Panel" Selected="RadioPanelItem_Selected"/>
                <TreeViewItem x:Name="AiItem" Selected="AiItem_Selected">
                    <TreeViewItem.Header><TextBlock><Run FontWeight="Bold" Text="AI"/><Run Text=" Service"/></TextBlock></TreeViewItem.Header>
                </TreeViewItem>
            </TreeView>
        </DockPanel>
        <!-- Each settings panel is a fixed-size UserControl. On a screen shorter than the window
             (low resolution or 125/150% display scaling) the bottom controls used to fall off the
             screen edge with no way to reach them. Hosting them in a ScrollViewer means that when
             the window is shrunk to fit a short screen, a vertical scrollbar appears so every
             control stays reachable. On a tall screen everything fits and no scrollbar shows. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <OptionsUserControls:QRZServicesControl x:Name="QRZServicesControlInstance" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Visibility="Hidden"/>
                <OptionsUserControls:EqslServiceControl x:Name="EqslServiceControlInstance" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Visibility="Hidden"/>
                <OptionsUserControls:ClublogServiceControl x:Name="ClublogServiceControlInstance" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Visibility="Hidden"/>
                <OptionsUserControls:LotwControl x:Name="LotwControlInstance" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Visibility="Hidden"/>
                <OptionsUserControls:UserInterfaceControl x:Name="UserInterfaceControlInstance" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Visibility="Hidden"/>
                <OptionsUserControls:GeneralSettingsControl x:Name="GeneralSettingsControlControlInstance" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Visibility="Hidden"/>
                <OptionsUserControls:ImportControl x:Name="ImportControlInstance" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Visibility="Hidden"/>
                <OptionsUserControls:SatelliteControl x:Name="SatelliteControlInstance" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Visibility="Hidden"/>
                <OptionsUserControls:RadioControlPanelControl x:Name="RadioControlPanelControlInstance" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Visibility="Hidden"/>
                <OptionsUserControls:PersonalInfoControl x:Name="PersonalInfoControlInstance" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Visibility="Hidden"/>
                <!-- NO USERCONTROL OF ITS OWN. The chooser, the signup steps, the price and the key
                     box already exist as AiServicePanel, built in code so the check window and the
                     Log Fixer can both put it in front of the operator. A fourth copy of the same
                     four controls, in XAML, would be a fourth place to update the day a service is
                     added. This page is a frame; the panel is dropped into it at runtime. -->
                <StackPanel x:Name="AiHostInstance" HorizontalAlignment="Left" Margin="10,10,10,0" VerticalAlignment="Top" Width="520" Visibility="Hidden"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
