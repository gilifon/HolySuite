<Window x:Class="HolyLogger.QsoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit QSO"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- A column header, styled like the log table's headers. -->
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Background" Value="#DEB887"/>
            <Setter Property="Foreground" Value="#3A2A15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="Margin" Value="1,1,1,0"/>
        </Style>
        <!-- An editable cell under a header. IsUndoEnabled (default) gives per-box Ctrl+Z. -->
        <Style x:Key="Cell" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="Margin" Value="1,0,1,1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#9BB8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellRO" TargetType="TextBox" BasedOn="{StaticResource Cell}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#E7EFF9"/>
            <Setter Property="Foreground" Value="#445A75"/>
        </Style>
        <Style x:Key="ConfBox" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,3,1,2"/>
        </Style>
        <!-- The confirmation date printed under a confirmation tick (and the deleted-entity note). -->
        <Style x:Key="ConfNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#3E5A7A"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,0,2,4"/>
        </Style>
        <!-- Caption above a group of fields. -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0D47A1"/>
            <Setter Property="Margin" Value="13,6,0,1"/>
        </Style>
    </Window.Resources>

    <!-- Rounded, light-blue card. The outer window is transparent, so this Border is the visible shape. -->
    <Border CornerRadius="12" Background="#BDDFFF" BorderBrush="#1565C0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Title bar (drag to move) -->
            <Border x:Name="TitleBar" CornerRadius="12,12,0,0" Background="#1565C0" Padding="14,8"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <!-- Grid, not DockPanel: the callsign is centred on the BAR, not on what is left of it. -->
                <Grid>
                    <TextBlock Text="Full View &amp; Edit" Foreground="White" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TB_TitleCall" Foreground="#FFFFFF" FontSize="17"
                               FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TB_TitleId" Foreground="#9EC5F5" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- The table's columns, folded into two stacked header+cell rows, each field at its table
                 width. Row 1 -->
            <Grid Margin="12,12,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="74"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date"      Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Time"      Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Callsign"  Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Name"      Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Country"   Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="Frequency" Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Band"      Style="{StaticResource Hdr}"/>

                <TextBox  Grid.Row="1" Grid.Column="0" x:Name="TB_Date"    Style="{StaticResource Cell}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" x:Name="TB_Time"    Style="{StaticResource Cell}"/>
                <TextBox  Grid.Row="1" Grid.Column="2" x:Name="TB_Call"    Style="{StaticResource Cell}" CharacterCasing="Upper" TextChanged="Call_TextChanged"/>
                <TextBox  Grid.Row="1" Grid.Column="3" x:Name="TB_Name"    Style="{StaticResource Cell}" HorizontalContentAlignment="Left"/>
                <TextBox  Grid.Row="1" Grid.Column="4" x:Name="TB_Country" Style="{StaticResource CellRO}" ToolTip="Set from the callsign's DXCC prefix — not editable"/>
                <TextBox  Grid.Row="1" Grid.Column="5" x:Name="TB_Freq"    Style="{StaticResource Cell}" ToolTip="MHz" TextChanged="Freq_TextChanged"/>
                <ComboBox Grid.Row="1" Grid.Column="6" x:Name="CB_Band"    IsEditable="True" FontSize="12" Margin="1,0,1,1"
                          VerticalContentAlignment="Center"
                          ToolTip="Pick the band. When a frequency is set, the band is derived from it and locked."/>
            </Grid>

            <!-- Row 2: the rest of what was received from the DX station. -->
            <Grid Margin="12,2,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="RST-R"     Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="RST-S"     Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Mode"      Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Submode"   Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Exchange Rcvd" Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="DX Locator" Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Continent" Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="7" Text="CQ Zone"   Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Text="ITU Zone"  Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="9" Text="State"     Style="{StaticResource Hdr}"/>

                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TB_RstRcvd"   Style="{StaticResource Cell}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TB_RstSent"   Style="{StaticResource Cell}"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TB_Mode"      Style="{StaticResource Cell}" CharacterCasing="Upper"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TB_Submode"   Style="{StaticResource Cell}" CharacterCasing="Upper"/>
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="TB_Exchange"  Style="{StaticResource Cell}" CharacterCasing="Upper"
                         ToolTip="The exchange RECEIVED from the DX station — their Holyland square (the log table's Exchange column)"/>
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="TB_DxLocator" Style="{StaticResource Cell}" CharacterCasing="Upper"
                         ToolTip="The DX station's Maidenhead grid square, e.g. KM72"/>
                <TextBox Grid.Row="1" Grid.Column="6" x:Name="TB_Continent" Style="{StaticResource CellRO}"
                         ToolTip="Set from the callsign's DXCC prefix — not editable"/>
                <TextBox Grid.Row="1" Grid.Column="7" x:Name="TB_CqZone"    Style="{StaticResource Cell}"/>
                <TextBox Grid.Row="1" Grid.Column="8" x:Name="TB_ItuZone"   Style="{StaticResource Cell}"/>
                <TextBox Grid.Row="1" Grid.Column="9" x:Name="TB_State"     Style="{StaticResource Cell}" CharacterCasing="Upper"
                         ToolTip="The DX station's state / province (ADIF STATE), e.g. CA"/>
            </Grid>

            <!-- Row 3: propagation and the free-text fields. -->
            <Grid Margin="12,2,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="480"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Prop Mode" Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Sat Name"  Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Comment"   Style="{StaticResource Hdr}"/>

                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TB_PropMode" Style="{StaticResource Cell}" CharacterCasing="Upper"
                         ToolTip="ADIF propagation mode, e.g. SAT, EME, TR"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TB_SatName"  Style="{StaticResource Cell}" CharacterCasing="Upper"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TB_Comment"  Style="{StaticResource Cell}" HorizontalContentAlignment="Left"/>
            </Grid>

            <!-- Row 4: this end of the contact. -->
            <TextBlock Text="MY STATION" Style="{StaticResource Caption}"/>
            <Grid Margin="12,0,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="My Callsign" Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Operator"    Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Exchange Sent" Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="My Locator"  Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Soapbox"     Style="{StaticResource Hdr}"/>

                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TB_MyCall"    Style="{StaticResource Cell}" CharacterCasing="Upper"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TB_Operator"  Style="{StaticResource Cell}" CharacterCasing="Upper"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TB_MySquare"  Style="{StaticResource Cell}" CharacterCasing="Upper"
                         ToolTip="The exchange YOU sent — your Holyland square, or the contest's sent exchange when a contest is running"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TB_MyLocator" Style="{StaticResource Cell}" CharacterCasing="Upper"
                         ToolTip="Your own Maidenhead grid square"/>
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="TB_Soapbox"   Style="{StaticResource Cell}" HorizontalContentAlignment="Left"/>
            </Grid>

            <!-- Confirmations. The tick is editable (that is how a paper card is recorded); the date and the
                 deleted-entity note under it come from the service that reported the confirmation. -->
            <TextBlock Text="CONFIRMED BY" Style="{StaticResource Caption}"/>
            <Grid Margin="12,0,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="LoTW"      Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="QRZ"       Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="eQSL"      Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Club Log"  Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Paper QSL" Style="{StaticResource Hdr}"/>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <CheckBox x:Name="CB_ConfLotw" Style="{StaticResource ConfBox}"/>
                    <TextBlock x:Name="TB_LotwNote" Style="{StaticResource ConfNote}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <CheckBox x:Name="CB_ConfQrz" Style="{StaticResource ConfBox}"/>
                    <TextBlock x:Name="TB_QrzNote" Style="{StaticResource ConfNote}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <CheckBox x:Name="CB_ConfEqsl" Style="{StaticResource ConfBox}"/>
                    <TextBlock x:Name="TB_EqslNote" Style="{StaticResource ConfNote}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3">
                    <CheckBox x:Name="CB_ConfClublog" Style="{StaticResource ConfBox}"/>
                    <TextBlock x:Name="TB_ClublogNote" Style="{StaticResource ConfNote}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4">
                    <CheckBox x:Name="CB_ConfPaper" Style="{StaticResource ConfBox}"/>
                    <TextBlock x:Name="TB_PaperNote" Style="{StaticResource ConfNote}"/>
                </StackPanel>
            </Grid>

            <!-- Where this QSO stands in each upload queue. Read-only: uploads are driven from the
                 right-click "Send to upload queue" menu, not by typing a status here. -->
            <TextBlock Text="UPLOADED TO" Style="{StaticResource Caption}"/>
            <Grid Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="175"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="LoTW"     Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="QRZ"      Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="eQSL"     Style="{StaticResource Hdr}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Club Log" Style="{StaticResource Hdr}"/>

                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TB_UpLotw"    Style="{StaticResource CellRO}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TB_UpQrz"     Style="{StaticResource CellRO}"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TB_UpEqsl"    Style="{StaticResource CellRO}"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TB_UpClublog" Style="{StaticResource CellRO}"/>
            </Grid>

            <!-- Save / Cancel -->
            <Border CornerRadius="0,0,12,12" Background="#A9CCF0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BTN_Save" Content="Save" Width="96" FontSize="14" FontWeight="Bold"
                            Padding="10,5" Margin="0,0,14,0" Click="Save_Click" IsDefault="True"/>
                    <Button x:Name="BTN_Cancel" Content="Cancel" Width="96" FontSize="14"
                            Padding="10,5" Click="Cancel_Click" IsCancel="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
