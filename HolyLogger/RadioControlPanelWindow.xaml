<Window x:Class="HolyLogger.RadioControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Radio Control Panel"
        Height="304" Width="240" MinHeight="294" MinWidth="230"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- The panel's own button look. The application's ordinary button style says nothing about a
             PRESSED state, and this panel's whole job is to show, at a glance, which band and which
             mode the radio is on: the lit button carries a green face, white bold text and a gold
             edge, none of which any other button in the program wears. -->
        <Style x:Key="PanelToggleStyle" TargetType="{x:Type primitives:ToggleButton}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                        <Border x:Name="Face"
                                CornerRadius="5"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FF00A650"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FFFFC400"/>
                                <Setter TargetName="Face" Property="BorderThickness" Value="3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Type a frequency, press Enter, the radio goes there. Seven digits is the most any
             frequency the panel deals with needs, and the box is that wide and no wider. -->
        <Grid Grid.Row="0">
            <!-- Three columns, the outer two equal: the box itself sits dead centre of the panel, and
                 "kHz" stands beside it in the right-hand column without pulling the box off centre. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TB_Frequency" Grid.Column="1" Width="126" Height="34" FontSize="18" FontWeight="Bold" MaxLength="9"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Background="{DynamicResource EditFieldBg}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                     KeyDown="TB_Frequency_KeyDown" PreviewTextInput="TB_Frequency_PreviewTextInput"
                     LostFocus="TB_Frequency_LostFocus"/>
            <TextBlock Grid.Column="2" Text="kHz" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,0"
                       Foreground="{DynamicResource TextBrush}"/>
        </Grid>

        <!-- Twelve buttons, four rows of three: ten bands, plus SSB and CW either side of the
             bottom row. They are built in code from the frequencies on the Options page, so
             editing a frequency there changes what a button does without touching this file. -->
        <!-- Top, not stretched: with the rows sharing out the leftover height, the buttons were
             pushed apart by whatever the window had spare. Anchored to the top they keep their own
             4px gap whatever the window height, and the spare room falls to the bottom, where the
             "no radio" line appears. -->
        <UniformGrid x:Name="ButtonGrid" Grid.Row="1" Rows="4" Columns="3" VerticalAlignment="Top" Margin="0,4,0,0"/>

        <!-- Underneath, and only when there is something wrong to say: no radio, or something typed
             that is not a frequency. Collapsed the rest of the time, so it costs no height. -->
        <TextBlock x:Name="TB_Status" Grid.Row="2" Text="" FontSize="16" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}"/>

    </Grid>
</Window>
