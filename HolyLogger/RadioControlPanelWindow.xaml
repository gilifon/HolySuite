<Window x:Class="HolyLogger.RadioControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Radio Control Panel"
        Width="240" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- The colour of a lit button, and the colour its text turns. Both are resources, not fixed
             colours in the trigger, because the panel repaints them when the mode changes: blue
             background with white text while the radio is on SSB, red with white on CW - but yellow
             with the ordinary text colour on RTTY, which is lit with EditFieldBg, the same yellow a
             QSO field wears while being edited in the main window; there too the text stays its usual
             colour and only the background changes. White would read fine on that yellow in the dark
             scheme (EditFieldBg is a dark olive there) but not in the light one, where it is a bright,
             saturated yellow - so the text colour travels with the mode exactly like the background
             does, in PanelLitTextBrush, and every lit button (a band button included, when the radio
             is on RTTY) reads correctly in both schemes without a second style to keep in step. -->
        <SolidColorBrush x:Key="PanelLitBrush" Color="#FF1565C0"/>
        <SolidColorBrush x:Key="PanelLitTextBrush" Color="White"/>

        <!-- The panel's own button look. The application's ordinary button style says nothing about a
             PRESSED state, and this panel's whole job is to show, at a glance, which band and which
             mode the radio is on: the lit button carries the mode's colour, bold text in whichever
             colour PanelLitTextBrush currently holds, and a gold edge - none of which any other
             button in the program wears. -->
        <Style x:Key="PanelToggleStyle" TargetType="{x:Type primitives:ToggleButton}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                        <Border x:Name="Face"
                                CornerRadius="5"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- A band's colour mark, bottom-right - part of the template itself
                                     rather than something laid over the button from outside, which
                                     never actually rendered. Named, not bound: MakeBandButton finds
                                     this part by name after applying the template and sets Fill on it
                                     directly in code - no Binding, no attached property, nothing for
                                     either to fail silently on. A mode button never touches it, so it
                                     stays at its Transparent default there. IsEnabled/Opacity above
                                     dims it right along with everything else the template draws -
                                     nothing extra to keep in step when a band is unchecked on Options. -->
                                <Path x:Name="CornerMark" Fill="Transparent"
                                      Data="M0,9 L9,9 L9,0 Z" Width="9" Height="9" Stretch="Fill"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,2,2" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PanelLitBrush}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FFFFC400"/>
                                <Setter TargetName="Face" Property="BorderThickness" Value="3"/>
                                <Setter Property="Foreground" Value="{DynamicResource PanelLitTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- Every row takes exactly the height it needs and the window is sized to their sum, so
                 the air under the lamp is the same 8px margin as the air above the frequency box.
                 Nothing stretches: a stretching row put the window's spare height between the buttons
                 and the lamp, which read as a gap for no reason. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Type a frequency, press Enter, the radio goes there. -->
        <Grid Grid.Row="0">
            <!-- Three columns, the outer two equal: the box itself sits dead centre of the panel, and
                 "kHz" stands beside it in the right-hand column without pulling the box off centre. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- The gear stands in the empty left-hand column, beside the box, left-aligned at the
                 same 2px inset the band buttons below use (PanelToggleStyle's own Margin) - so its
                 frame lines up with the "1.8" button's frame directly beneath it, rather than sitting
                 wherever the column's own (narrower) width happened to centre or right-align it. It
                 opens the panel's own page in Options - the band frequencies these buttons send the
                 radio to. -->
            <!-- THE SAME GEAR AS THE CLUSTER'S, down to the frame around it: the Segoe MDL2 settings
                 glyph at 16 in a 26x26 square, a one-pixel frame drawn INSIDE a transparent one-pixel
                 margin, and the cluster's own hover and pressed blues. Two gears that open two
                 settings pages should not be two different-looking buttons. -->
            <Button x:Name="PanelSettingsBtn" Grid.Column="0"
                    Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                    Width="26" Height="26" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                    Foreground="{DynamicResource TextBrush}"
                    Background="{DynamicResource WindowBg}"
                    BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1"
                    Cursor="Hand"
                    Click="PanelSettingsBtn_Click"
                    ToolTip="Open the settings for this panel">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="1">
                            <Border x:Name="face"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="#A8D8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="#7DC0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- THE ARROWS SIT INSIDE THE BOX, at its right-hand edge. A wheel over a text box is not
                 something anybody expects, and the hint has to be ON the thing it is about - beside
                 the box it read as decoration next to "kHz". IsHitTestVisible="False" so the arrows
                 are scenery: every click and every notch of the wheel goes straight through them to
                 the box underneath. Padding on the box keeps a long frequency from running under them. -->
            <Grid Grid.Column="1">
                <!-- THE BOX IS PAINTED IN THREE LAYERS, because the band that marks what the wheel
                     would move has to lie UNDER the digits, and the digits belong to a plain TextBox.
                     Bottom: the box itself - fill and frame. Middle: the band. Top: the TextBox,
                     transparent in both, so the two layers beneath it show through. -->
                <Border Width="126" Height="34" Background="{DynamicResource FormBg}"
                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"/>
                <Canvas x:Name="FreqZoneLayer" Width="126" Height="34" ClipToBounds="True" IsHitTestVisible="False">
                    <Rectangle x:Name="FreqZoneMark" Fill="{DynamicResource EditFieldBg}" Visibility="Collapsed"/>
                </Canvas>
                <TextBox x:Name="TB_Frequency" Width="126" Height="34" FontSize="18" FontWeight="Bold" MaxLength="9"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Padding="0,0,14,0"
                         Background="Transparent" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="Transparent" BorderThickness="1"
                         KeyDown="TB_Frequency_KeyDown" PreviewTextInput="TB_Frequency_PreviewTextInput"
                         Cursor="ScrollNS"
                         PreviewMouseWheel="TB_Frequency_PreviewMouseWheel"
                         MouseMove="TB_Frequency_MouseMove" MouseLeave="TB_Frequency_MouseLeave"
                         LostFocus="TB_Frequency_LostFocus"/>
                <TextBlock Text="&#x21C5;" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,6,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </Grid>
            <!-- kHz, and under it the sign that the box can be rolled. A wheel over a text box is not
                 something anybody expects, so it has to be shown rather than discovered: the two
                 arrows say it in the one place the wheel works. -->
            <TextBlock Grid.Column="2" Text="kHz" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,-3"
                       Foreground="{DynamicResource TextBrush}"/>
        </Grid>

        <!-- Fifteen band buttons, five rows of three: twelve bands three to a row, then the last band
             alone in the middle of its row (blank either side). They are built in code from the
             frequencies on the Options page, so editing a frequency there changes what a button does
             without touching this file, and the row count here (Rows) always matches what
             BuildButtons (in the code-behind) lays out. -->
        <UniformGrid x:Name="ButtonGrid" Grid.Row="1" Rows="5" Columns="3" VerticalAlignment="Top" Margin="0,4,0,0"/>

        <!-- Separates the bands from the mode row below - asked for by eye: brown, 2px, short of the
             window frame on both sides so it reads as a rule drawn on the panel rather than a seam in
             it. No top/bottom margin of its own: the row above and below already carry their
             buttons' usual 4px margins, and giving the divider more air on top of that was the one
             thing that made the window taller than it used to be. -->
        <Border Grid.Row="2" Height="2" Background="#8B5A2B" Margin="2,0,2,0"/>

        <!-- SSB, AM and CW - one row, filled in by BuildButtons the same way ButtonGrid's cells are.
             RTTY and FM are not here at all - they sit in the row below, flanking TX/RX (see the next
             Grid). -->
        <UniformGrid x:Name="ModeRow" Grid.Row="3" Rows="1" Columns="3"/>

        <!-- Built the way the radio itself does it: the words TX/RX, and one rectangular lamp under
             them - green while the radio is listening, red while it is transmitting. Dark when there
             is no radio, and then the label reads NO RADIO instead, which is the panel's one place
             for saying so now that the window is a fixed size. Nothing here polls: the lamp is
             written from the same OmniRig event as everything else in the panel.
             THE SAME THREE COLUMNS AS THE BAND GRID ABOVE, so RttySlot and FmSlot line up under
             columns 0 and 2 rather than floating at some other width. RTTY and FM moved down into the
             space already free on either side of the centred TX/RX block - not a new row, this row
             already existed - so the window grows only by the few pixels their own buttons are taller
             than the label+lamp stack, not by a whole extra row. -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Both filled in by BuildButtons in the code-behind, the same way ButtonGrid's cells are. -->
            <Grid x:Name="RttySlot" Grid.Column="0" VerticalAlignment="Center"/>
            <Grid x:Name="FmSlot" Grid.Column="2" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <!-- Three runs rather than one string, because the two words are coloured the way the
                     lamp below colours them: TX in the lamp's red, RX in the lamp's green, the slash
                     in the plain text colour. The runs sit on one line with no space between them -
                     whitespace between Runs in XAML becomes a space in the rendered text, and the
                     label has to read "TX/RX", not "TX / RX". Text and colours are set again in
                     ShowTxRx, which is also what turns the whole thing into a red "NO RADIO". -->
                <TextBlock x:Name="TxRxLabel" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"><Run
                           x:Name="TxWord" Text="TX" Foreground="#D32F2F"/><Run x:Name="TxRxSlash"
                           Text="/"/><Run x:Name="RxWord" Text="RX" Foreground="#00A650"/></TextBlock>
                <!-- No Width of its own: stretched inside a stack that is only as wide as the words
                     above it, the lamp comes out exactly the length of the label. -->
                <Border x:Name="TxRxLamp" Height="14" CornerRadius="2" Margin="0,3,0,0"
                        BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}"
                        Background="{DynamicResource ButtonBg}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
