<Window x:Class="HolyLogger.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HolyLogger"
        Title="Log Search"
        Height="620" Width="980"
        MinHeight="440" MinWidth="600"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <local:QsoDateDisplayConverter x:Key="QsoDateDisplayConverter"/>
        <local:QsoTimeDisplayConverter x:Key="QsoTimeDisplayConverter"/>
        <local:BandColorConverter x:Key="BandColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Every label is inside the SAME StackPanel as the control it names, so the WrapPanel
                     can only ever break BETWEEN filters. Loose labels could wrap to the end of one line
                     while their box started the next, leaving a box with no visible name. -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Callsign:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TB_Callsign" Width="140" FontSize="14" VerticalAlignment="Center"
                             TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Country:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CB_Country" Width="220" FontSize="14" VerticalAlignment="Center"
                              IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="280"
                              IsSynchronizedWithCurrentItem="False"
                              PreviewKeyDown="CB_Country_PreviewKeyDown"
                              PreviewTextInput="CB_Country_PreviewTextInput"
                              KeyUp="CB_Country_KeyUp">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding FlagImage}" Width="24" Height="16"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <!-- Second filter row. The WrapPanel flows these onto their own line at the
                       default width; the window's Height/MinHeight were raised to match. -->
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,20,0">
                    <TextBlock Text="Band:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CB_Band" Width="90" FontSize="14" VerticalAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,20,0">
                    <TextBlock Text="Mode:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CB_Mode" Width="90" FontSize="14" VerticalAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,20,0">
                    <TextBlock Text="My callsign:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="The station callsign the QSO was logged UNDER (yours), not the station worked"/>
                    <ComboBox x:Name="CB_MyCall" Width="130" FontSize="14" VerticalAlignment="Center"
                              ToolTip="The station callsign the QSO was logged UNDER (yours), not the station worked"
                              SelectionChanged="Filter_Changed"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,20,0">
                    <TextBlock Text="From:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DP_From" Width="125" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                                SelectedDateChanged="Filter_Changed"/>
                    <TextBlock Text="To:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DP_To" Width="125" FontSize="13" VerticalAlignment="Center"
                                SelectedDateChanged="Filter_Changed"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,20,0">
                    <TextBlock Text="Locator:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="The worked station's grid square, e.g. KM72"/>
                    <TextBox x:Name="TB_Locator" Width="90" FontSize="14" VerticalAlignment="Center"
                             ToolTip="The worked station's grid square, e.g. KM72"
                             TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,20,0">
                    <TextBlock Text="Square:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="Holyland square received (the Exchange column)"/>
                    <TextBox x:Name="TB_Square" Width="90" FontSize="14" VerticalAlignment="Center"
                             ToolTip="Holyland square received (the Exchange column)"
                             TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                  </StackPanel>

                    <Button x:Name="Btn_Search" FontSize="14" Padding="16,4" Margin="0,6,0,0"
                            Click="Btn_Search_Click" Background="#1565C0" Foreground="White"
                            BorderBrush="#0D47A1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Stretch="Uniform" Fill="White"
                                      Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            </Viewbox>
                            <TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Btn_Clear" Content="Clear" FontSize="14" Padding="12,4"
                            Click="Btn_Clear_Click" Background="#757575" Foreground="White"
                            BorderBrush="#616161" Cursor="Hand" Margin="8,6,0,0"/>
                </WrapPanel>
                <!-- QSO count, right-justified so it tracks the right edge on resize -->
                <TextBlock x:Name="TB_Count" Grid.Column="1" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="20,0,6,0"/>
            </Grid>
        </Border>

        <!-- Results grid -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="1"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  AlternationCount="2"
                  Background="{DynamicResource WindowBg}"
                  RowBackground="{DynamicResource GridRowBg}"
                  AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  FontSize="16"
                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                  Sorting="ResultsGrid_Sorting"
                  VerticalGridLinesBrush="{DynamicResource GridLine}" HorizontalGridLinesBrush="{DynamicResource GridLine}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,3"/>
                    <Setter Property="Padding" Value="5,3,5,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#DEB887"/>
                    <!-- Tan header keeps its light-mode look in both modes, so the text on it must
                         stay dark even when the dark theme's TextBrush turns white. -->
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                    <!-- Sort arrow on the column currently sorted, the same triangle and placement as
                         the cluster table's headers, so the two tables read alike. -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Margin="{TemplateBinding Padding}"/>
                                            <Path x:Name="SortArrow"
                                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                                  Fill="#000000" Stretch="Uniform" Width="8" Height="6"
                                                  Data="M 0,0 L 1,1 L 2,0 Z"
                                                  Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleY="1"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="4" Cursor="SizeWE">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" Padding="0"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="4" Cursor="SizeWE">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" Padding="0"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="SortArrow" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="SortArrow" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleY="-1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="Col_Date" Header="Date" IsReadOnly="True" SortMemberPath="Date">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Date, Converter={StaticResource QsoDateDisplayConverter}}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Time" IsReadOnly="True" SortMemberPath="Time">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Time, Converter={StaticResource QsoTimeDisplayConverter}}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Callsign" IsReadOnly="True" SortMemberPath="DXCall">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DXCall}" HorizontalAlignment="Center" Padding="5,0,5,0" FontWeight="Bold"
                                       Cursor="Hand" ToolTip="QRZ" MouseLeftButtonUp="Callsign_MouseLeftButtonUp"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Name" IsReadOnly="True" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Country" IsReadOnly="True" SortMemberPath="Country">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Country}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Frequency" IsReadOnly="True" SortMemberPath="Freq">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Freq}" Foreground="{Binding Band, Converter={StaticResource BandColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Band" IsReadOnly="True" SortMemberPath="Band">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Band}" Foreground="{Binding Band, Converter={StaticResource BandColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RST-R" IsReadOnly="True" SortMemberPath="RST_RCVD">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RST_RCVD}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RST-S" IsReadOnly="True" SortMemberPath="RST_SENT">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RST_SENT}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mode" IsReadOnly="True" SortMemberPath="Mode">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Exchange" IsReadOnly="True" SortMemberPath="SRX">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SRX}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Comment" IsReadOnly="True" SortMemberPath="Comment" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Comment}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0" Padding="10,5">
            <TextBlock x:Name="TB_Status" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                       Text="Enter a Callsign or Country (or both) and press Search."/>
        </Border>
    </Grid>
</Window>
