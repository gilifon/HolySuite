<Window x:Class="HolyLogger.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HolyLogger"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Log Workshop"
        Height="720" Width="1025"
        MinHeight="560" MinWidth="1025"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <!-- Custom title bar (below) replaces the OS caption. The OS one draws a single plain string:
             it cannot show part of the text in bold, nor be made larger. Since the title now has to
             name the log being searched, and that name is the part worth reading, the caption is drawn
             here instead - the same approach the Channels and Cluster windows already take.
             CaptionHeight matches the bar's height so drag / double-click-maximize / snap keep working. -->
        <shell:WindowChrome CaptionHeight="34" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:QsoDateDisplayConverter x:Key="QsoDateDisplayConverter"/>
        <local:QsoTimeDisplayConverter x:Key="QsoTimeDisplayConverter"/>
        <!-- Editing shows the seconds the display hides, so opening the cell cannot lose them. -->
        <local:QsoTimeEditConverter x:Key="QsoTimeEditConverter"/>
        <local:BandColorConverter x:Key="BandColorConverter"/>
        <local:LotwUserConverter x:Key="LotwUserConverter"/>
    </Window.Resources>

    <!-- Frame around the whole window in the app's accent blue. WindowStyle=None removed the OS
         border, so without this the window's edge is invisible against whatever is behind it. -->
    <Border BorderBrush="#1565C0" BorderThickness="3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar. 34px tall so a 17pt title sits comfortably: that is about as large as a
             caption can go before it starts to crowd the window buttons beside it. -->
        <Border x:Name="CustomTitleBar" Grid.Row="0" Height="34" Background="{DynamicResource TitleBarBg}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TitleBar_MinimizeBtn" Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="TitleBar_MaxRestoreBtn" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_MaxRestore_Click" ToolTip="Maximize"/>
                    <Button x:Name="TitleBar_CloseBtn" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBar_Close_Click" ToolTip="Close"/>
                </StackPanel>
                <Image Source="Images/crown.png" Width="18" Height="18" Margin="10,0,8,0"
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <!-- "Log Search —" stays normal weight; the LOG NAME is the part worth reading, so it
                     alone is bold. TB_TitleLog is filled in by the constructor. -->
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="17"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="Log Workshop"/><Run Text="  —  "/><Run x:Name="TB_TitleLog" FontWeight="Bold"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Search bar -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2" Padding="10,8">
            <Grid>
                <!-- Explicit rows, not a WrapPanel.
                     Which filter landed on which line used to be decided by whatever width was left
                     over, which is why Mode sat under Band instead of beside it. Now the window has a
                     fixed minimum width there is nothing for wrapping to decide, so the rows are
                     stated outright. Each label still shares a panel with the control it names.

                     HorizontalAlignment="Left" makes this panel exactly as wide as its widest row -
                     row 1, ending at the Mode dropdown. The QSO count on row 3 is docked to the right
                     of that same width, which is what lines it up under Mode. -->
                <StackPanel x:Name="FiltersPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">

                  <!-- Rows 1-2 (the callsign / QSO-identity filters) share a light green background. -->
                  <Border Background="#DFF5DF" CornerRadius="4" Padding="6,5">
                  <StackPanel>

                  <!-- Row 1: callsign halves, country, band, mode -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <!-- Callsign split into its two halves. The digit belongs to the prefix (4Z5 + SL),
                       a leading stroke stays with the prefix (4X/OK1 + DL) and a trailing one with the
                       suffix (4Z5 + SL/M). Either box alone is a valid search. -->
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Prefix:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="How the callsign STARTS. Cut it wherever you like — 4Z, 4Z4 and 4Z4DX all find 4Z4DX."/>
                    <!-- Widths are recomputed in Window_Loaded to fit exactly 7 and 10 characters of
                         the actual font; these are only the fallback if that measurement is skipped. -->
                    <TextBox x:Name="TB_Prefix" Width="72" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                             ToolTip="How the callsign STARTS. Cut it wherever you like — 4Z, 4Z4 and 4Z4DX all find 4Z4DX."
                             TextChanged="Prefix_TextChanged" KeyDown="SearchField_KeyDown"/>
                    <TextBlock Text="Suffix:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,6,0"
                               ToolTip="How the callsign ENDS: DX, 4DX, SL/M — or the whole call. Either box on its own is enough."/>
                    <TextBox x:Name="TB_Suffix" Width="98" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                             ToolTip="How the callsign ENDS: DX, 4DX, SL/M — or the whole call. Either box on its own is enough."
                             TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Country:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="Type the country name or its ARRL entity number — 336 finds Israel"/>
                    <ComboBox x:Name="CB_Country" Width="210" FontSize="14" VerticalAlignment="Center"
                              IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="280"
                              IsSynchronizedWithCurrentItem="False"
                              ToolTip="Type the country name or its ARRL entity number — 336 finds Israel"
                              PreviewKeyDown="CB_Country_PreviewKeyDown"
                              PreviewTextInput="CB_Country_PreviewTextInput"
                              SelectionChanged="CB_Country_SelectionChanged"
                              KeyUp="CB_Country_KeyUp">
                        <!-- Each row fills the dropdown's full width, so the three parts line up in
                             columns down the list. BasedOn keeps the theme's ComboBoxItem look
                             (highlight, bold selection). -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <!-- Number, flag, then name. This same row is what the CLOSED box shows once a
                             country is picked, and the box is one fixed width: with the name last it
                             is the name that runs out of room (and says so with an ellipsis) while the
                             number and the flag stay readable for every country. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Blank for a country wording no database recognises: better an
                                         empty column than a 0 that reads like an entity number. -->
                                    <TextBlock Grid.Column="0" Text="{Binding CodeText}" VerticalAlignment="Center"
                                               TextAlignment="Right" Margin="0,0,8,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <Image Grid.Column="1" Source="{Binding FlagImage}" Width="24" Height="16"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Frequency:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TB_Freq" Width="84" FontSize="14" VerticalAlignment="Bottom"
                             TextChanged="Freq_TextChanged" KeyDown="SearchField_KeyDown"/>
                    <TextBlock Text="MHz" FontSize="11" FontWeight="Bold" VerticalAlignment="Bottom"
                               Margin="4,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>

                  <!-- Band, Mode and Submode: same panel, so each sits immediately right of the last. -->
                  <StackPanel x:Name="BandGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Band:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CB_Band" Width="90" FontSize="14" VerticalAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                    <TextBlock Text="Mode:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <ComboBox x:Name="CB_Mode" Width="90" FontSize="14" VerticalAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                    <TextBlock Text="Submode:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <!-- Filled from the log, like Band and Mode. It used to offer the full official ADIF
                         submode enumeration (~150 values), which meant scrolling past a hundred and forty
                         choices that could only ever return nothing. -->
                    <ComboBox x:Name="CB_Submode" Width="110" FontSize="14" VerticalAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                  </StackPanel>

                  </StackPanel>

                  <!-- Row 2: name, DX locator, CQ zone, ITU zone, continent, state, Holyland square.
                       Gaps between items are tightened (12px, was 20px) and every box is sized to its
                       real content rather than a generic width. Comment used to end this row and made it
                       the widest thing in the window; it now sits on the QTH row below.

                       All but Name and DX Locator are dropdowns filled from the log itself: the widths
                       here are only the fallback, Window_Loaded measures the real contents. -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="Name:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBox x:Name="TB_Name" Width="150" FontSize="14" VerticalAlignment="Center"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="DX Locator:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="The worked station's grid square, e.g. KM72"/>
                      <TextBox x:Name="TB_Locator" Width="90" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                               ToolTip="The worked station's grid square, e.g. KM72"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="CQ zone:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <!-- Filled from the log, like Band / Mode: the zones offered are the zones worked.
                           Sorted as numbers, so 9 comes before 10 rather than after 1. -->
                      <ComboBox x:Name="CB_CqZone" Width="62" FontSize="14" VerticalAlignment="Center"
                                ToolTip="CQ zones this log actually contains"
                                SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="ITU zone:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox x:Name="CB_ItuZone" Width="62" FontSize="14" VerticalAlignment="Center"
                                ToolTip="ITU zones this log actually contains"
                                SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="Continent:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <!-- Two-letter codes, so the box only needs room for the text + the arrow. Filled from
                           the log; driven and locked by the callsign prefix, like Band is by Frequency. -->
                      <ComboBox x:Name="CB_Continent" Width="72" FontSize="14" VerticalAlignment="Center"
                                ToolTip="EU, NA, SA, AS, AF, OC, AN" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="State:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="The worked station's state / province, e.g. CA"/>
                      <ComboBox x:Name="CB_State" Width="72" FontSize="14" VerticalAlignment="Center"
                                ToolTip="The worked station's state / province — the ones this log contains"
                                SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                      <!-- "Holyland Square" stacked on two lines instead of one wide label, to save the
                           horizontal room a single-line "Holyland Square:" would need. LineHeight tightens
                           the gap between the two words (the font's default line spacing left them looking
                           too far apart), and centers the whole two-line block against the text box. -->
                      <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,6,0"
                                 LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                 ToolTip="Holyland square received (the Exchange column)">
                        <Run Text="Holyland"/><LineBreak/><Run Text="Square:"/>
                      </TextBlock>
                      <ComboBox x:Name="CB_Square" Width="90" FontSize="14" VerticalAlignment="Center"
                                ToolTip="Holyland square received (the Exchange column) — the squares this log contains"
                                SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                  </StackPanel>

                  </StackPanel>
                  </Border>

                  <!-- Row 3: my callsign, operator, my grid, my square - light blue background. -->
                  <Border Background="#DCEBFB" CornerRadius="4" Padding="6,5" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="My callsign:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="The station callsign the QSO was logged UNDER (yours), not the station worked"/>
                      <ComboBox x:Name="CB_MyCall" Width="130" FontSize="14" VerticalAlignment="Center"
                                ToolTip="The station callsign the QSO was logged UNDER (yours), not the station worked"
                                SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="Operator:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBox x:Name="TB_Operator" Width="110" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="My grid:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="Your own grid square"/>
                      <TextBox x:Name="TB_MyGrid" Width="90" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="My square:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="Your sent Holyland square"/>
                      <TextBox x:Name="TB_MySquare" Width="90" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                  </StackPanel>
                  </Border>

                  <!-- Row 4: the confirmation sources - light red background. -->
                  <Border Background="#FBE1E1" CornerRadius="4" Padding="6,5" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Confirmed on:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="LoTW:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox x:Name="CB_Lotw" Width="120" FontSize="14" VerticalAlignment="Center" SelectionChanged="Filter_Changed"
                                ToolTip="Confirmed by the other station in Logbook of The World"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="QRZ:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox x:Name="CB_Qrz" Width="120" FontSize="14" VerticalAlignment="Center" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="eQSL:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox x:Name="CB_Eqsl" Width="120" FontSize="14" VerticalAlignment="Center" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Club Log:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox x:Name="CB_Clublog" Width="120" FontSize="14" VerticalAlignment="Center" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Paper:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox x:Name="CB_Paper" Width="120" FontSize="14" VerticalAlignment="Center" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                  </StackPanel>
                  </Border>

                  <!-- Row 5 (as displayed): prop mode, sat name, soapbox, time, QTH, comment - gray. -->
                  <Border Background="#E3E3E3" CornerRadius="4" Padding="6,5" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="Prop mode:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBox x:Name="TB_PropMode" Width="80" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="Sat name:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBox x:Name="TB_SatName" Width="100" FontSize="14" VerticalAlignment="Center" CharacterCasing="Upper"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="Soapbox:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBox x:Name="TB_Soapbox" Width="150" FontSize="14" VerticalAlignment="Center"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="Time:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="Any part of the QSO time (UTC), e.g. 20 or 2034"/>
                      <TextBox x:Name="TB_Time" Width="80" FontSize="14" VerticalAlignment="Center"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="QTH:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="The worked station's town, e.g. Haifa"/>
                      <TextBox x:Name="TB_Qth" Width="120" FontSize="14" VerticalAlignment="Center"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                    <!-- COMMENT LIVES HERE, not on the identity row above. It is the one box worth having
                         room to read, and AlignCommentBox stretches it to end exactly under Submode - so
                         wherever it sits, its row runs the full width of the panel. On the row above that
                         made every coloured bar as wide as Name + ... + Square + a 288px Comment; here the
                         longest row is row 1, and the bars end just past the Submode box.
                         KEEP IT LAST on this row: AlignCommentBox measures from its left edge outwards. -->
                    <StackPanel x:Name="CommentGroup" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Comment:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="Any part of the QSO's comment text"/>
                      <TextBox x:Name="TB_Comment" Width="288" FontSize="14" VerticalAlignment="Center"
                               ToolTip="Any part of the QSO's comment text"
                               TextChanged="SearchField_TextChanged" KeyDown="SearchField_KeyDown"/>
                    </StackPanel>
                  </StackPanel>
                  </Border>

                  <!-- Row 3: date range, buttons, result count. A Grid with the three groups OVERLAID in
                       one cell (not docked left/right around each other) - each is positioned by its own
                       HorizontalAlignment against the FULL row width, the same width as the coloured rows
                       above. That's what centers Search on the rows above rather than merely in whatever
                       gap happens to be left between the dates and the count pill. -->
                  <Grid Margin="0,6,0,0">
                  <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DP_From" Width="125" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                                SelectedDateChanged="Filter_Changed"/>
                    <TextBlock Text="To:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DP_To" Width="125" FontSize="13" VerticalAlignment="Center"
                                SelectedDateChanged="Filter_Changed"/>
                  </StackPanel>

                  <!-- Result count, in a rounded grey pill at the row's right edge. Grey and border come
                       from theme tokens, not fixed colours, so the pill still looks like a control in the
                       dark schemes instead of a white patch. Always visible: it starts at "0 QSOs" rather
                       than appearing only once a search has been run. -->
                  <Border HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="120" Margin="0,0,4,0"
                          Background="{DynamicResource GridHeaderBg}"
                          BorderBrush="{DynamicResource GridLine}" BorderThickness="1"
                          CornerRadius="10" Padding="14,4,14,4">
                      <TextBlock x:Name="TB_Count" Text="0 QSOs" FontSize="16" FontWeight="Bold"
                                 HorizontalAlignment="Center" TextAlignment="Center"
                                 Foreground="{DynamicResource AccentBrush}"/>
                  </Border>

                  <!-- Search sits on the row's true centre, with Undo/Clear at its sides. -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Undo of a SAVED edit. Ctrl+Z does the same, but a disabled button is the only
                         thing that tells you an undo exists and what it would put back. -->
                    <Button x:Name="Btn_Undo" Content="Undo" FontSize="14" Padding="12,4" Margin="0,0,14,0"
                            IsEnabled="False" Click="Btn_Undo_Click"/>
                    <Button x:Name="Btn_Search" FontSize="14" Padding="16,4"
                            Click="Btn_Search_Click" Background="#1565C0" Foreground="White"
                            BorderBrush="#0D47A1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Stretch="Uniform" Fill="White"
                                      Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            </Viewbox>
                            <TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Btn_Clear" Content="Clear" FontSize="14" Padding="12,4"
                            Click="Btn_Clear_Click" Background="#757575" Foreground="White"
                            BorderBrush="#616161" Cursor="Hand" Margin="8,0,0,0"/>
                  </StackPanel>
                  </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results grid -->
        <!-- The grid and its "Received Confirmation" overlay share this single-cell wrapper on purpose:
             the overlay is positioned by a Margin measured from its parent's origin, so its parent must be
             the same element the header bounds are measured against (see ConfirmationStripHelper.cs).
             ClipToBounds keeps the overlay from spilling outside the grid when columns scroll sideways. -->
        <Grid Grid.Row="2" ClipToBounds="True">
        <DataGrid x:Name="ResultsGrid"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  AlternationCount="2"
                  Background="{DynamicResource WindowBg}"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionUnit="FullRow"
                  FontSize="16"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3"
                  BeginningEdit="ResultsGrid_BeginningEdit"
                  PreparingCellForEdit="ResultsGrid_PreparingCellForEdit"
                  CellEditEnding="ResultsGrid_CellEditEnding"
                  RowEditEnding="ResultsGrid_RowEditEnding"
                  Sorting="ResultsGrid_Sorting"
                  PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown"
                  CheckBox.Checked="PaperQsl_Changed" CheckBox.Unchecked="PaperQsl_Changed"
                  VerticalGridLinesBrush="{DynamicResource GridLine}" HorizontalGridLinesBrush="{DynamicResource GridLine}">
            <DataGrid.Resources>
                <!-- Scoped to this grid, exactly as the Channels window does it: a very light blue
                     selection so the band-coloured Frequency and Band text (green on 40M, etc.) stays
                     readable. The app-wide SelectionBg is a strong #3399FF that swallowed it.
                     SelectionText is dark so the plain columns still read on the light row. -->
                <SolidColorBrush x:Key="SelectionBg" Color="#CFE8FF"/>
                <SolidColorBrush x:Key="SelectionText" Color="#1A1A1A"/>

                <!-- In THIS table the tick boxes are the only thing that highlights a row, so the
                     cells must not paint themselves as well.
                     WHY: clicking a tick box also makes the DataGrid select the row it sits in -
                     unavoidable, the box is inside a cell. The app-wide DataGridCell style (see
                     Themes/Controls.xaml) colours every selected CELL, and that colour is not tied
                     to the tick: unticking the row cleared IsPicked and the row's own background
                     went back to normal, but the cells stayed blue, so the row still looked ticked.
                     Cleared here only - every other grid in the program keeps the standard
                     click-to-highlight, because there the click IS the selection. -->
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <!-- The BORDER matters as much as the fill: WPF's own DataGridCell template
                                 outlines a selected cell in the Windows highlight colour (#0078D7), and
                                 clearing only the background left every cell of the row framed in blue -
                                 a row that still looked ticked, drawn as an outline instead of a block.
                                 Set to the grid-line colour, not Transparent, so a selected row keeps the
                                 same vertical rules as every other row. -->
                            <Setter Property="BorderBrush" Value="{DynamicResource GridLine}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- The grid's own header look (tan background, sort arrow, resize grippers), named so the
                     5 confirmation columns can inherit ALL of it and override only what the green strip
                     needs. Defined as a keyed style and applied implicitly below, so normal columns are
                     unaffected. -->
                <Style x:Key="WorkshopHeaderBase" TargetType="DataGridColumnHeader">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,3"/>
                    <Setter Property="Padding" Value="5,3,5,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#DEB887"/>
                    <!-- Tan header keeps its light-mode look in both modes, so the text on it must
                         stay dark even when the dark theme's TextBrush turns white. -->
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                    <!-- Sort arrow on the column currently sorted, the same triangle and placement as
                         the cluster table's headers, so the two tables read alike. -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Margin="{TemplateBinding Padding}"/>
                                            <Path x:Name="SortArrow"
                                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                                  Fill="#000000" Stretch="Uniform" Width="8" Height="6"
                                                  Data="M 0,0 L 1,1 L 2,0 Z"
                                                  Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleY="1"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="4" Cursor="SizeWE">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" Padding="0"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="4" Cursor="SizeWE">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" Padding="0"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="SortArrow" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="SortArrow" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleY="-1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Header style for the 5 confirmation columns only: inherits everything above (tan
                     background, sort arrow, grippers) and only drops the padding / right border and
                     stretches the content, so each column's own green upper-half band touches the next
                     one exactly - reading as ONE continuous strip across the group rather than 5 separate
                     green rectangles with tan seams between them. -->
                <Style x:Key="ConfirmHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkshopHeaderBase}">
                    <Setter Property="BorderThickness" Value="0,0,0,3"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkshopHeaderBase}"/>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <!-- ALL THREE row colours are set here, and none of them on the DataGrid itself.
                     That is deliberate: DataGrid.RowBackground / AlternatingRowBackground are pushed
                     onto every row by a transfer that compares value precedence, and a colour set on the
                     grid element is a LOCAL value - it outranks any trigger in this style. Leaving the
                     two properties on the grid is what stopped a ticked row from ever changing colour.
                     With the grid no longer setting them, the plain / alternate / ticked colours are just
                     ordinary setters and triggers here, and the last matching trigger wins. -->
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource GridRowBg}"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource GridAltRowBg}"/>
                        </Trigger>
                        <!-- Ticked LAST, so it beats both of the above. Every ticked row is highlighted,
                             in the same pale blue a selected row has always had here - tick ten rows and
                             all ten stay lit, not just the last one clicked. The dark selection text
                             comes with it, which is what keeps the row readable on that light blue when
                             the application is in a dark scheme. -->
                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RowPickedBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- SELECTION COLUMN. The one column that belongs on the LEFT rather than at the far
                     right, because it is not log data - it is the handle you tick, and that is where a
                     mail client puts it.

                     IsReadOnly so a click lands on the checkbox instead of putting the cell into edit
                     mode, and unsortable / unmovable / unresizable so it stays exactly where the eye
                     expects it. Selecting is done ONLY from these boxes: clicking anywhere else in a row
                     never adds or drops a row, so a selection cannot be lost by a stray click. -->
                <DataGridTemplateColumn x:Name="Col_Pick" Width="38" MinWidth="38" IsReadOnly="True"
                                        CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <!-- Master box: nothing ticked -> ticks every row the search is showing;
                             anything ticked -> clears the lot. Three-state so a partial selection shows
                             the filled square instead of claiming everything is selected. -->
                        <CheckBox x:Name="Chk_PickAll" IsThreeState="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Click="Chk_PickAll_Click"
                                  ToolTip="Select all the rows listed, or clear the selection"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Tag marks this as the selection box: the grid-wide CheckBox.Checked
                                 handler (PaperQsl_Changed) fires for EVERY checkbox in the table, and
                                 must not mistake a tick here for a paper QSL card arriving. -->
                            <CheckBox Tag="PickBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsPicked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Click="PickBox_Click"
                                      ToolTip="Select this QSO&#x0a;Shift+click another box to select everything between the two"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Date and Time are editable, but only accept a value that parses. The converters'
                     ConvertBack returns Binding.DoNothing for anything else, so a typo leaves the
                     logged value untouched instead of writing nonsense into the log. -->
                <DataGridTemplateColumn x:Name="Col_Date" Header="Date" SortMemberPath="Date" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Date, Converter={StaticResource QsoDateDisplayConverter}}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox HorizontalContentAlignment="Center" BorderThickness="0" ToolTip="dd-MM-yyyy">
                                <TextBox.Text>
                                    <Binding Path="Date" Mode="TwoWay" UpdateSourceTrigger="LostFocus"
                                             Converter="{StaticResource QsoDateDisplayConverter}"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <local:QsoDateRule/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Time" SortMemberPath="Time" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Time, Converter={StaticResource QsoTimeDisplayConverter}}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox HorizontalContentAlignment="Center" BorderThickness="0" ToolTip="HH:mm:ss (UTC)">
                                <TextBox.Text>
                                    <Binding Path="Time" Mode="TwoWay" UpdateSourceTrigger="LostFocus"
                                             Converter="{StaticResource QsoTimeEditConverter}"
                                             NotifyOnValidationError="True">
                                        <Binding.ValidationRules>
                                            <local:QsoTimeRule/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Callsign" IsReadOnly="True" SortMemberPath="DXCall" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Same LoTW tint as the log table and the cluster, under the same option.
                                 QRZ is opened from the right-click menu (not a left-click), so no hand
                                 cursor / click handler here. -->
                            <TextBlock Text="{Binding DXCall}" HorizontalAlignment="Center" Padding="5,0,5,0" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="ToolTip" Value="Click to open this station's QRZ page"/>
                                        <Style.Triggers>
                                            <!-- LoTW-user tint only (same highlight as the log table / cluster);
                                                 no tooltip override, so it keeps the "open QRZ" hint. -->
                                            <DataTrigger Binding="{Binding DXCall, Converter={StaticResource LotwUserConverter}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowLotwBg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Editable columns. Each keeps its display template and gains a CellEditingTemplate,
                     so the cell looks exactly as before until you actually edit it. -->
                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, Mode=TwoWay}" HorizontalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <!-- Country is NOT editable: it is decided by the callsign's DXCC prefix, not typed.
                     Typing over it would let the country disagree with the callsign, which is the kind
                     of error awards and statistics are counted from. -->
                <DataGridTemplateColumn Header="Country" IsReadOnly="True" SortMemberPath="Country" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Country}" HorizontalAlignment="Center" Padding="5,0,5,0"
                                       ToolTip="Set from the callsign's DXCC prefix — not editable"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Frequency" SortMemberPath="Freq" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Freq}" Foreground="{Binding Band, Converter={StaticResource BandColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Freq, Mode=TwoWay}" HorizontalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Band" SortMemberPath="Band" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Band}" Foreground="{Binding Band, Converter={StaticResource BandColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <!-- Dropdown, not free text: the same band list the Bad-QSO editor offers, so a
                         band can only ever be one the rest of the program recognises. -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Band, Mode=TwoWay}" IsEditable="False"
                                      ItemsSource="{Binding Source={x:Static local:SearchWindow.KnownBands}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RST-R" SortMemberPath="RST_RCVD" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RST_RCVD}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding RST_RCVD, Mode=TwoWay}" HorizontalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RST-S" SortMemberPath="RST_SENT" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RST_SENT}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding RST_SENT, Mode=TwoWay}" HorizontalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mode" SortMemberPath="Mode" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Mode, Mode=TwoWay}" IsEditable="False"
                                      ItemsSource="{Binding Source={x:Static local:SearchWindow.KnownModes}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Exchange" SortMemberPath="SRX" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SRX}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding SRX, Mode=TwoWay}" HorizontalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <!-- Star width so Comment absorbs spare space, but with a MINIMUM so it cannot be
                     squeezed away. Without the minimum a star column silently swallows every shortage:
                     the row can never be wider than the viewport, so the horizontal scrollbar never
                     appears and Comment just gets thinner each time a column is added. With it, the
                     grid overflows once there is not enough room and the scrollbar does its job. -->
                <DataGridTemplateColumn Header="Comment" SortMemberPath="Comment" Width="*" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Comment}" HorizontalAlignment="Center" Padding="5,0,5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Comment, Mode=TwoWay}" HorizontalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- LAST COLUMN, and new columns go after it, never among the existing ones: inserting
                     into the middle moves every column the operator has learned the position of. It has
                     to come after Comment specifically, because Comment is the star-width column that
                     absorbs the spare space - anything before it would not sit at the right edge.

                     The five confirmation columns. Their look (green header strip, tick colours,
                     tooltips) is defined ONCE in Themes/ConfirmationColumns.xaml and shared with the main
                     window's table, so a change is made in one place. ConfirmHeaderStyle stays declared
                     locally above (BasedOn this grid's own sort-arrow header template), since the shared
                     one cannot know about a template that only this grid has.

                     They are draggable, but only as one block and with nothing allowed between them -
                     ConfirmationColumnGroup enforces that, since a column dropped in the middle would
                     split the green strip. -->
                <DataGridTemplateColumn Header="LoTW" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="LotwStatusRank" Width="Auto" MinWidth="42"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource LotwTickTemplate}"/>
                <DataGridTemplateColumn Header="QRZ" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="QrzStatusRank" Width="Auto" MinWidth="36"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource QrzTickTemplate}"/>
                <DataGridTemplateColumn Header="eQSL" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="EqslStatusRank" Width="Auto" MinWidth="42"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource EqslTickTemplate}"/>
                <DataGridTemplateColumn Header="Club Log" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="ClublogStatusRank" Width="Auto" MinWidth="68"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource ClublogTickTemplate}"/>
                <DataGridTemplateColumn Header="Paper QSL" IsReadOnly="True" CanUserResize="False"
                                        SortMemberPath="PaperQslStatusRank" Width="Auto" MinWidth="76"
                                        HeaderStyle="{StaticResource ConfirmHeaderStyle}"
                                        HeaderTemplate="{StaticResource ConfirmHeaderTemplate}"
                                        CellTemplate="{StaticResource PaperQslTemplate}"/>

                <!-- Activity programs, at the far right so no existing column moves. Read-only: a QSO
                     can carry several references at once and they belong in different ADIF fields, so
                     one cell cannot sensibly be typed into. They are edited in the row's own editor
                     (right-click, or double-click the row), which has a box for each. -->
                <DataGridTemplateColumn Header="Activity" IsReadOnly="True" SortMemberPath="ActivitySummary"
                                        Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ActivitySummary}" HorizontalAlignment="Center"
                                       Padding="5,0,5,0" ToolTip="{Binding ActivitySummary}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- THE AWARD / QSL RECORD imported from the operator's previous program, appended at the
                     far right so no existing column moves. Read-only here: these are a record of what has
                     already happened (the ARRL granted a credit; a card went via a manager), not something
                     to be typed over in a grid.
                     DXCC Credit is the headline: it is the ARRL's own verdict, it exists in no other field,
                     and before 8.8.4 HolyLogger discarded it at import. -->
                <DataGridTemplateColumn Header="DXCC Credit" IsReadOnly="True" SortMemberPath="CreditGranted"
                                        Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CreditGranted}" Padding="5,0,5,0"
                                       ToolTip="{Binding CreditGranted}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="County" IsReadOnly="True" SortMemberPath="Cnty"
                                        Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Cnty}" Padding="5,0,5,0" ToolTip="{Binding Cnty}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="QSL Via" IsReadOnly="True" SortMemberPath="QslVia"
                                        Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding QslVia}" Padding="5,0,5,0" ToolTip="{Binding QslVia}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Contest" IsReadOnly="True" SortMemberPath="ContestId"
                                        Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ContestId}" Padding="5,0,5,0" ToolTip="{Binding ContestId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- ADIF QTH: the worked station's town. Far right, so no existing column moves. -->
                <DataGridTemplateColumn Header="QTH" IsReadOnly="True" SortMemberPath="Qth"
                                        Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Qth}" Padding="5,0,5,0" ToolTip="{Binding Qth}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Spans the combined width of the LoTW..Paper QSL header group with one line of text - see
             ConfirmationStripHelper.cs for why an overlay is needed rather than per-column text. Kept
             non-hit-testable so clicks still reach the header underneath (e.g. to sort). -->
        <Border x:Name="ConfirmationStripLabel" IsHitTestVisible="False" Panel.ZIndex="50"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                TextElement.FontSize="11" TextElement.FontWeight="Bold" TextElement.Foreground="#1A1A1A">
            <!-- The letters are created by ConfirmationStripHelper (they are spread apart at runtime to
                 fill the strip's width), and inherit the font settings above. -->
        </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TB_Status" Grid.Column="0" FontSize="13" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Enter a Callsign or Country (or both) and press Search."/>
                <!-- How many rows are ticked. Hidden entirely while nothing is selected, so the bar looks
                     exactly as it did before the moment there is nothing to report. -->
                <TextBlock x:Name="TB_PickCount" Grid.Column="1" FontSize="13" FontWeight="Bold"
                           Margin="12,0,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
