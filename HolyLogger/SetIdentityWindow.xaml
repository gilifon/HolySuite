<Window x:Class="HolyLogger.SetIdentityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set log identity" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" Grid.Row="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap" Text="Set this log's identity"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#666666"
                   Text="This is the station callsign and operator this log belongs to. It decides which QSOs are copied to or from it, and it is set once — it cannot be changed afterward."/>

        <StackPanel x:Name="CandidatePanel" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Found in this log:" FontSize="13"/>
            <ComboBox x:Name="CB_Candidates" Margin="0,4,0,0" FontSize="14" DisplayMemberPath="Display"
                      SelectionChanged="CB_Candidates_SelectionChanged"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Station callsign" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="TB_Callsign" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" FontSize="14" Padding="4,3" CharacterCasing="Upper"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Operator" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="TB_Operator" Grid.Row="1" Grid.Column="1" FontSize="14" Padding="4,3" CharacterCasing="Upper"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Btn_Cancel" Content="Cancel" Width="100" Height="32" FontSize="14" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="Btn_Ok" Content="Save (permanent)" Width="150" Height="32" FontSize="14" FontWeight="Bold"
                    IsDefault="True" Click="Btn_Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
