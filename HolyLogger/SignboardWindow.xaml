<Window x:Name="SignboardWindow1" x:Class="HolyLogger.SignboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signboard" Height="251" Width="355" Icon="Images/sign.png" LocationChanged="SignboardWindow1_LocationChanged" SizeChanged="SignboardWindow1_SizeChanged">
    <Grid x:Name="LayoutGrid">
        <!-- Three equal rows. Left: the label in the ordinary font, centred up and down against its
             line, on two rows where it is two words. Right: the line itself in the big Arial Black,
             scaled to fill the rest of the row. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Callsign" FontSize="16"
                   VerticalAlignment="Center" Margin="8,0,8,0"/>
        <Viewbox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Callsign}" FontFamily="Arial Black" FontWeight="Bold" />
        </Viewbox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Holyland&#10;Square" FontSize="16"
                   VerticalAlignment="Center" Margin="8,0,8,0"/>
        <Viewbox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Square}" FontFamily="Arial Black" FontWeight="Bold" />
        </Viewbox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="My&#10;Locator" FontSize="16"
                   VerticalAlignment="Center" Margin="8,0,8,0"/>
        <Viewbox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Locator}" FontFamily="Arial Black" FontWeight="Bold" />
        </Viewbox>
    </Grid>
</Window>
