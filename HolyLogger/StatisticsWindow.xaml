<Window x:Class="HolyLogger.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Statistics &amp; Confirmations"
        Height="940" Width="950"
        MinHeight="600" MinWidth="940"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource GridHeaderBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2" Padding="10,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                          Data="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"/>
                </Viewbox>
                <TextBlock Text="Log Statistics &amp; Confirmations" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Background="{DynamicResource WindowBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- left: static log analysis + pivot -->
                    <ColumnDefinition Width="*"/>       <!-- right: the per-source page (tabs + content) -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>      <!-- top: tab strip (right) / free space (left) -->
                    <RowDefinition Height="*"/>          <!-- the content, pushed down below the tabs -->
                </Grid.RowDefinitions>

                <!-- Above the left column: the name of the log these statistics are for. Wraps (MaxWidth)
                     so even a long name shows in full without widening the column. -->
                <!-- Panel.ZIndex on THIS Border, not on the tab strip inside it: ZIndex only orders
                     siblings, and the left page frame below is this Border's sibling. Without it the
                     frame paints over the tabs and the selected one cannot hide the line beneath it,
                     which is the whole trick that makes a tab and its page read as one sheet. -->
                <Border Grid.Row="0" Grid.Column="0" x:Name="LeftTopSpacer" Panel.ZIndex="1">
                    <!-- Log name on top, the QSO/DXCC folder tabs along the bottom edge. Bottom-aligned
                         on purpose: the source tabs on the right are bottom-aligned too, so the two
                         strips meet on one line however tall this row grows. -->
                    <Grid Margin="14,2,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Text="Log file:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock x:Name="TB_LogName" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <!-- What the table below is counting: contacts, or countries. Same look as the
                             source folders opposite, so the two strips read as one row of tabs. -->
                        <ListBox x:Name="LB_LeftView" Grid.Row="1" Panel.ZIndex="1" Margin="0,6,0,0"
                                 BorderThickness="0" Background="Transparent" ClipToBounds="False"
                                 SelectionChanged="LB_LeftView_SelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" ClipToBounds="False"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="20,7,20,7"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <!-- Both tabs the same width. Selecting one makes it BOLD, which is
                                         wider than the same word unselected, so without a fixed width the
                                         strip - and with it the whole left column - would breathe in and
                                         out as you switch, shoving the source folders sideways. -->
                                    <Setter Property="MinWidth" Value="92"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                        BorderThickness="1" CornerRadius="7,7,0,0"
                                                        Margin="2,0,0,0" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0"/>
                                                        <Setter TargetName="Bd" Property="Margin" Value="2,0,0,-2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Horizontal "folder" tabs across the top of the per-source page. The SELECTED tab takes
                     its source colour and drops its bottom edge (a -1 margin) so it overlaps the page's top
                     border and reads as one piece with the page below it. Panel.ZIndex keeps it on top. -->
                <!-- VerticalAlignment=Bottom so this strip sits on the same line as the QSO/DXCC strip
                     on the left, whatever height the log name gives that row. -->
                <ListBox x:Name="LB_Source" Grid.Row="0" Grid.Column="1" Panel.ZIndex="1" Margin="8,6,8,0"
                         VerticalAlignment="Bottom"
                         BorderThickness="0" Background="Transparent" ClipToBounds="False"
                         SelectionChanged="LB_Source_SelectionChanged">
                    <!-- Plain items host (no ScrollViewer), so the selected tab's 1px overhang is NOT
                         clipped and can cover the page's top border below it. -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" ClipToBounds="False"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,7,20,7"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Every tab always wears its own source colour (bound to the item's
                                             Background), so the strip reads as coloured folders at rest.
                                             Selected tab: bold, accent border, NO bottom border, -2 bottom
                                             margin so it overlaps and hides the page top border under it —
                                             same height, so the selected tab reaches that line. -->
                                        <Border x:Name="Bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1" CornerRadius="7,7,0,0"
                                                Margin="2,0,0,0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0"/>
                                                <Setter TargetName="Bd" Property="Margin" Value="2,0,0,-2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Col 0: the LEFT PAGE, framed on all four sides exactly like the per-source page
                     opposite, so the QSO/DXCC tabs above read as folders on one sheet. The selected tab
                     carries a -2 bottom margin and hides the top border directly under it.
                     Left/right margins match the tab strip's own (14 / 12) so the frame and the tabs
                     share an edge. -->
                <Border Grid.Row="1" Grid.Column="0" Margin="14,0,12,8"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <ScrollViewer x:Name="SV_LeftContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Top" Margin="12,10,12,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Margin="0,0,14,0" Padding="18,8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Total QSOs" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TB_TotalQSOs" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,14,0" Padding="18,8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <StackPanel>
                                    <!-- This tile changes with the left folder: unique callsigns worked on
                                         the QSO folder, countries on the DXCC one (see ApplyLeftView). -->
                                    <TextBlock x:Name="TB_UniqueCallsLabel" Text="Unique Calls" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TB_UniqueCalls" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="14,8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Date Range" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Start " FontSize="14" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TB_DateStart" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="End   " FontSize="14" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TB_DateEnd" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                            <!-- THE QSO FOLDER. Shown when the QSO tab is selected.
                                 Inner PivotBorder: left+top edge in blue (1px).
                                 Outer PivotOuterBorder: right+bottom edge in black (2px).
                                 Cell grid is built entirely in code-behind (BuildPivot).
                                 PivotOuterBorder.ActualHeight drives the country-table scroll heights. -->
                            <StackPanel x:Name="QsoViewPanel">
                                <TextBlock x:Name="TB_PivotHeader" Text="QSOs by Bands &amp; Mode" FontSize="16" FontWeight="Bold"
                                           Margin="0,0,0,6" Foreground="{DynamicResource AccentBrush}"/>
                                <Border x:Name="PivotOuterBorder" HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="2">
                                    <Border x:Name="PivotBorder"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"/>
                                </Border>
                                <TextBlock x:Name="TB_DataQuality"
                                           Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource Danger}"
                                           FontStyle="Italic" TextWrapping="Wrap" MaxWidth="390"/>
                                <Button x:Name="BTN_EditProblems" Content="Edit Problem QSOs…"
                                        Margin="0,6,0,0" Padding="10,4" FontSize="13"
                                        Visibility="Collapsed" Click="BTN_EditProblems_Click"/>
                            </StackPanel>

                            <!-- THE DXCC FOLDER. The same table, counting COUNTRIES instead of contacts,
                                 for whichever SOURCE folder is selected opposite. Shares this space with
                                 the QSO table rather than sitting under it. No percentage pair: a country
                                 belongs to every cell it was worked in, so percentages would come to
                                 several hundred (see the note below the table). -->
                            <StackPanel x:Name="DxccViewPanel" Visibility="Collapsed">
                                <!-- Wrapped and capped at the width of the tables below: this heading
                                     carries the source name ("… — Club Log"), and left free to grow it
                                     would widen the whole left column and move the source folders. -->
                                <TextBlock x:Name="TB_CountryPivotHeader" Text="Countries by Bands &amp; Mode" FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap" MaxWidth="390" HorizontalAlignment="Left"
                                           Margin="0,0,0,6" Foreground="{DynamicResource AccentBrush}"/>
                                <Border x:Name="CountryPivotOuterBorder" HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="2">
                                    <Border x:Name="CountryPivotBorder" BorderBrush="Transparent" BorderThickness="0"/>
                                </Border>
                                <TextBlock x:Name="TB_CountryPivotNote" Margin="0,5,0,0" FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}" FontStyle="Italic"
                                           TextWrapping="Wrap" MaxWidth="390"/>
                            </StackPanel>

                            <!-- Shown only when the country file is overdue for a refresh. -->
                            <TextBlock x:Name="TB_CtyWarning" Foreground="{DynamicResource Danger}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="2,8,2,0" MaxWidth="390" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                    <!-- The per-source PAGE (Row 1, Col 1): framed on all four sides. The selected tab
                         overlaps and hides the TOP border directly under it (a -1 margin + matching tint),
                         so the top border shows everywhere except under the active tab - one sheet.
                         The tint is set in code. -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="8,0,8,8"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="SV_SourceContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Horizontal" Margin="12,10,12,10" VerticalAlignment="Top">

                            <!-- COL A: source tiles + the two big country lists. The lists sit directly
                                 under the SHORT tiles, so they line up with the pivot table on the left. -->
                            <StackPanel Orientation="Vertical">
                            <StackPanel x:Name="TilesRow" Orientation="Horizontal" Margin="0,0,0,10">
                                <!-- Confirmed is the headline number for a source, so it is leftmost.
                                     Confirmed + Missing partition all DXCC entities (out of 340). Hidden
                                     on the Worked folder, which has no confirmation. -->
                                <!-- All three tiles share one fixed label width and a fixed-height label area
                                     (labels centered, wrapping to two lines), so the tiles stay equal-width
                                     and their big numbers line up even though "Worked Countries, not
                                     confirmed" wraps and the others do not. -->
                                <Border x:Name="TileConfirmed" Margin="0,0,14,0" Padding="18,8" VerticalAlignment="Top" Background="{DynamicResource PanelBg}" BorderBrush="#2E9E4F" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Height="44">
                                            <TextBlock x:Name="TB_ConfirmedTileLabel" Text="Confirmed Countries" Width="150" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="TB_ConfirmedDxcc" FontSize="30" FontWeight="Bold" Foreground="#2E9E4F" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,14,0" Padding="18,8" VerticalAlignment="Top" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Height="44">
                                            <TextBlock x:Name="TB_WorkedTileLabel" Text="Worked Countries, not confirmed" Width="150" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="TB_UniqueCountries" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="18,8" VerticalAlignment="Top" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Danger}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Height="44">
                                            <TextBlock x:Name="TB_MissingTileLabel" Text="Missing Countries" Width="150" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="TB_MissingDxcc" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- The country / zone tables, laid out in a row. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                            <!-- Worked Countries -->
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Top">
                                <!-- Fixed-height header block so this table lines up with the Missing /
                                     Zones tables, which have their own fixed-height headers. Header + LoTW
                                     button on one row; the status wraps on its own line below. -->
                                <StackPanel Height="54">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="TB_WorkedHeader" Text="Worked Countries"
                                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button x:Name="BTN_CheckLotw" Content="Check LoTW Updates" FontSize="12" Padding="8,3"
                                                VerticalAlignment="Center" Click="BTN_CheckLotw_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock FontSize="16" TextWrapping="Wrap" MaxWidth="340"
                                                               Text="Fetches only what is NEW since your last check — the quick, everyday update, and marks those QSOs.&#10;&#10;To rebuild from scratch instead, use “Get All LoTW Confirmations” below."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="TB_LotwStatus" FontSize="16" FontWeight="Bold" MaxWidth="345"
                                               HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="#2E9E4F"/>
                                </StackPanel>
                                <!-- Grid so the loading overlay can sit on top of the worked table. -->
                                <Grid>
                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,2,2">
                                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,0,0">
                                        <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource GridHeaderBg}"
                                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                                <TextBlock Width="30"/>
                                                <TextBlock x:Name="TB_SortWorkedName" Text="Country ▲"
                                                           Width="160" FontSize="13" FontWeight="Bold"
                                                           Cursor="Hand" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TB_SortWorkedCount" Text="Count ▼"
                                                           Width="50" FontSize="13" FontWeight="Bold"
                                                           Cursor="Hand" TextAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TB_SortWorkedConfirmed" Text="Conf."
                                                           Width="70" FontSize="13" FontWeight="Bold" Margin="10,0,0,0"
                                                           Cursor="Hand" TextAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ScrollViewer x:Name="SV_WorkedCountries"
                                                      VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="True"
                                                      MaxHeight="500">
                                            <ItemsControl x:Name="IC_WorkedCountries"
                                                          VirtualizingStackPanel.IsVirtualizing="True"
                                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                                                                Background="{Binding RowBg}"
                                                                Cursor="Hand" MouseLeftButtonUp="WorkedCountry_Click"
                                                                ToolTip="Click to search all QSOs with this country">
                                                            <StackPanel Orientation="Horizontal" Margin="4,1,4,1">
                                                                <Image Source="{Binding FlagImage}"
                                                                       Width="24" Height="16"
                                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                                       Stretch="Fill"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Width="160"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding CountStr}" FontSize="13"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           TextAlignment="Right" Width="50"
                                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                                <TextBlock Text="{Binding ConfirmedMark}" FontSize="16"
                                                                           FontWeight="Bold" Margin="10,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           TextAlignment="Center" Width="70"
                                                                           Foreground="{Binding ConfirmedBrush}"
                                                                           ToolTip="{Binding ConfirmedTip}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Border>

                                <!-- Loading overlay: dims the table and shows an indeterminate (marquee)
                                     progress bar while confirmations download. LoTW streams a dynamically
                                     generated report with no total size, so a true percentage isn't
                                     possible; the marquee shows live activity so the wait doesn't look
                                     frozen. Collapsed except during a download. -->
                                <Border x:Name="LotwLoadingOverlay" Visibility="Collapsed"
                                        Background="{DynamicResource WindowBg}" Opacity="0.9"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                        <TextBlock x:Name="TB_LotwLoadingText" Text="Downloading confirmations from LoTW…"
                                                   FontSize="15" FontWeight="Bold" TextAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="TB_LotwLoadingSub" Text="This one-time full download can take a minute."
                                                   FontSize="12" TextAlignment="Center" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <!-- Spinner: a faint full ring with a brighter arc on top that
                                             rotates (animated from code in show/hide). -->
                                        <Grid Width="46" Height="46" Margin="0,16,0,0" HorizontalAlignment="Center">
                                            <Ellipse Width="46" Height="46" StrokeThickness="5" Opacity="0.2"
                                                     Stroke="{DynamicResource AccentBrush}"/>
                                            <Ellipse x:Name="SpinnerArc" Width="46" Height="46" StrokeThickness="5"
                                                     Stroke="{DynamicResource AccentBrush}" StrokeStartLineCap="Round"
                                                     StrokeEndLineCap="Round" StrokeDashArray="7 30"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                        <Button x:Name="BTN_StopCheck" Content="Stop" FontSize="13" Padding="16,4"
                                                Margin="0,16,0,0" HorizontalAlignment="Center"
                                                Click="BTN_StopCheck_Click"/>
                                    </StackPanel>
                                </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Missing Countries -->
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="TB_MissingHeader" Text="Missing Countries" Height="54"
                                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Danger}"/>
                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,2,2">
                                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,0,0">
                                        <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource GridHeaderBg}"
                                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                                <TextBlock Width="30"/>
                                                <TextBlock x:Name="TB_SortMissingName" Text="Country ▲"
                                                           Width="130" FontSize="13" FontWeight="Bold"
                                                           Cursor="Hand" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ScrollViewer x:Name="SV_MissingCountries"
                                                      VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="True"
                                                      MaxHeight="500">
                                            <ItemsControl x:Name="IC_MissingCountries"
                                                          VirtualizingStackPanel.IsVirtualizing="True"
                                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                                                                Background="{Binding RowBg}">
                                                            <StackPanel Orientation="Horizontal" Margin="4,1,4,1">
                                                                <Image Source="{Binding FlagImage}"
                                                                       Width="24" Height="16"
                                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                                       Stretch="Fill"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Width="130"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </StackPanel>

                            </StackPanel>   <!-- close the Worked + Missing lists row -->
                            </StackPanel>   <!-- close COL A -->

                            <!-- COL B: the LoTW summary panel on top, then the zone lists. This column is
                                 taller than the tiles, so the zones sit lower than the country lists. -->
                            <StackPanel Orientation="Vertical" Margin="20,0,0,0">

                                <!-- Slot that always reserves the tiles' height above the zones (even when
                                     the LoTW panel is hidden). So on Worked / QRZ the zone lists line up
                                     with the country lists; on LoTW the taller panel grows the slot and the
                                     zones drop below it. -->
                                <Border x:Name="LotwSlot" MinHeight="{Binding ActualHeight, ElementName=TilesRow}">
                                <!-- No title: this frame only ever shows on the LoTW folder. Tight rows. -->
                                <Border x:Name="ConfirmSummaryPanel" Padding="10,6"
                                        VerticalAlignment="Top" CornerRadius="3"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        Background="{DynamicResource GridAltRowBg}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TB_SumConfirmedLabel" Text="Confirmed at LoTW" FontSize="13"
                                                   Margin="0,0,18,1" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TB_SumTotalQsls" FontSize="14"
                                                   FontWeight="Bold" Margin="0,0,0,1" VerticalAlignment="Center"
                                                   Foreground="#2E9E4F"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Matched in this log" FontSize="13"
                                                   Margin="0,0,18,1" VerticalAlignment="Center"
                                                   ToolTip="Confirmations that matched a QSO in the log open now, and carry the LoTW tick"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TB_SumMatchedInLog" FontSize="14"
                                                   FontWeight="Bold" Margin="0,0,0,1" VerticalAlignment="Center"
                                                   Foreground="#2E9E4F"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="TB_NewConfLabel" Text="New confirmations" FontSize="13"
                                                   Margin="0,0,18,1" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TB_NewConfValue" FontSize="14" Margin="0,0,0,1"
                                                   VerticalAlignment="Center"><Hyperlink x:Name="LNK_NewQsls" Click="NewQsls_Click"
                                                   ToolTip="Click to see the new confirmations"><Run x:Name="TB_SumNewQsls" FontWeight="Bold"/></Hyperlink><Run x:Name="TB_SumSince" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/></TextBlock>

                                        <TextBlock Grid.Row="3" Grid.Column="0" x:Name="TB_NewCountriesLabel" Text="New countries" FontSize="13"
                                                   Margin="0,0,18,1" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TB_NewCountriesValue" FontSize="14" Margin="0,0,0,1"
                                                   VerticalAlignment="Center"><Hyperlink x:Name="LNK_NewCountries" Click="NewCountries_Click"
                                                   ToolTip="Click to see the QSOs that gave a new country"><Run x:Name="TB_SumNewCountries" FontWeight="Bold"/></Hyperlink></TextBlock>

                                        <!-- The source's full-download button lives in the frame; only the one for the
                                             current folder is shown. (LoTW also keeps "Check LoTW Updates" in the header.) -->
                                        <Button x:Name="BTN_GetAllConfirmations" Grid.Row="4" Grid.ColumnSpan="2"
                                                Content="Get All LoTW Confirmations" FontSize="12" Padding="8,3"
                                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Click="BTN_GetAllConfirmations_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock FontSize="16" TextWrapping="Wrap" MaxWidth="340"
                                                               Text="Rebuild from scratch: downloads your ENTIRE LoTW history and re-marks every log. Slower, and needed only once — to fill in past years.&#10;&#10;For routine updates use “Check LoTW Updates” above."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button x:Name="BTN_CheckQrz" Grid.Row="4" Grid.ColumnSpan="2"
                                                Content="Get All QRZ Confirmations" FontSize="12" Padding="8,3"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"
                                                Click="BTN_CheckQrz_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock FontSize="16" TextWrapping="Wrap" MaxWidth="340"
                                                               Text="Downloads every confirmed QSO from your QRZ.com logbook and marks them with the QRZ tick.&#10;&#10;Needs your QRZ Logbook API key (Options ▸ QRZ Logbook)."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button x:Name="BTN_CheckEqsl" Grid.Row="4" Grid.ColumnSpan="2"
                                                Content="Get All eQSL Confirmations" FontSize="12" Padding="8,3"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"
                                                Click="BTN_CheckEqsl_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock FontSize="16" TextWrapping="Wrap" MaxWidth="340"
                                                               Text="Downloads your eQSL In Box (the cards other stations sent you) for every eQSL account and marks the confirmed QSOs.&#10;&#10;Uses the accounts in Options ▸ eQSL."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button x:Name="BTN_CheckClublog" Grid.Row="4" Grid.ColumnSpan="2"
                                                Content="Get All Club Log Confirmations" FontSize="12" Padding="8,3"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"
                                                Click="BTN_CheckClublog_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock FontSize="16" TextWrapping="Wrap" MaxWidth="340"
                                                               Text="Downloads your Club Log log (getadif) for every station callsign you have used and marks the QSOs Club Log reports confirmed (QSL received).&#10;&#10;Uses the account in Options ▸ Club Log."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </Grid>
                                </Border>
                                </Border>

                                <!-- Zone lists (CQ + ITU) under the LoTW panel. -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">

                            <!-- Missing CQ Zones (1..40) -->
                            <StackPanel Margin="0,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="TB_MissingCQHeader" Text="Missing CQ Zones" Height="54"
                                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Danger}"/>
                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,2,2">
                                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,0,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Background="{DynamicResource GridHeaderBg}"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="Zone" Margin="4,3" Width="46" TextAlignment="Center"
                                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                            <ScrollViewer x:Name="SV_MissingCQ"
                                                          VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                                <ItemsControl x:Name="IC_MissingCQ">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                                                                    Background="{Binding RowBg}">
                                                                <TextBlock Text="{Binding Zone}" FontSize="13"
                                                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                                           Margin="4,2" Width="46" TextAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <!-- Missing ITU Zones (1..90) -->
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="TB_MissingITUHeader" Text="Missing ITU Zones" Height="54"
                                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Danger}"/>
                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,2,2">
                                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,0,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Background="{DynamicResource GridHeaderBg}"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="Zone" Margin="4,3" Width="46" TextAlignment="Center"
                                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                            <ScrollViewer x:Name="SV_MissingITU"
                                                          VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                                <ItemsControl x:Name="IC_MissingITU">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                                                                    Background="{Binding RowBg}">
                                                                <TextBlock Text="{Binding Zone}" FontSize="13"
                                                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                                           Margin="4,2" Width="46" TextAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource GridHeaderBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0" Padding="10,6">
            <TextBlock x:Name="TB_Status" FontSize="14" Foreground="{DynamicResource TextBrush}" Text="Ready."/>
        </Border>
    </Grid>
</Window>
