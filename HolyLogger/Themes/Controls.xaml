<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HolyLogger">
    <!-- APP-WIDE control theming. Merged once in App.xaml so EVERY window/dialog picks these up
         automatically. All colors reference theme tokens (DynamicResource) that ThemeManager sets
         on Application.Resources, so switching mode re-colors the whole app live. Light-mode token
         values equal the previous defaults, so the current look is unchanged.

         Controls that set their own Background/Foreground inline keep those (accent panels, LED,
         colored status text, etc.). -->

    <!-- ── THE RED KEYCAP: UNDO ────────────────────────────────────────────────────────────────
         The shape of the Add (F1) / Clear (F9) keys on the main form, in red. Undo is not one of the
         logging keys - it takes back something already done - so it has to be seen at a glance and
         never mistaken for them.

         The point of a hand-written template here is the mouse-over. The stock WPF button paints its
         own pale grey over whatever Background it is given the moment the pointer arrives, and on a
         coloured button that reads as "you cannot press this" - which is exactly how it was reported:
         "when the mouse is over it gets gray and gives the felling that it is disabled". This one
         lights UP instead.

         In this file, not in a window, because BOTH Undo buttons wear it - the main window's and the
         Log Workshop's - and a window's own resources cannot be seen from another window. -->
    <Style x:Key="DangerActionButtonStyle" TargetType="Button">
        <!-- The full red, not a tint of it. A pale red says "almost a warning"; this one is meant to
             be seen from across the form. -->
        <Setter Property="Background" Value="#C62828"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="KeyOuter" CornerRadius="5" Background="#8E1B1B" SnapsToDevicePixels="True" Padding="0,0,0,3">
                        <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#C62828" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- BLUE under the mouse - the very same #A8D8FF the F1 and F9 keys light up
                             to. Red sitting still, blue when the pointer is on it: the change is
                             unmissable, and it is the change this form already teaches everywhere
                             else. The text goes black at the same moment, because white on a pale
                             blue face cannot be read. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#1F5C8E"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#A8D8FF"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#3A80C8"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                            <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#7DC0F5"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <!-- The Workshop's Undo is always on show and merely disabled when there is
                             nothing to take back, so grey is needed here after all - it is the one
                             state that really does mean "you cannot press this". -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                            <Setter Property="Foreground" Value="#7A7A7A"/>
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── THE DARK GREEN KEYCAP: GO ───────────────────────────────────────────────────────────
         The same key as the red one above, in dark green, for a button that DOES the thing rather
         than takes it back. The Try Again list's row buttons wear it: one per row, so the colour has
         to say "press me" down a whole column without shouting.

         Dark green (#1B5E20) rather than a bright one: a column of bright green would read as a
         column of status lamps, and these are buttons. White text, because dark green will not carry
         black. Under the mouse it lights to the same #A8D8FF every other key in this program lights
         to - the stock WPF button would instead paint pale grey over the green, which reads as
         "disabled". -->
    <Style x:Key="GoActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1B5E20"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="KeyOuter" CornerRadius="5" Background="#0E3A12" SnapsToDevicePixels="True" Padding="0,0,0,3">
                        <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#2E7D32" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#1F5C8E"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#A8D8FF"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#3A80C8"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                            <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#7DC0F5"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                            <Setter Property="Foreground" Value="#7A7A7A"/>
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── THE ORANGE KEYCAP: TRY AGAIN ────────────────────────────────────────────────────────
         The same key again, in orange. It is NOT the blue ActionButtonStyle that Add (F1) and Clear
         (F9) wear, and that is the whole point: those two are the logging keys, pressed on every
         contact, and this one only appears when there is unfinished business waiting. Orange reads as
         "something is pending" beside them without competing with the red Undo, which means the
         opposite - undoing something already done.

         Under the mouse it lights to the same #A8D8FF as every other key in this program, with the
         text going black; the stock WPF button would paint pale grey over the orange instead, which
         reads as "you cannot press this". -->
    <Style x:Key="OrangeActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#EF6C00"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="KeyOuter" CornerRadius="5" Background="#A34A00" SnapsToDevicePixels="True" Padding="0,0,0,3">
                        <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#FF9130" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#1F5C8E"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#A8D8FF"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#3A80C8"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                            <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#7DC0F5"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                            <Setter Property="Foreground" Value="#7A7A7A"/>
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── THE HOUSE RIGHT-CLICK MENU ──────────────────────────────────────────────────────────
         Rounded card, red for anything that deletes. The log's menu and the Log Workshop's menu each
         parse their own private copy of a white-and-blue version of this at runtime; these keys are
         the TRY AGAIN version, and they are the SAME LIGHT GREEN as the Try Again window itself. Both
         menus that use them are about that list - the cluster's "Copy into Try Again" and the list's
         own Delete - so the colour is the thread that ties the three together: the operator sees green
         and knows which feature he is in.

         Deliberately literal colours, not theme tokens, so the card stays this green in every colour
         scheme. That is also why every text colour here is spelled out: the theme's TextBrush is a
         LIGHT colour in the dark schemes, and light text on light green cannot be read. -->
    <Style x:Key="HolyCtxMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Padding 3 and an 8px corner: the card is small and every edge it does not need
                         is width the operator has to read across. -->
                    <Border Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="2" CornerRadius="8" Padding="3" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="#666666"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="HolyCtxItemTemplate" TargetType="MenuItem">
        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D32F2F"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="HolyCtxItemDanger" TargetType="MenuItem">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#C62828"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource HolyCtxItemTemplate}"/>
    </Style>

    <!-- AN ITEM THAT SENDS SOMETHING SOMEWHERE, with its mark on the RIGHT.
         Reading order is the reason. A mark on the left is a label for what follows - it says what
         KIND of thing the line is. A mark on the right is the destination the words have just named,
         so the eye reaches "Copy into Try Again" and then the arrow, in that order. It also lets the
         mark be an arrow pointing out of the menu, which a left-hand column cannot do.

         The icon deliberately has no colour of its own: it inherits the item's Foreground, so it goes
         white with the text when the row lights up blue. An arrow painted a fixed blue would vanish
         into the blue highlight at exactly the moment the operator is looking at it. -->
    <!-- IT LOOKS LIKE A BUTTON, because it is one and nothing else on this card is. A line of plain
         text in a small floating panel does not announce that it can be pressed - it can be read as a
         heading, or as a note about the station named above it. A face, a border and a raised bottom
         edge say "press me" with no explaining. Bold for the same reason: the words are the command.

         4px between the words and the arrow, not 10. The arrow belongs TO the words - it is where they
         are pointing - and a wide gap made it look like a second, separate thing sitting in a column of
         its own. -->
    <ControlTemplate x:Key="HolyCtxItemGoTemplate" TargetType="MenuItem">
        <Border x:Name="KeyOuter" CornerRadius="5" Background="#2E7D32" SnapsToDevicePixels="True" Padding="0,0,0,2">
            <Border x:Name="bd" CornerRadius="5" Background="#C8E6C9" BorderBrush="#2E7D32"
                    BorderThickness="1" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                <!-- BOTH COLUMNS AUTO AND THE PAIR CENTRED. The header column was "*", which stretches
                     to whatever width the card ends up being - and the card is as wide as its widest
                     line, so the arrow was pushed to the far edge with a hand's breadth of empty green
                     between it and the words it belongs to. The 4px margin was never the problem; the
                     stretching was. Auto columns keep the words and the arrow the width of the words
                     and the arrow, and centring the pair puts that group in the middle of the button
                     however wide the button turns out to be. -->
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Icon" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <!-- Dark green, not the blue the older menus use: this card is green, and it is the same
                 dark green as a selected row in the Try Again window. One highlight colour across the
                 whole feature. -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1B5E20"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <!-- Sinks by 2px like every other key in this program, so the press is felt. -->
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,0"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="HolyCtxItemGo" TargetType="MenuItem">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <!-- 8,4 against the older menus' 12,7. Bold text is wider than plain, so the room for it had
             to come from somewhere if the card was to end up SMALLER than it started. -->
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="1,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource HolyCtxItemGoTemplate}"/>
    </Style>

    <!-- THE SAME KEY IN BLUE, for "Copy to Alert" on a cluster spot. Green is the Try Again colour and
         it belongs to that list; the alerts are a different thing and say so with a different colour.
         The words sit at the LEFT, lined up with the callsign on the title line above them, and the
         mark on the right is the alerts bell rather than an arrow - the same bell that opens the list. -->
    <ControlTemplate x:Key="HolyCtxItemAlertTemplate" TargetType="MenuItem">
        <Border x:Name="KeyOuter" CornerRadius="5" Background="#1565C0" SnapsToDevicePixels="True" Padding="0,0,0,2">
            <Border x:Name="bd" CornerRadius="5" Background="#BBDEFB" BorderBrush="#1565C0"
                    BorderThickness="1" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                <!-- The words at the LEFT and the bell at the RIGHT EDGE, which is where the green
                     button's arrow ends up: that one centres a shorter group inside a card whose width
                     is set by the longest line, so its arrow sits out at the end. Stretching the header
                     column puts this bell in the same place instead of leaving it tucked against the
                     words. -->
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" ContentSource="Header"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Icon"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,0"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="HolyCtxItemAlert" TargetType="MenuItem" BasedOn="{StaticResource HolyCtxItemGo}">
        <Setter Property="Template" Value="{StaticResource HolyCtxItemAlertTemplate}"/>
    </Style>

    <!-- THE TITLE LINE OF A CARD - and the reason this style has to exist at all.
         Anything handed to ContextMenu.Items that is not already a MenuItem gets WRAPPED in a default
         MenuItem, and a default MenuItem reserves room for things this line does not have: a 22px icon
         column, about 20px for the shortcut text on the right, and 10px for a submenu arrow. Measured,
         that was 66px of empty structure around a 90px title - and because the items panel stretches
         every row to the widest one, it set the width of the WHOLE card and of the button below it.
         The card looked padded out at the sides for no visible reason, because the reason was invisible.

         This template is a Border and the header, and nothing else. -->
    <Style x:Key="HolyCtxTitle" TargetType="MenuItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HolyCtxSep" TargetType="Separator">
        <Setter Property="Margin" Value="3,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#BDBDBD" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every window: themed surface + default text color (buttons/colored text override it). -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Custom title bar caption buttons (minimize/maximize/restore/close), used by every window
         that replaces its OS caption with a custom-drawn title bar (MainWindow.xaml, and the Cluster
         window built in code in MainWindow.xaml.cs, so it's app-wide here, not window-local, specifically
         so the code-built Cluster window can look them up via Application.Current.Resources). Flat,
         full-height, flush rectangles like native caption buttons; the rounded Button style above
         would look wrong here. -->
    <!-- The cyan keycap of the CW message buttons. App-wide so the CW Keyer's own buttons can be
         the same thing rather than a copy of it that drifts. -->
    <Style x:Key="MsgButtonCwStyle" TargetType="Button">
        <Setter Property="Background" Value="#7FFEFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Outer border: darker bottom edge like a physical key -->
                    <Border x:Name="KeyOuter" CornerRadius="5" Background="#0099CC" SnapsToDevicePixels="True" Padding="0,0,0,3">
                        <!-- Inner face -->
                        <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#00CCFF" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#005C80"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#33C2D6"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#0077AA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                            <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#1FA6BC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                            <Setter Property="Foreground" Value="#7A7A7A"/>
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EVERY TOOLTIP IN THE PROGRAM, at the size everything else is written in. WPF gives a
         tooltip the system's own font - about eleven, and grey - which is the one piece of text a
         man reads BECAUSE he could not work something out, so it is the worst place to be small.
         No x:Key: an unkeyed style on a type is the default for that type everywhere.
         Black rather than a theme brush: the panel behind a tooltip is the system's own pale
         colour in every scheme, and a light theme foreground would vanish into it. -->
    <local:ToolTipEightWordsConverter x:Key="ToolTipEightWords"/>

    <Style TargetType="ToolTip">
        <Setter Property="FontSize" Value="16"/>
        <!-- ONE COLOUR FOR EVERY TOOLTIP, from the palette (View > Color Scheme > Customize Colors):
             pale yellow behind black text, the same in every scheme. It used to take the system's own
             panel colour, which is why the foreground had to be nailed to black by hand. -->
        <Setter Property="Background" Value="{DynamicResource TooltipBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TooltipText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MaxWidth" Value="460"/>
        <!-- AND IT WRAPS. MaxWidth alone only CUT a long tooltip off at 460; the sentence still ran as
             one line and its end was lost. Text tooltips are drawn through a wrapping TextBlock now,
             so a long one folds onto two or three readable lines. A tooltip built out of elements
             rather than text keeps its own layout - see ToolTipTextTemplateSelector. -->
        <Setter Property="ContentTemplateSelector">
            <Setter.Value>
                <local:ToolTipTextTemplateSelector>
                    <local:ToolTipTextTemplateSelector.TextTemplate>
                        <DataTemplate>
                            <!-- Eight words to a line, whatever the width (see ToolTipEightWordsConverter).
                                 TextWrapping stays on underneath it as a floor: a line of eight very long
                                 words still cannot run off the edge. -->
                            <TextBlock Text="{Binding Converter={StaticResource ToolTipEightWords}}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </local:ToolTipTextTemplateSelector.TextTemplate>
                </local:ToolTipTextTemplateSelector>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <!-- WPF's default text-box border is so faint that a row of empty boxes reads as blank space.
             InputBorder is a deliberately stronger frame; see ThemePalette. -->
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- DataGrid header + cells (any grid, any window). -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Default push buttons (dialogs, message boxes, etc.). Buttons that carry their own x:Key
         style or template (Msg keys, action buttons) are unaffected. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus: top-level text + a fully themed item template (the default WPF template forces its
         own highlight chrome and made hovered items invisible in dark mode). -->
    <Style TargetType="Menu">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" x:Name="IconCol" Width="22" Margin="2,0,2,0">
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="Check" Text="&#x2713;" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" Margin="6,4,8,4" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="8,0,12,0" VerticalAlignment="Center" Opacity="0.65"/>
                            <Path x:Name="Arrow" Grid.Column="3" Margin="2,0,8,0" VerticalAlignment="Center" Data="M0,0 L0,7 L4,3.5 Z" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom">
                                <!-- Elevated flyout surface: lighter-than-base background + border + drop shadow
                                     so the popup clearly floats above the log table. Outer Margin leaves room
                                     for the shadow (the popup allows transparency). -->
                                <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1"
                                        Padding="2" Margin="0,0,8,8" CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.55"/>
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="IconCol" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="IconCol" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox dropdown items: themed text + selection highlight, so the list is legible on the
         dark popup surface (the default item text is black -> black-on-black in dark mode). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Exactly ONE blue row, tracking the mouse/keyboard (IsHighlighted). The
                             currently-selected value is marked in bold only — filling it blue too made
                             TWO rows light up whenever the dropdown opened. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu separators: a visible 1px themed line on the elevated menu surface (the default line
         is nearly invisible on a dark flyout). Keyed to MenuItem.SeparatorStyleKey so it applies to
         every <Separator/> inside a menu automatically. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource GridLine}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sliding on/off switch, the shape people expect for a true/false setting: a rounded track with a
         knob that moves to the right and turns green when on. Reusable via
         Style="{StaticResource ToggleSwitchStyle}" on any ToggleButton.
         Green = ResetButtonBg (the palette's green), grey track = ButtonHoverBg, so it follows the
         colour scheme instead of hardcoding colours. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="52" Height="24" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" CornerRadius="12"
                                Background="{DynamicResource ButtonHoverBg}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"/>
                        <!-- OFF/ON caption inside the track, on the opposite side to the knob. FONT 10 ON
                             PURPOSE: the track is 52 wide and the knob takes 18 of it, so the word has
                             about 24px. At 16 "OFF" is 29 wide and ran over the knob and out of the
                             pill - which is what the no-font-below-16 sweep did here. -->
                        <TextBlock x:Name="Caption" Text="OFF" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                HorizontalAlignment="Left" Margin="3,0,0,0"
                                Background="{DynamicResource WindowBg}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover first, so the checked trigger below can override the border: a green
                             track with a blue hover border looked wrong. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- The same green as the map's Auto Zoom switch (#2ecc71 / #1a9e55 border),
                                 so every on/off switch in the program reads identically. Literal because
                                 the map's copy is CSS inside the WebBrowser and cannot share a token. -->
                            <Setter TargetName="Track" Property="Background" Value="#2ECC71"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#1A9E55"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="Caption" Property="Text" Value="ON"/>
                            <Setter TargetName="Caption" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="Caption" Property="Margin" Value="8,0,0,0"/>
                            <!-- Dark, not TextBrush: the green track is a fixed light colour, so the
                                 light TextBrush of the dark schemes would be unreadable on it. -->
                            <Setter TargetName="Caption" Property="Foreground" Value="#0B3D22"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
