<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- APP-WIDE control theming. Merged once in App.xaml so EVERY window/dialog picks these up
         automatically. All colors reference theme tokens (DynamicResource) that ThemeManager sets
         on Application.Resources, so switching mode re-colors the whole app live. Light-mode token
         values equal the previous defaults, so the current look is unchanged.

         Controls that set their own Background/Foreground inline keep those (accent panels, LED,
         colored status text, etc.). -->

    <!-- ── THE RED KEYCAP: UNDO ────────────────────────────────────────────────────────────────
         The shape of the Add (F1) / Clear (F9) keys on the main form, in red. Undo is not one of the
         logging keys - it takes back something already done - so it has to be seen at a glance and
         never mistaken for them.

         The point of a hand-written template here is the mouse-over. The stock WPF button paints its
         own pale grey over whatever Background it is given the moment the pointer arrives, and on a
         coloured button that reads as "you cannot press this" - which is exactly how it was reported:
         "when the mouse is over it gets gray and gives the felling that it is disabled". This one
         lights UP instead.

         In this file, not in a window, because BOTH Undo buttons wear it - the main window's and the
         Log Workshop's - and a window's own resources cannot be seen from another window. -->
    <Style x:Key="DangerActionButtonStyle" TargetType="Button">
        <!-- The full red, not a tint of it. A pale red says "almost a warning"; this one is meant to
             be seen from across the form. -->
        <Setter Property="Background" Value="#C62828"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="KeyOuter" CornerRadius="5" Background="#8E1B1B" SnapsToDevicePixels="True" Padding="0,0,0,3">
                        <Border x:Name="KeyFace" CornerRadius="5" BorderThickness="1" BorderBrush="#C62828" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,4,2"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- BLUE under the mouse - the very same #A8D8FF the F1 and F9 keys light up
                             to. Red sitting still, blue when the pointer is on it: the change is
                             unmissable, and it is the change this form already teaches everywhere
                             else. The text goes black at the same moment, because white on a pale
                             blue face cannot be read. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#1F5C8E"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#A8D8FF"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#3A80C8"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="KeyFace" Property="Margin" Value="0,2,0,0"/>
                            <Setter TargetName="KeyOuter" Property="Padding" Value="0,2,0,1"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#7DC0F5"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <!-- The Workshop's Undo is always on show and merely disabled when there is
                             nothing to take back, so grey is needed here after all - it is the one
                             state that really does mean "you cannot press this". -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="KeyOuter" Property="Background" Value="#888888"/>
                            <Setter TargetName="KeyFace" Property="Background" Value="#E4E4E4"/>
                            <Setter TargetName="KeyFace" Property="BorderBrush" Value="#B5B5B5"/>
                            <Setter Property="Foreground" Value="#7A7A7A"/>
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every window: themed surface + default text color (buttons/colored text override it). -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Custom title bar caption buttons (minimize/maximize/restore/close), used by every window
         that replaces its OS caption with a custom-drawn title bar (MainWindow.xaml, and the Cluster
         window built in code in MainWindow.xaml.cs, so it's app-wide here, not window-local, specifically
         so the code-built Cluster window can look them up via Application.Current.Resources). Flat,
         full-height, flush rectangles like native caption buttons; the rounded Button style above
         would look wrong here. -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <!-- WPF's default text-box border is so faint that a row of empty boxes reads as blank space.
             InputBorder is a deliberately stronger frame; see ThemePalette. -->
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- DataGrid header + cells (any grid, any window). -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Default push buttons (dialogs, message boxes, etc.). Buttons that carry their own x:Key
         style or template (Msg keys, action buttons) are unaffected. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus: top-level text + a fully themed item template (the default WPF template forces its
         own highlight chrome and made hovered items invisible in dark mode). -->
    <Style TargetType="Menu">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" x:Name="IconCol" Width="22" Margin="2,0,2,0">
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="Check" Text="&#x2713;" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" Margin="6,4,8,4" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="8,0,12,0" VerticalAlignment="Center" Opacity="0.65"/>
                            <Path x:Name="Arrow" Grid.Column="3" Margin="2,0,8,0" VerticalAlignment="Center" Data="M0,0 L0,7 L4,3.5 Z" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom">
                                <!-- Elevated flyout surface: lighter-than-base background + border + drop shadow
                                     so the popup clearly floats above the log table. Outer Margin leaves room
                                     for the shadow (the popup allows transparency). -->
                                <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1"
                                        Padding="2" Margin="0,0,8,8" CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.55"/>
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="IconCol" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="IconCol" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox dropdown items: themed text + selection highlight, so the list is legible on the
         dark popup surface (the default item text is black -> black-on-black in dark mode). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Exactly ONE blue row, tracking the mouse/keyboard (IsHighlighted). The
                             currently-selected value is marked in bold only — filling it blue too made
                             TWO rows light up whenever the dropdown opened. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu separators: a visible 1px themed line on the elevated menu surface (the default line
         is nearly invisible on a dark flyout). Keyed to MenuItem.SeparatorStyleKey so it applies to
         every <Separator/> inside a menu automatically. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource GridLine}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sliding on/off switch, the shape people expect for a true/false setting: a rounded track with a
         knob that moves to the right and turns green when on. Reusable via
         Style="{StaticResource ToggleSwitchStyle}" on any ToggleButton.
         Green = ResetButtonBg (the palette's green), grey track = ButtonHoverBg, so it follows the
         colour scheme instead of hardcoding colours. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="52" Height="24" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" CornerRadius="12"
                                Background="{DynamicResource ButtonHoverBg}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"/>
                        <!-- OFF/ON caption inside the track, on the opposite side to the knob. FONT 10 ON
                             PURPOSE: the track is 52 wide and the knob takes 18 of it, so the word has
                             about 24px. At 16 "OFF" is 29 wide and ran over the knob and out of the
                             pill - which is what the no-font-below-16 sweep did here. -->
                        <TextBlock x:Name="Caption" Text="OFF" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                HorizontalAlignment="Left" Margin="3,0,0,0"
                                Background="{DynamicResource WindowBg}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover first, so the checked trigger below can override the border: a green
                             track with a blue hover border looked wrong. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- The same green as the map's Auto Zoom switch (#2ecc71 / #1a9e55 border),
                                 so every on/off switch in the program reads identically. Literal because
                                 the map's copy is CSS inside the WebBrowser and cannot share a token. -->
                            <Setter TargetName="Track" Property="Background" Value="#2ECC71"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#1A9E55"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="Caption" Property="Text" Value="ON"/>
                            <Setter TargetName="Caption" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="Caption" Property="Margin" Value="8,0,0,0"/>
                            <!-- Dark, not TextBrush: the green track is a fixed light colour, so the
                                 light TextBrush of the dark schemes would be unreadable on it. -->
                            <Setter TargetName="Caption" Property="Foreground" Value="#0B3D22"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
