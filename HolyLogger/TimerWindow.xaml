<Window x:Name="TimerWindow1" x:Class="HolyLogger.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown Timer" Height="330" Width="280" Icon="Images/timer.png" LocationChanged="TimerWindow1_LocationChanged" SizeChanged="TimerWindow1_SizeChanged">
    <Grid x:Name="LayoutGrid">
        <!-- Define Columns -->
        <Grid.RowDefinitions>
            <!-- Auto, not a fixed 30: the button row must be as tall as the buttons in it, or a taller
                 font (or a Windows text-size setting other than 100%) clips them from below. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <!-- MinWidth + Padding, not a fixed Width: at 16pt "Reset" and "Stop" were cut off at the
                 sides. The buttons keep their look at 82 and grow if the words need it. -->
            <Button x:Name="ResetBtn" Content="Reset" HorizontalAlignment="Left" Margin="5,2,0,0" VerticalAlignment="Top" MinWidth="82" Padding="10,1" Grid.Row="1" Click="ResetBtn_Click" FontSize="16" ToolTip="Reset the timer"/>
            <Button x:Name="StartStopBtn" Content="Start" HorizontalAlignment="right" Margin="5,2,5,0" VerticalAlignment="Top" MinWidth="82" Padding="10,1" Grid.Row="1" Click="StartStopBtn_Click" FontSize="16" ToolTip="Start / Stop the timer"/>

        </DockPanel>
        <Viewbox Grid.Row="1">
            <DockPanel x:Name="timerPanel" LastChildFill="False">
                <Label x:Name="timerlbl" Content="00:00:00" FontFamily="Arial Black" FontWeight="Bold" />
            </DockPanel>
        </Viewbox>
    </Grid>
</Window>
