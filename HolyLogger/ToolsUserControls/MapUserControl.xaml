<UserControl x:Class="HolyLogger.ToolsUserControls.MapUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="220">
    <!-- Blue frame around the map matching the entry-form/log-table frame (#1565C0, thickness 3). The
         map is a WebBrowser (an airspace HWND) so a border cannot be drawn OVER it; instead the browser
         sits inside this Border, inset by its thickness, so the frame shows around it. Fixed blue so it
         appears in both light and dark mode. -->
    <!-- Named so the map window can take the frame away while the map floats: the window then draws
         its own, thicker one, which is also what the operator grabs to resize it. -->
    <Border x:Name="MapFrame" BorderBrush="#1565C0" BorderThickness="3,3,3,0">
    <Grid>
        <WebBrowser x:Name="MapBrowser" />
        <Border x:Name="PlaceholderPanel" Background="#DCEBF8">
            <Grid Margin="10">
                <!-- The red arrow once reached out of the map to the My Locator box beside it. The map
                     has its own window now and nothing can be drawn outside a window, so the arrow is
                     kept but never shown, and the text below names the box instead. -->
                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                        IsHitTestVisible="False" ClipToBounds="False" Panel.ZIndex="2" Margin="-10">
                    <Polygon Points="-325,30  -307,19  -307,28  85,28  85,32  -307,32  -307,41"
                             Fill="#D7263D" Stroke="#8F1422" StrokeThickness="1.5"/>
                </Canvas>

                <Border Width="250"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0"
                        Padding="18,16,18,16"
                        CornerRadius="10"
                        Background="#FFF7E8"
                        BorderBrush="#D7263D"
                        BorderThickness="3"
                        Effect="{x:Null}">
                    <StackPanel>
                        <TextBlock Text="MAP DISABLED"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#A31621"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PlaceholderText"
                                   Margin="0,10,0,0"
                                   Text="Please set My Locator"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#1E2A36"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="Enter your locator in the My Locator box to enable the map."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4B5B68"/>
                    </StackPanel>
                </Border>

                <!-- The pin, on this notice too. The map draws its own pin in its corner, but the map
                     is hidden while this notice is up, and a pinned window has no title bar - without
                     this one there would be no way to unpin it. -->
                <Button x:Name="PlaceholderPinBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-10,-10,0" Width="32" Height="28" Padding="0" Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#1E2A36"
                        Background="#9FCBF5" BorderBrush="#4B76A0" BorderThickness="1"
                        Content="&#xE718;" Click="PlaceholderPinBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
