<Window x:Class="HolyLogger.UdpPortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HolyLogger"
        Title="UDP Ports Manager" Height="700" MinHeight="560" Width="740" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The short version stays on screen; the full list of what can be sent and received, and what
             HolyLogger does with each, is behind the ? button - a wall of text above two small tables
             read as the window's subject rather than a note about it. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- The break is deliberate: the second sentence is about the Name column, not about what
                 to do, so it starts its own line however wide the window is. -->
            <TextBlock Grid.Column="0" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"><Run Text="Give each program a line with the port it uses, and tick the line to switch it on."/><LineBreak/><Run Text="The name is only a label - you can write anything."/></TextBlock>
            <Button Grid.Column="1" x:Name="BtnWhat" Content="?" Width="34" Height="34" Margin="12,0,0,0"
                    FontSize="16" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Top"
                    ToolTip="What can be sent and received?" Click="BtnWhat_Click"/>
        </Grid>

        <TextBlock Grid.Row="1" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextBrush}"
                   Text="Receive — what other programs send to HolyLogger"/>

        <DataGrid x:Name="PortsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="True" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="All" FontSize="16"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  PreviewKeyDown="PortsGrid_PreviewKeyDown"
                  LostKeyboardFocus="Grid_LostKeyboardFocus">
            <DataGrid.Columns>
                <!-- A template column rather than DataGridCheckBoxColumn: the built-in one needs the cell
                     to be selected first, so the box takes TWO clicks to tick. This one reacts to the
                     first click, and PropertyChanged pushes it to the row at once. -->
                <DataGridTemplateColumn Header="On" Width="52" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- UpdateSourceTrigger=PropertyChanged: the row is updated on every KEYSTROKE, so the
                     next blank row opens as soon as you start typing (same as My Favorite Channels). -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="MaxLength" Value="5"/>
                            <EventSetter Event="PreviewTextInput" Handler="PortBox_PreviewTextInput"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" FontSize="16" FontWeight="Bold" Margin="0,14,0,4"
                   Foreground="{DynamicResource TextBrush}"
                   Text="Broadcast — what HolyLogger sends out"/>

        <!-- Two columns a receiving line does not need. WHERE, because a packet we send has to be
             addressed (127.0.0.1 is a program on this same PC); and WHAT, because nothing arrives to be
             examined - the format has to be chosen. -->
        <DataGrid x:Name="SendGrid" Grid.Row="4" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="True" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="All" FontSize="16"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  PreviewKeyDown="SendGrid_PreviewKeyDown"
                  LostKeyboardFocus="Grid_LostKeyboardFocus">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="On" Width="52" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="MaxLength" Value="5"/>
                            <EventSetter Event="PreviewTextInput" Handler="PortBox_PreviewTextInput"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <!-- A template column holding a REAL drop-down, not DataGridComboBoxColumn: that one
                     shows plain text until the cell is put into edit mode, so the operator sees a word
                     and no sign that there is a list behind it. This one is a drop-down on sight and
                     opens on the first click. The choices come from UdpBroadcastEntry.Formats, so what
                     can be picked and what the sender can write are one and the same. -->
                <DataGridTemplateColumn x:Name="FormatColumn" Header="Format" Width="170" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox FontSize="16" Margin="2" BorderThickness="1"
                                      ItemsSource="{x:Static local:UdpBroadcastEntry.Formats}"
                                      SelectedItem="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"><Run Text="Address: 127.0.0.1 is a program on this same computer. For a program on another computer, put that computer's address."/><LineBreak/><Run Text="To remove a line, click it and press the Delete key."/></TextBlock>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="BtnSave" Content="Save" Padding="24,5" Margin="0,0,10,0" FontSize="16" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Padding="20,5" FontSize="16" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
