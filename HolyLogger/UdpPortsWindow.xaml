<Window x:Class="HolyLogger.UdpPortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDP Ports" Height="460" MinHeight="360" Width="560" MinWidth="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Other programs can send their contacts to HolyLogger over UDP. Give each program a line here with the port it sends on, and tick the line to listen on it. The name is only a label - you can write anything."/>

        <DataGrid x:Name="PortsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="True" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="All" FontSize="16"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  PreviewKeyDown="PortsGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <!-- A template column rather than DataGridCheckBoxColumn: the built-in one needs the cell
                     to be selected first, so the box takes TWO clicks to tick. This one reacts to the
                     first click, and PropertyChanged pushes it to the row at once. -->
                <DataGridTemplateColumn Header="On" Width="52" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- UpdateSourceTrigger=PropertyChanged: the row is updated on every KEYSTROKE, so the
                     next blank row opens as soon as you start typing (same as My Favorite Channels). -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="MaxLength" Value="5"/>
                            <EventSetter Event="PreviewTextInput" Handler="PortBox_PreviewTextInput"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="To remove a line, click it and press the Delete key."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="BtnSave" Content="Save" Padding="24,5" Margin="0,0,10,0" FontSize="16" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Padding="20,5" FontSize="16" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
