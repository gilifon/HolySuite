<Window x:Class="HolyLogger.UserManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Manual" Width="900" Height="640" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <!-- Help > User Manual. The subjects on the left are the headings of Help/UserManual.md, read when
         the window opens; clicking one brings its heading to the top of the text on the right. -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="160"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="LB_Subjects" Grid.Column="0" FontSize="16"
                 Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="#1565C0" BorderThickness="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="Subjects_SelectionChanged"/>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Column="2" BorderBrush="#1565C0" BorderThickness="2" Background="{DynamicResource GridRowBg}">
            <FlowDocumentScrollViewer x:Name="FD_Viewer" IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Foreground="{DynamicResource TextBrush}"/>
        </Border>
    </Grid>
</Window>
