<Window x:Class="HolyLogger.UserManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Manual" Width="1100" Height="720" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" ResizeMode="CanResize"
        Icon="Images/crown.png"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}">
    <!-- Help > User Manual. The subjects on the left are the headings of Help/UserManual.md, read when
         the window opens; clicking one brings its heading to the top of the text on the right.
         The text is laid out like a page in Word (user, 2026-11-12): a white sheet with margins on a
         grey desk, so the pictures sit inside the text the way they do in a document. -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="160"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="LB_Subjects" Grid.Column="0" FontSize="16"
                 Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="#1565C0" BorderThickness="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="Subjects_SelectionChanged"/>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- The desk, the sheet on it, and the text on the sheet. The sheet is as wide as a Word page
             (816 = 8.5 inches) when there is room, narrower when the window is. -->
        <ScrollViewer x:Name="SV_Desk" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Background="#E6E6E6" Focusable="False">
            <Border x:Name="Paper" MaxWidth="816" Margin="20,20,20,20" Background="White"
                    BorderBrush="#D0D0D0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <RichTextBox x:Name="RTB_Text" IsReadOnly="True" IsDocumentEnabled="True"
                             BorderThickness="0" Background="White" Foreground="Black"
                             Padding="56,48,56,48" VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"/>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
