<Window x:Class="HolyLogger.ViewLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logs" SizeToContent="Width" Height="440" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="Btn_NewRegularLog" Content="Create New Regular Log" Height="34" Padding="9,0" FontSize="14" FontWeight="Bold"
                    Margin="0,0,10,0" Click="Btn_NewRegularLog_Click"
                    Background="#00E676" Foreground="#1A1A1A" BorderBrush="#1565C0" BorderThickness="1.5"/>
            <Button x:Name="Btn_NewContestLog" Content="Create New Contest Log" Height="34" Padding="9,0" FontSize="14" FontWeight="Bold"
                    Margin="0,0,16,0" Click="Btn_NewContestLog_Click"
                    Background="#FFC107" Foreground="#1A1A1A" BorderBrush="#1565C0" BorderThickness="1.5"/>
            <Separator Width="1" Margin="0,4,10,4"/>
            <Button x:Name="Btn_Open" Content="Open Log" Height="32" Padding="9,0" FontSize="14" FontWeight="Bold"
                    Margin="0,0,8,0" IsEnabled="False" Click="Btn_Open_Click"/>
            <Button x:Name="Btn_Rename" Content="Rename" Height="32" Padding="9,0" FontSize="14"
                    Margin="0,0,8,0" Click="Btn_Rename_Click"/>
            <Button x:Name="Btn_SetIdentity" Content="Set Identity" Height="32" Padding="9,0" FontSize="14"
                    Margin="0,0,8,0" Click="Btn_SetIdentity_Click"
                    ToolTip="Give this log its permanent station callsign + operator identity"/>
            <Button x:Name="Btn_CopySettings" Content="Copy settings…" Height="32" Padding="9,0" FontSize="14"
                    Margin="0,0,8,0" Click="Btn_CopySettings_Click"
                    ToolTip="Set, change or stop copying this log's new QSOs into another log"/>
            <Button x:Name="Btn_Delete" Content="Delete" Height="32" Padding="9,0" FontSize="14"
                    Margin="0,0,8,0" Click="Btn_Delete_Click"/>
            <Separator Width="1" Margin="6,4"/>
            <Button x:Name="Btn_Adif" Content="Export ADIF" Height="32" Padding="9,0" FontSize="14"
                    Margin="0,0,8,0" Click="Btn_Adif_Click"/>
            <Button x:Name="Btn_Cabrillo" Content="Export Cabrillo" Height="32" Padding="9,0" FontSize="14"
                    Click="Btn_Cabrillo_Click"/>
        </StackPanel>

        <DataGrid x:Name="LogsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="All" FontSize="14" RowHeaderWidth="0"
                  BorderBrush="#1565C0" BorderThickness="1"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  AlternationCount="2"
                  HorizontalGridLinesBrush="{DynamicResource GridLine}" VerticalGridLinesBrush="{DynamicResource GridLine}"
                  SelectionChanged="LogsGrid_SelectionChanged"
                  MouseDoubleClick="LogsGrid_MouseDoubleClick">
            <DataGrid.Resources>
                <!-- Keep the selected row blue even when the grid does not have keyboard focus. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Num}" Width="Auto"/>
                <!-- Auto-width: each column sizes to its own content/header, so two logs never look
                     alike just because a fixed column width silently clipped their names. The window
                     itself is SizeToContent="Width" and code-behind caps MaxWidth to the screen's
                     work area, so a long name grows the window rather than clipping, but the window
                     can never exceed the screen; the tooltip is a fallback for the rare case a
                     horizontal scrollbar appears anyway. -->
                <DataGridTextColumn Header="Log Name" Binding="{Binding Name}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <!-- No trimming: auto-size to the full name (tooltip is a fallback if the window is capped). -->
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding EventType}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="Auto"/>
                <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}" Width="Auto"/>
                <DataGridTextColumn Header="No. of QSOs" Binding="{Binding QsoCount}" Width="Auto"/>
                <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="Auto"/>
                <DataGridTextColumn Header="Copy New Qso to…" Binding="{Binding CopiesTo}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <!-- No trimming: the column auto-sizes to the full target-log name so long names
                             are always shown in full (the tooltip is a fallback if the window is capped). -->
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding CopiesTo}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="Hint" Grid.Row="2" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                   Text="Select a log, then Open / Rename / Delete / Export. Double-click a row to open it."/>
    </Grid>
</Window>
