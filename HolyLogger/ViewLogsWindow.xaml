<Window x:Class="HolyLogger.ViewLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logs" SizeToContent="Width" Height="440" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <!-- The station-callsign drop-down, framed in red so BOTH halves of it are unmistakable: the
             closed box in the cell, which would otherwise read as one more line of text in a grid full
             of them, and the list that drops open, which Windows draws with a hairline grey border that
             disappears against the rows behind it. Everything else here is the stock ComboBox parts -
             only the two frames and their colour are ours. -->
        <SolidColorBrush x:Key="CallsignFrame" Color="#C62828"/>

        <Style x:Key="CallsignComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <!-- CLOSED, IT IS NOT A BOX AT ALL. The cell must read exactly like the
                                     cells that hold a single callsign - no frame, no fill, the same text
                                     in the same place - with only the chevron to say there is more here.
                                     The red frame belongs to the list, and appears when the list does. -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" SnapsToDevicePixels="True">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,4,0" Fill="{StaticResource CallsignFrame}"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False" VerticalAlignment="Center"
                                              Margin="0,2,18,2"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border BorderBrush="{StaticResource CallsignFrame}" BorderThickness="2"
                                        CornerRadius="2" Background="{DynamicResource WindowBg}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="240">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar (two rows). HorizontalAlignment=Left so the toolbar is only as wide as row 1's
             buttons (not the much wider grid below) — that lets row 2's right-aligned export pair line
             up with the end of "Activate & Open Log" rather than the window's right edge. -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10">
            <!-- Row 1: create / import / per-log actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="Btn_NewRegularLog" Content="Create New Regular Log" Height="34" Padding="9,0" FontSize="16" FontWeight="Bold"
                        Margin="0,0,8,0" Click="Btn_NewRegularLog_Click"
                        Background="#00E676" Foreground="#1A1A1A" BorderBrush="#1565C0" BorderThickness="1.5"/>
                <Button x:Name="Btn_NewContestLog" Content="Create New Contest Log" Height="34" Padding="9,0" FontSize="16" FontWeight="Bold"
                        Margin="0,0,8,0" Click="Btn_NewContestLog_Click"
                        Background="#FFC107" Foreground="#1A1A1A" BorderBrush="#1565C0" BorderThickness="1.5"/>
                <Button x:Name="Btn_Import" Content="Import ADIF" Height="34" Padding="9,0" FontSize="16" FontWeight="Bold"
                        Margin="0,0,8,0" Click="Btn_Import_Click"
                        Background="#90CAF9" Foreground="#1A1A1A" BorderBrush="#1565C0" BorderThickness="1.5"
                        ToolTip="Import an ADIF file into a new log or the current log"/>
                <!-- Bigger left gap separates the "generate a new log" group (Regular / Contest / Import)
                     from the per-log actions. Widening row 1 also pushes the right-aligned export pair
                     below, so Export Cabrillo stays lined up with "Activate & Open Log". -->
                <Button x:Name="Btn_Callsigns" Content="Callsigns" Height="34" Padding="9,0" FontSize="16"
                        Margin="28,0,8,0" Click="Btn_Callsigns_Click"
                        ToolTip="The station callsigns this log holds QSOs under: which one it is for now, and add another"/>
                <Button x:Name="Btn_Open" Content="Activate &amp; Open Log" Height="34" Padding="9,0" FontSize="16" FontWeight="Bold"
                        IsEnabled="False" Click="Btn_Open_Click"/>
            </StackPanel>
            <!-- Row 2: rename / delete / copy settings on the left; the export pair right-aligned so
                 Export Cabrillo lines up with the right edge of "Activate & Open Log" above. -->
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="Btn_Adif" Content="Export ADIF" Height="32" Padding="9,0" FontSize="16"
                            Margin="0,0,8,0" Click="Btn_Adif_Click"/>
                    <Button x:Name="Btn_Cabrillo" Content="Export Cabrillo" Height="32" Padding="9,0" FontSize="16"
                            Click="Btn_Cabrillo_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="Btn_Rename" Content="Rename" Height="32" Padding="9,0" FontSize="16"
                            Margin="0,0,8,0" Click="Btn_Rename_Click"/>
                    <!-- Red, because it is the one button on this row that destroys a log. Same red as
                         the Duplicates window's delete, so "this one removes things" looks the same
                         wherever it appears. -->
                    <Button x:Name="Btn_Delete" Content="Delete" Height="32" Padding="9,0" FontSize="16"
                            Margin="0,0,8,0" Click="Btn_Delete_Click"
                            Background="#C62828" Foreground="White" FontWeight="Bold"
                            BorderBrush="#8E1B1B" BorderThickness="1.5"/>
                    <Button x:Name="Btn_CopySettings" Content="Copy QSO to..." Height="32" Padding="9,0" FontSize="16"
                            Margin="0,0,8,0" Click="Btn_CopySettings_Click"
                            ToolTip="Set, change or stop copying this log's new QSOs into another log"/>
                    <Button x:Name="Btn_Search" Content="Search In Log" Height="32" Padding="9,0" FontSize="16"
                            Margin="0,0,8,0" Click="Btn_Search_Click"
                            ToolTip="Search this log without activating it — the log you are working in stays open"/>
                    <Button x:Name="Btn_Verify" Content="Log Fixer" Height="34" Padding="9,0" FontSize="16"
                            Click="Btn_Verify_Click"
                            ToolTip="Check every QSO in this log for a wrong country, a fake callsign and other errors, and offer corrections"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <DataGrid x:Name="LogsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="All" FontSize="16" RowHeaderWidth="0"
                  BorderBrush="#1565C0" BorderThickness="1"
                  Background="{DynamicResource GridRowBg}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                  AlternationCount="2"
                  HorizontalGridLinesBrush="{DynamicResource GridLine}" VerticalGridLinesBrush="{DynamicResource GridLine}"
                  SelectionChanged="LogsGrid_SelectionChanged"
                  MouseDoubleClick="LogsGrid_MouseDoubleClick">
            <DataGrid.Resources>
                <!-- Keep the selected row blue even when the grid does not have keyboard focus. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Num}" Width="Auto"/>
                <!-- Auto-width: each column sizes to its own content/header, so two logs never look
                     alike just because a fixed column width silently clipped their names. The window
                     itself is SizeToContent="Width" and code-behind caps MaxWidth to the screen's
                     work area, so a long name grows the window rather than clipping, but the window
                     can never exceed the screen; the tooltip is a fallback for the rare case a
                     horizontal scrollbar appears anyway. -->
                <DataGridTemplateColumn Header="Log Name" Width="Auto" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <!-- Bold, slightly larger "(Active)" shown only for the active log. -->
                                <TextBlock Text="  (Active)" VerticalAlignment="Center" FontWeight="Bold" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding EventType}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="Auto"/>
                <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}" Width="Auto"/>
                <DataGridTextColumn Header="No. of QSOs" Binding="{Binding QsoCount}" Width="Auto"/>
                <!-- One callsign: plain text. More than one: a drop-down, closed on the log's current
                     callsign and opening to the whole list, so a log carried through several callsigns
                     never widens the column. The tooltip spells them all out either way. -->
                <DataGridTemplateColumn Header="Station Callsigns" Width="Auto" SortMemberPath="Identity">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding IdentityTip}">
                                <TextBlock Text="{Binding Identity}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasManyCallsigns}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- The red frame is what says "there are more callsigns in here": without
                                     it a closed drop-down sitting in a grid reads as just another line of
                                     text, indistinguishable from the single callsign in the row below.
                                     The box itself is left the row's own colour - the frame marks the
                                     control, and tinting the line would only say something that isn't
                                     true about the log. -->
                                <ComboBox ItemsSource="{Binding Callsigns}" SelectedIndex="0" FontSize="16"
                                          Style="{StaticResource CallsignComboStyle}"
                                          HorizontalAlignment="Left" Margin="0,1,0,1"
                                          PreviewMouseLeftButtonDown="CallsignCombo_PreviewMouseLeftButtonDown">
                                    <ComboBox.Visibility>
                                        <Binding Path="HasManyCallsigns">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </ComboBox.Visibility>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Copy New Qso to…" Binding="{Binding CopiesTo}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <!-- No trimming: the column auto-sizes to the full target-log name so long names
                             are always shown in full (the tooltip is a fallback if the window is capped). -->
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding CopiesTo}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="Hint" Grid.Row="2" Margin="0,8,0,0" FontSize="16" Foreground="Black" TextWrapping="Wrap">
            <Run Text="Select a log, then Open / Rename / Delete / Export.  " />
            <Run Text="Double-click" FontWeight="Bold" />
            <Run Text=" to Activate and Open it." />
        </TextBlock>
    </Grid>
</Window>
